#ifndef __V5F_TUNE_H
#define __V5F_TUNE_H

/* =====================================================================
 * V5F 工况可调参数集中表
 * =====================================================================
 * 本文件**只放"随工况/机型/环境显著变化、需要按实机重新选型"的参数**。
 *
 * 不在这里的（它们跟随器件、不随工况调，见 v5f_proc.h）：
 *   · 陀螺逐轴标度 / 对称交叉耦合 / g 敏感度      —— 逐器件标定结果
 *   · 加速度计逐轴标度 / 离线零偏初值              —— 逐器件标定结果
 *   · 陀螺离线零偏初值 GB_BIAS0_LSB_*             —— 逐器件标定结果
 *     ★ 注意：零偏的**真值以在线追踪值为准**，上面那个常量只是帮上电收敛的
 *       通用值，实测偏差可达 100 deg/h 量级，那是设计预期。
 *   · 单位换算常量（1e-8 tick->s、pi/180 等）
 *
 * ★ 写这一条的原则：**凡是"另一个量的两种写法"一律写成派生式**，不留两个独立数字。
 *   曾经踩过：tau_p 从 14 改成 13 但 ALPHA_WORK 没跟着改，有效时间常数根本没变。
 *
 * 调参优先级（按对飞行的影响从大到小）：
 *   1) B 组 GB_TAU_TICKS      —— 决定"上电要等多久零偏才收敛"，最影响手感
 *   2) A 组 V5F_DET_*         —— 决定 is_static 产率，进而决定 1) 能拿到多少时间
 *   3) C 组 V5F_ATT_TILT_*    —— 决定姿态的固定偏差与悬停时能否用重力校准
 *   4) F 组 V5F_VEL_DECAY_K   —— 决定速度死区（原地自稳的"零漂移"范围）
 *   5) D/E 组                 —— 决定零偏牵引收敛快慢与机动期间是否误牵引
 *
 * 后期计划：板上自动整定。本表按"一个参数一行、语义独立、无隐藏耦合"组织，
 *   便于把右值替换成运行时可变量（建议后续给每组加一个 float 影子变量 +
 *   #define 指向它，或在初始化时从 Flash 载入）。
 * ===================================================================== */


/* =====================================================================
 * A 组：动静判定（处理函数 2）—— 陀螺侧的静态门
 * =====================================================================
 * 统计量 s = max_axis |W 帧滑窗均值|，其噪声尺度 sigma_s = sigma_raw/sqrt(W)。
 * 判据 thr(T) = clamp(K*sigma_eff(T), base, 上限)，证据不足时抬高阈值。
 *
 * ★★ W 是"悬停时能不能判静"的总开关：机身振动在几十~几百 Hz，W 太短（16 ms）
 *    根本平不掉振动，level 一直高 -> is_static 恒 0 -> 悬停时陀螺零偏牵引与
 *    倾斜融合**同时失效**（姿态只能靠陀螺积分，原地自稳有时间上限）。
 *      W | 窗长  | sigma_s   | base=10*sigma_s | 振动抑制
 *     ---+-------+-----------+----------------+---------
 *     128| 16 ms | 0.01082   | 0.108 dps      |  1x  <- 原值
 *     512| 64 ms | 0.00541   | 0.054 dps      |  4x
 *    1024|128 ms | 0.00383   | 0.038 dps      |  8x
 *    2048|256 ms | 0.00271   | 0.027 dps      | 16x
 *   加长窗口几乎不损失转动检测：实测真转动在窗口均值里的含量，
 *   W=128 时 0.0195 dps、W=1024 时约 0.0069 dps，仍远低于新阈值。
 *   ★ 代价：① s_thr_tab 必须按新 W 用 tools/calib/build_thr_table.py 重生成；
 *           ② 判运动延迟变长，V5F_PROC_ROLLBACK_GRANULES 要按新延迟复核。
 */
#define V5F_DET_SIGMA_RAW      0.1224f   /* 实测陀螺单样本噪声 dps（三轴平均） */
#define V5F_DET_K_SIGMA        10.0f     /* 虚警预算 K 倍 sigma */
#define V5F_DET_W              128u      /* 判静滑窗帧数 = W * 124.66us */
#define V5F_DET_THR_BASE       0.108f    /* = K*sigma_raw/sqrt(W) = 10*0.1224/sqrt(128) */
#define V5F_DET_THR_OFF_RATIO  0.6f      /* 回判静止阈值 = 0.6 * 当前阈值（滞回） */
#define V5F_DET_DEB_ON         8u        /* 连续 8 帧(1 ms)超阈 -> 判运动（快） */
#define V5F_DET_DEB_OFF        800u      /* 连续 800 帧(100 ms)低阈 -> 判静止（慢） */
#define V5F_DET_THR_NBUCK      20u       /* 阈值查找表档数（与 build_thr_table.py 一致） */
#define V5F_DET_THR_SHIFT      7u        /* 证据粒度数 -> 查表下标的右移量 */

/* ---- A 组补充：处理函数 2 的**启动阶段旁路**判据：交流能量 + 总能量 ----
 * 主路判据 s = max_axis |W 帧滑窗均值| 是**直流**判据，而且阈值表的索引来自
 *   "累积静止证据"，证据又只在主路判静止时累加 —— 于是形成一个闭环：
 *     上电零偏残差 > 表的上限 3*base = 0.3246 dps
 *       -> 主路恒判运动 -> 证据恒 0 -> 阈值永不衰减 -> 主路恒判运动 ...
 *   整条 V5F 链（bias_ok -> up_ref_ok -> att.valid -> q）就此**永久锁死**。
 *   实测 20260914_233341 正是这样锁死的：DC 0.528 dps（主路判运动），
 *   而同一时刻三轴交流能量只有 0.0545 dps^2，与正常静止的 0.0538 相差 1.3%。
 *   **交流量对直流零偏完全不可见** —— 这正是旁路能绕开该自环的根本原因。
 *
 * 实测（W=128 帧 = 16 ms 滑窗，三轴方差之和；单位 dps^2）：
 *   记录            性质       DC p50   e_ac p50   e_ac p95   e_ac max
 *   233341          死锁静止    0.528    0.05451    0.0649       0.09
 *   232745          正常静止    0.022    0.05384    0.0634       0.08
 *   231243          正常静止    0.022    0.05719    0.0674       0.25
 *   230919          正常静止    0.022    0.04755    0.0575       0.07
 *   224954          正常静止    0.023    0.04925    0.0590       0.08
 *   205342          手持运动    1.532    0.36792   332.4      64858
 *   221703          大幅运动   13.723    9.59538  5294.8      33947
 *   215619          大幅运动  103.973   84.40135  2354.1      15508
 * 噪声底 = 3*sigma_raw^2 = 3*0.1224^2 = 0.04495（实测 0.048~0.057，等效 sigma 0.135）。
 * 阈值取 0.20：静止记录越限比例 0.0~0.1%，运动记录 38~79%，两边都留足量级。
 *
 * 旁路只做"或"：只能把主路的"运动"改判成"静止"，绝不把"静止"改判成"运动"；
 *   且只在 bias_ok 锁存前参与，锁存后立即退出，稳态行为一字不改。
 * 能量判据（e_tot 上限）是必须的：**恒定速率的真转动没有交流量**，只有它挡得住。
 *   上限 2.0 dps 与门B 的 V5F_ATT_TILT_LEV_DPS 同源（实测该判据有效）。
 *   代价：换成零偏残差 > 2 dps 的器件时这一条仍会锁 —— 换器件必须重测这两个阈值。 */
#define V5F_DET_AC_E_ON        0.20f    /* 交流判据：三轴交流能量上限 dps^2 */
#define V5F_DET_AC_E_TOT       4.00f    /* 能量判据：三轴总能量上限 dps^2（等于 2 dps 恒定速率） */
#define V5F_DET_AC_DEB_ON      8u       /* 连续 8 帧(1 ms)满足 -> 旁路开（慢开） */

/* K 组：构建指纹 fw_tag（报表最后一列）
 *   编码 = (VER<<16) | (通道数<<8) | 开关位：bit0 EKF  bit1 MAG_CAL  bit2 判静旁路
 *   改固件必须 +1；刷完先核对它，对不上 = 刷写没生效。校验工具 check_fw.py。 */
#define V5F_FW_VER        56u
#define V5F_EKF_EN        1u      /* 阶段 1（S1）已落地：16 维 ESKF 影子模式 */
#define V5F_DET_AC_EN     1u
/* GSV 轮次间隔常量在 Common/Common/GPS.c 内定义：那个文件由 V3F 编译，看不到本头。 */
/* 撤销不设防抖：旁路只加静止，撤销要快，否则真转动会被多算成静止。
 * "旁路开 -> 关"的边沿由 V5F_PROC_ROLLBACK_GRANULES 的回退机制兜底。 */


/* =====================================================================
 * B 组：陀螺零偏牵引（处理函数 1）—— 决定"上电等多久才能飞"
 * =====================================================================
 * 静止时一阶牵引 bias += (raw - bias)*dt/tau，分两段：
 *   启动段 tau_boot（快收敛）-> 累计静止满 3*tau_boot 后切工作段 tau_work。
 *
 * ★ tau_work 是**对"能不能飞"影响最大的参数**：它决定残余零偏多久收敛到目标值。
 *   设上电初值误差 e0 = 94 deg/h（会话内实测），boot 段 3 s 后残余 4.68 deg/h，
 *   之后按 e^(-T/tau_work) 衰减：
 *     tau_work | 到 2 deg/h 需累计静止 | 到 3 deg/h | 估计器自身噪声
 *     ---------+-----------------------+------------+----------------
 *        24 s  |       23.3 s          |   13.6 s   |   0.71 deg/h
 *        12 s  |       13.2 s          |    8.3 s   |   1.00 deg/h   <- 原值
 *         6 s  |        8.1 s          |    5.6 s   |   1.42 deg/h
 *         4 s  |        6.4 s          |    4.8 s   |   1.74 deg/h
 *        12 -> 6 s：等待时间砍 40%，总误差 2.24 -> 2.45 deg/h（几乎不变）。
 *   实测核对：累计静止 8.34 s -> 3.0 deg/h（模型 2.99）。
 *   噪声公式 sigma_b = sigma_raw*sqrt(dt/(2*tau))，sigma_raw 见 A 组。
 */
#define GB_TAU_TICKS           1200000000ULL  /* tau_work = 12 s（单位 10 ns 计数） */
#define GB_TAU_BOOT_TICKS      100000000ULL   /* tau_boot = 1 s */
#define GB_BOOT_TICKS          (3ULL * GB_TAU_BOOT_TICKS)   /* 3*tau_boot = 3 s，锁存 bias_ok */
#define GB_SNAP_TICKS          2000000ULL     /* 快照粒度 = 20 ms */
#define V5F_GB_DT_MAX_TICKS    20000000ULL    /* 单帧 dt 上限 = 200 ms。正常帧 124.7 us
                                              * （=12466 tick），差 1600 倍，不影响正常运行。
                                              * 为什么要钳：dt 直接进 alpha=dt/tau，时间戳
                                              * 大跳时 alpha>1 会让零偏跳变；且一次
                                              * 大 dt 就可能把"有效追踪时长"瞬间灌满
                                              * 而假锁存 bias_ok。 */
#define GB_HIST_DEPTH          64u            /* 快照深度 64 格 = 1.28 s（回退用） */
/* ★ 派生式：改 tau 只需改上面两个 TICKS，别另写数字 */
#define GB_ALPHA_WORK_TICK     (1.0f / (float)GB_TAU_TICKS)       /* 每 tick 系数 = 1/tau_work */
#define GB_ALPHA_BOOT_TICK     (1.0f / (float)GB_TAU_BOOT_TICKS)  /* 每 tick 系数 = 1/tau_boot */


/* =====================================================================
 * C 组：倾斜融合（处理函数 3）—— 用重力持续校准姿态
 * =====================================================================
 * omega_tilt = +K * (a_hat x g_hat)，K = (180/pi)/tau，**单位 dps、dt 不折进去**
 *   （dt 由 proc_attitude.c 的 half 统一乘）。
 * 分两段：启动段 tau_boot 快速把参考系拉对齐，bias_ok 后切工作段。
 *
 * ★ 本环是纯 P 环，对常值速率扰动（残余零偏 omega_res）留稳态倾角
 *     tilt_eq = omega_res * tau_eff,  tau_eff = 1/(1/tau_tilt + 1/tau_p)
 *   这个倾角直接漏重力进 a_lin，而 a_lin 的直流又决定速度：
 *     omega_res |  tau_tilt=5 s(tau_eff=3.61)  |  tau_tilt=30 s(tau_eff=9.07)
 *     ----------+------------------------------+----------------------------
 *      3 deg/h  |        0.0030 deg            |        0.0076 deg
 *     30 deg/h  |        0.0301 deg            |        0.0756 deg
 *     94 deg/h  |        0.0943 deg            |        0.2367 deg
 *   ★ 与速度死区的关系（原地自稳）：K=0.05 m/s^2 对应倾角死区 0.2924 deg，
 *     只要 tilt_eq 在里面速度就**精确为 0**。校准开着时残余零偏直到 ~291 deg/h
 *     都还在死区内；校准关着时 3 deg/h 也只能撑 5.8 min。**悬停必须能跑本环。**
 *
 * ★ 门控用的是 gate->att_tilt（由处理函数 5 独立算出），判据 = |off| 在
 *   [ALIM_LO, ALIM_HI] 且陀螺判静。ALIM 对**姿态歪**免疫、只对线加速度敏感，
 *   但它是二阶量：+-5% 容得下 |a_h| 到 3.1 m/s^2（会把估计的"上"拉偏 17.5 deg），
 *   所以"陀螺判静"那一条不能省。要更保守就把 ALIM_HI 收到 1.02（对应 11 deg 倾斜）。
 */
/* [20260914 判据落地 v2] 原判据在 proc_acc_gate.c 里额外与了 h->stat.is_static，
 *   而手持/悬停时 16 ms 陀螺窗均值被手抖/机身振动顶到 1.7~2.1 dps，is_static 只有
 *   10% -> 重力牵引 90% 的时间关着，上面算好的 tilt_eq 根本享受不到，姿态只能按
 *   残余零偏自由漂（实测 0.0174 dps = 63 deg/h，1 min 1.05 deg）。
 *   实测 20260914_073640（手持静止 20.63 s、手抖 2.07 dps）：|off| 中位数 1.0003 g，
 *   比力方向与**纯陀螺积分**重力方向夹角 p50 0.49 deg、p99 2.50 deg -> 加速度计
 *   全程都是合法重力参考。
 *   但只用 |off| 会被"往复运动中的瞬时带内"骗到：20260914_063706（桌面转正方形 ->
 *   抬起 10 cm 再转）占空比 69%，姿态被多拉偏 0.67 deg，末位置 |p| 0.0445 -> 0.1304 m。
 *   真正区分"抖动"与"真转动"的是**长窗内的净转动**：抖动零均值，转正方形不是。
 *   故最终判据 = 256 ms 窗 |off| 均值 ∈ 1 g +-3%  且  256 ms 窗净 |w| < 2 dps。
 *   离线扫描（3 份录制 5 个区间）占空比：手持静止 92% / 转正方形 21% / 放回静止 100%
 *   / 070300 静止 100% / 070300 剧烈 32%；整链末位置 |p| 0.0350 m（优于旧门 0.0445）。
 *   20 g 冲击会把窗均值顶出带外自动关门。已知耦合：门B 常开会让门A 的 |w| 变小、
 *   零偏环更容易工作，但零偏被 V5F_ACC_TRACTION_BIAS_LIM_MG 钳住，实测未顶限幅。 */
#define V5F_ATT_TILT_TAU_S       5.0f    /* 工作段 tau（s） */
#define V5F_ATT_TILT_TAU_BOOT_S  1.0f    /* 启动段 tau（s），与陀螺牵引启动段同值 */
#define V5F_ATT_TILT_ALIM_LO     0.97f   /* 倾斜环门：|off| 下界（单位 g） */
#define V5F_ATT_TILT_ALIM_HI     1.03f   /* 倾斜环门：|off| 上界（单位 g） */
/* ★ 派生式 */
#define V5F_ATT_TILT_GRAN       256u     /* 门B 统计档长：32 ms @8.03 kHz */
#define V5F_ATT_TILT_NGRAN        8u     /* 档数：8 * 32 ms = 256 ms 总窗 */
#define V5F_ATT_TILT_W          (V5F_ATT_TILT_GRAN * V5F_ATT_TILT_NGRAN)
#define V5F_ATT_TILT_LEV_DPS     2.0f    /* 长窗净 |w| 上限（dps），挡住真转动 */
#define V5F_ATT_TILT_K         (57.29578f / V5F_ATT_TILT_TAU_S)
#define V5F_ATT_TILT_K_BOOT    (57.29578f / V5F_ATT_TILT_TAU_BOOT_S)
#define V5F_ATT_TILT_ALIM_LO2  (V5F_ATT_TILT_ALIM_LO * V5F_ATT_TILT_ALIM_LO)
#define V5F_ATT_TILT_ALIM_HI2  (V5F_ATT_TILT_ALIM_HI * V5F_ATT_TILT_ALIM_HI)


/* =====================================================================
 * D 组：加速度零偏牵引（处理函数 4）—— PI（二阶）环
 * =====================================================================
 *   dz/dt = e*S/T_i ；  db/dt = e*S/tau_p + z
 * 二阶的理由：一阶环对驱动量里的常量/斜坡扰动留残差，加积分状态变 type-2 后归零。
 * ★ tau_p 是按**带零点的闭环实测过冲**定的，不是按标称 zeta —— 别用纯二阶公式反推。
 *   现值 tau_p=13 s / T_i=400 s^2 -> omega_n = 1/sqrt(T_i) = 0.05 rad/s。
 * ★ 本环只影响 a_lin/速度，**不影响姿态**。
 * ★ tau_p 与倾斜环并联作用于同一个 a_lin（tau_eff 见 C 组），两者时间常数要拉开。
 * ★ 过冲/斜坡残差的历史数据（仅对旧 T_i = 2 s^2 成立）见 v5f_proc.h 的 PI 段说明。
 */
#define V5F_ACC_TRACTION_TAU_P_WORK_S  13.0f      /* 工作段比例项 tau_p（s） */
#define V5F_ACC_TRACTION_TI_WORK_S2    400.0f     /* 工作段积分时间 T_i（s^2）= 1/omega_n^2 */
#define V5F_ACC_TRACTION_TAU_P_BOOT_S  7.0f       /* 启动段 tau_p（s） */
#define V5F_ACC_TRACTION_TI_BOOT_S2    100.0f     /* 启动段 T_i（s^2） */
#define V5F_ACC_TRACTION_DT_SCALE      1e-8f      /* tick -> s */
#define V5F_ACC_TRACTION_RATE_LIM_LSB  500.0f     /* 积分状态 z 的限幅（LSB/s） */
#define V5F_ACC_TRACTION_SNAP_TICKS    2000000ULL /* 零偏快照粒度 = 20 ms */
#define V5F_ACC_TRACTION_HIST          64u        /* 快照深度 64 格 = 1.28 s */
#define V5F_ACC_TRACTION_BOOT_TICKS    300000000ULL /* 累计牵引满 3 s 后由启动段切工作段 */
#define V5F_ACC_TRACTION_BIAS_LIM_MG   40.0f      /* 零偏相对离线初值的钳位（mg） */
/* ★ 派生式：ALPHA 是"每 tick 系数"，与 tau 是同一个量的两种写法，必须一起变 */
#define V5F_ACC_TRACTION_ALPHA_WORK    (V5F_ACC_TRACTION_DT_SCALE / V5F_ACC_TRACTION_TAU_P_WORK_S)
#define V5F_ACC_TRACTION_ALPHA_BOOT    (V5F_ACC_TRACTION_DT_SCALE / V5F_ACC_TRACTION_TAU_P_BOOT_S)
#define V5F_ACC_TRACTION_ALPHA_I_WORK  (V5F_ACC_TRACTION_DT_SCALE / V5F_ACC_TRACTION_TI_WORK_S2)
#define V5F_ACC_TRACTION_ALPHA_I_BOOT  (V5F_ACC_TRACTION_DT_SCALE / V5F_ACC_TRACTION_TI_BOOT_S2)


/* =====================================================================
 * E 组：加速度牵引的**外部门控**（处理函数 5）
 * =====================================================================
 * 判据 w = (accel_lsb - 离线零偏)/标度 - R(q)^T*up_ref，比较 |w|^2：
 *   牵引中 |w| > OFF -> 冻结（快，8 帧 = 1 ms）
 *   冻结中 |w| < ON  -> 恢复（慢，800 帧 = 100 ms）
 * ★ 判据必须用**离线标定常量**算，不能用 a_lin（自引用会锁死）。
 * ★ ON 必须高于"真静止时的残余"，否则门在真静止时打不开；OFF 必须低于真实机动。
 * ★ 门 B（倾斜融合的 att_tilt）在同一个函数里**独立**算出，不复用本组判据。
 */
#define V5F_ACG_ALIN_ON_MG     40.0f     /* 可恢复牵引的残余上界（mg） */
#define V5F_ACG_ALIN_OFF_MG    100.0f    /* 应冻结的残余下界（mg），2.5 倍滞回 */
#define V5F_ACG_DEB_ON         800u      /* 恢复去抖：连续 800 帧(100 ms)在 ON 以下 */
#define V5F_ACG_DEB_OFF        8u        /* 冻结去抖：连续 8 帧(1 ms)超 OFF */
#define V5F_ACG_ROLLBACK_GRANULES 1u     /* 牵引->冻结边沿回退的 20 ms 粒度数 */
/* ★ 派生式 */
#define V5F_ACG_ALIN_ON2       ((V5F_ACG_ALIN_ON_MG  * 1e-3f) * (V5F_ACG_ALIN_ON_MG  * 1e-3f))
#define V5F_ACG_ALIN_OFF2      ((V5F_ACG_ALIN_OFF_MG * 1e-3f) * (V5F_ACG_ALIN_OFF_MG * 1e-3f))


/* =====================================================================
 * F 组：世界系速度（处理函数 6）
 * =====================================================================
 * 递推：v += a_nav*dt ；然后**两级衰减叠加**：
 *   ① 乘性   v *= (1 - h/tau)    管**大**速度
 *   ② 常速率 |v| -= K*h          管**小**速度
 *
 * ★ 为什么必须两级（这是实测事故换来的）：
 *   只用常速率（K=0.05）时，减掉的量恒为 K*h，**与 |v| 无关** -> 大速度是线性斜坡，
 *   从 v0 刹到 0 要 v0/K 秒、走过 v0^2/(2K)。实测 20260914_070300：
 *   机动结束残留 0.74 m/s（姿态误差约 0.27 deg 的正常航位推算误差），
 *   常速率要 14.8 s 才杀完，期间位置漂 **竖直 5.93 m / 水平 1.60 m**（严重失效外漂）。
 *   只用乘性则大速度刹得住（路程 ~ v0*tau），但小速度有指数尾、稳态停在
 *   a_bias*tau 而不是 0，而且反相（见下）。
 *   两级叠加后同一段驱动重放：竖直 0.63 m / 水平 0.087 m（比现状好 9.4~18 倍）。
 *
 * ★ 乘性的两个副作用，都是**已知且可接受**的：
 *   · 反相：乘性减掉的量 = |v|*h/tau 正比于 |v|，会把"推出去再拉回来"的正向摆幅
 *     按比例吃掉，速度穿过 0 反相（实测反相达峰值 23%）。用 K 那条线性项把它压住：
 *     反相幅度降到约 9%，且随 tau 在几秒内消失。
 *   · 稳态偏差：乘性单独用会停在 a_bias*tau；由 ② 的线性项兜底成**精确 0**。
 * ★ K 是原地自稳的死区：倾角误差 < asin(K/g) 时速度恒 0，飞控看不到假漂移。
 *     K (m/s^2) |  = mg   | 能压住的 a_bias | 倾角死区  | 1 s 机动损失
 *     ----------+---------+----------------+-----------+-------------
 *       0.05    |  5.10   |    < 5.10 mg   |  0.2924deg|  0.050 m/s  <- 原值
 *       0.10    | 10.21   |   < 10.21 mg   |  0.5848deg|  0.100 m/s
 *       0.20    | 20.41   |   < 20.41 mg   |  1.1696deg|  0.200 m/s
 *   实测残余 a_bias ~2.2 mg，0.05 留 2.3 倍余量。速度不参与姿态控制，K 加大只损失
 *   机动保真、换来更宽的零漂移区。
 */
#define V5F_VEL_G_LOCAL        9.7985f   /* 本地重力 m/s^2（随纬度变化，按场地改） */
#define V5F_VEL_DECAY_K        0.05f     /* 常速率地板（m/s^2）：管小速度，|a_bias|<K 时精确归零 */
#define V5F_VEL_DECAY_TICK_S   1e-8f     /* 10 ns 计数 -> s */
/* ---- 速度的**软 ZUPT**（外部连续门，见 proc_acc_gate.c 门 C）----
 * ★ 成熟做法，不是硬"速度归零门"：衰减**时刻都在跑**，置信度 lam 只调**速率**：
 *     rate = lam/tau_fast + (1-lam)/tau_slow      v *= (1 - h*rate)
 *   lam -> 1（判定静止）：速率大，幽灵速度在 tau_fast 量级内消失；
 *   lam -> 0（机动中）：  速率小，真实速度几乎不损失。
 *   出处：Wahlstroem&Skog, "Fifteen Years of Progress at Zero Velocity"（arXiv 2008.09208）；
 *         OpenShoe（hcarlsso/ZUPT-aided-INS）的互补反馈 + 伪观测结构；
 *         Engelsman&Klein, "C-ZUPT: Stationarity-Aided Aerial Hovering"
 *         （arXiv 2507.09344）—— 正是四旋翼悬停场景。
 * ★ 自适应阈值：文献里贝叶斯阈值的损失因子随"距上次零速观测的时间"衰减，
 *   效果是"既不让系统太久没有 ZUPT，也不至于滥加 ZUPT"。这里实现成
 *   lam 的**下限随时间抬升**：距上次高置信锚点越久，衰减越快 -> 幽灵速度不可能长期存在。
 *
 * 定标（20260914_070300 实测失效记录，同一段驱动重放；原设计漂 竖直 5.93 m / 水平 1.60 m）：
 *   衰减律                        竖直漂移  水平漂移  机动末|v|  |v|max  精确零速帧
 *   ---------------------------  --------  --------  ---------  -------  ----------
 *   纯常速率 K=0.05（原失效）     5.920 m   1.601 m    0.758      0.834    22.7%
 *   乘性+常速率 固定 tau=1 s      0.632 m   0.087 m    0.774      0.816    72.4%
 *   软 ZUPT tau_f=0.2/30         0.285 m   0.030 m    0.759      0.834    77.2%
 *   三项指标同时最好（漂移好 20.8 倍，运动保真还比固定版更强）。 */
#define V5F_VEL_ZUPT_TAU_FAST_S  0.20f   /* lam=1 时的衰减时间常数（s） */
#define V5F_VEL_ZUPT_TAU_SLOW_S  30.0f   /* lam=0 时的衰减时间常数（s） */
#define V5F_VEL_ZUPT_LEV_DPS     0.20f   /* 陀螺 level 低于它算"静止"（置信度 -->
                                          * 1；到 0 时置信度 0）。注意要宽松：悬停时机身
                                          * 振动会让 level 偏高，太严就等于悬停时没有 ZUPT。 */
#define V5F_VEL_ZUPT_AMAG_G      0.05f   /* |比力|-1g 的容差（g） */
/* [20260914 删除] 原先还有"无锚点强制衰减"下限（ANCHOR=0.80 / FORCE_S=5 s）：
 *   连续 5 s 没有准静止锚点就把置信度顶到 255，等效把速度按 tau=0.2 s 压成 0。
 *   但"连续 5 s 没有准静止"恰恰是**正常飞行**，后果是真实速度被吃掉。
 *   实测 20260914_063706（抬到 +0.10 m 停住再放回）：
 *     现状(FORCE_S=5s)  Z@t=5.6 只有 +0.0541（真值 +0.10），末位置 p_z=+0.0342
 *     关掉下限          Z@t=5.6 = +0.1051，末位置 p_z=-0.0016，|p| 0.0436 -> 0.0391（最好）
 *   实测 20260914_070300 关掉下限几乎无损：|p| 0.2695 -> 0.2856（该 0.27 m 来自
 *   20 g 加速度饱和，与速度估计无关）。防"速度不可控存在"由 V5F_VEL_DECAY_K
 *   的常速泄放兜住（dv/dt = a_e - K，a_e < K 时速度确定性归零）。 */
/* ★ 派生式 */
#define V5F_VEL_ZUPT_RATE_FAST   (1.0f / V5F_VEL_ZUPT_TAU_FAST_S)
#define V5F_VEL_ZUPT_RATE_SLOW   (1.0f / V5F_VEL_ZUPT_TAU_SLOW_S)


/* =====================================================================
 * G 组：处理链门控的公共参数
 * ===================================================================== */
#define V5F_PROC_ROLLBACK_GRANULES  24u  /* 静止->运动边沿回退的 20 ms 粒度（= 480 ms） */
#define V5F_PROC_GATE_INIT_STATIC   1u   /* 门控上电初值：先按静止处理 */


/* =====================================================================
 * H 组：IST8310 磁力计线性标定（12 参数）
 * =====================================================================
 * 校准式：  y = V5F_MAG_A * raw + V5F_MAG_C
 *   raw = IST8310 原始 16 位补码 LSB（**不取反**；z 取反已经折进 A）
 *   y   = 机体坐标系下的地磁**单位方向**（指向磁北且向下），导航系与姿态 q 同序
 *         （x = 右，y = 前，z = 上）。倾斜补偿后 atan2(y_x, y_y) 就是磁航向，
 *         再加磁偏角即真航向。
 *
 * 为什么必须反一根轴：IST8310 原始三轴是**左手系**。两个独立开源驱动各自反了一根
 *   （ArduPilot 反 z，注释 "to conform to right-hand rule convention"；
 *    Betaflight 反 y，注释 "datasheet is incorrect"），本机数据也独立复现：
 *   未取反时拟合出的 det(M) < 0，即含一次反射。反哪一根取决于板子装配旋转，
 *   反正必须反一根；这里统一折进 A，调用方不必自己动手。
 *
 * 标定集：4 份离机 2 m 以上的干净录制的高置信子集（|m| 在该份中位 +-15%），
 *   共 37340 点，方向覆盖到 248/288 格。池化结果：
 *   软铁各向异性 19.76%，硬铁 2.19 uT，四份各自解出的磁倾角 -62.9 ~ -64.9 度
 *   （分散 2.0 度）。
 *
 * 实测精度（这一组固定常量跨会话直接用，不做任何在线重标）：
 *   最好那份（118 s）航向误差 p50 1.31 度 / p95 7.91 度，|y| 离散 1.97%；
 *   其余三份 4.5 ~ 5.7 度 p50。
 *   按角速度分档（最好那份）：|w| < 20 dps -> 1.13 度；> 400 dps -> 4.58 度。
 *   ★ 高角速度段残差变大是**姿态参考**被向心加速度污染，不是磁力计本身。
 *
 * ★ 为什么这组常量放在本表（工况可调）而不是 v5f_proc.h（逐器件标定）：
 *   它随**装机**变 —— 硬铁来自机架/螺丝/线缆的 DC 场，软铁来自附近铁磁件。
 *   实测：换装配后 |y| 偏约 9%；四份会话的 |y| 均值就有 0.958 ~ 1.018 的差。
 *   硬铁还有慢漂，速率与"最近是否动过机械"强相关：
 *       装配长期没动 : +0.013 / -0.020 uT/s（118 s 那份只有 +0.006）
 *       刚拧/刚拆螺丝: -0.145 / -0.216 uT/s（约 10 ~ 30 倍，且 48 s 内不衰减）
 *   所以标定前要离机 2 m 以上并静置几分钟，标定后不要再动机械。
 *   后续若加"飞手转一圈"的机上椭球标定，把这组常量换成运行时可变量即可。
 *
 * 生成：PC 端 mag_export_c.py -> _export_c.txt -> 手工粘贴到这里。
 * ===================================================================== */
#define V5F_MAG_CAL_EN    1u      /* 1 = 应用下面这组标定
                                   * 0 = 直通（只归一化，不做标定也不判门），
                                   *     用于 A/B 对照"标定到底改善了多少" */
#define V5F_MAG_ERR_LIM   0.10f   /* |y| 一致性门限：| ||y|| - 1 | 超过它就把
                                   * mag.ok 置 0（判该样本受外部磁源污染）。
                                   * 实测干净会话 |y| 离散 2.0 ~ 4.8%；桌面污染
                                   * 会话 6.1 ~ 6.7%；整段被外部磁源覆盖时 |y|
                                   * 可达 1.4 ~ 2.9。取 10% 拦得住又不误伤。 */
/* y = V5F_MAG_A * raw + V5F_MAG_C （raw 为原始 LSB，不取反）。
 * 做成 _INIT 宏而不是直接放 static const 数组：本表被 v5f_proc.h 广泛 include，
 * 直接放数组会在每个编译单元各生成一份；实体化只在 SPI_rx.c 里做一次。 */
#define V5F_MAG_A_INIT  { { +2.08949323e-04f, -6.19417513e-03f, -2.26128295e-04f }, \
                          { -5.83573699e-03f, -2.51671372e-04f, -2.84947620e-04f }, \
                          { +2.45618031e-04f, +6.66588056e-04f, +6.02697722e-03f } }
#define V5F_MAG_C_INIT  { +2.74710494e-02f, +2.72699298e-02f, +1.44001944e-02f }
/* ---- 磁力计"自己认为的维度"输出的参数（只读输出，不参与修正） ---- */
#define V5F_MAG_DECL_DEG   (-7.53f)  /* 磁偏角 D：来源 WMM/IGRF（ArduPilot AP_Declination
                                      * 的 10 度派生表 + 双线性插值）@ 36.23N 120.44E。
                                      * 真航向 = 磁航向 + D。
                                      * ★ 偶极子近似算 D 会差 9.9 度，不可用；必须用模型。
                                      * 换场地要重算；同一场地几公里内基本不变
                                      * （每 0.5 度纬度 D 才变 0.13 度）。 */
#define V5F_MAG_ALIN_LIM   (0.05f)   /* 倾斜残差门（g）：|a_lin| 超过它则认为倾斜不可信，
                                      * 磁航向一并置为不可信（trust=0）。
                                      * ★ 为什么不能只看 mag.ok：验收录制 221703 的第三段
                                      * （超大幅运动）里 mag.ok 有 97.3%，但 |a_lin| 达 2.24 g、
                                      * 重力残差 62 度 —— 倾斜坏了磁航向也跟着坏。
                                      * ★ 反过来，|a_lin| 大也可能是"真的在加速"（第一段
                                      * |a_lin| p50 = 0.25 g 就是移动造成的），这时丢掉磁样本
                                      * 是保守但安全的；激进机动本来也不指望磁航向。
                                      * 上层若要自己算权重，可同时读 11~13 路 a_lin 与 53 路 |y|。 */
/* ---- 仅作离线校验/记录，代码不用（偏航输出**不需要** dip） ----
 * WMM/IGRF @ 36.23N 120.44E：磁倾角 I = +53.74 度，总强度 F = 52.05 uT。
 * ★ 实测"视在"倾角 63~64 度，比 WMM 陡 7~11 度；把拟合 dip 约束到 53.74 度后
 *   五份记录的残差全部**变差**（平均 2.47 -> 3.65 度），说明偏的是姿态的倾斜参考
 *   （加速度计 3x3 未标定），不是磁标定。→ 先做 3x3 加速度计标定再谈 dip。 */
/* 拟合出的 M 奇异值 (uT)：[54.28 50.61 45.32]   硬铁 (uT)：[+1.39 +1.41 +0.93]
 * A 的物理含义：把 1 LSB 原始读数映射成约 6e-3 的方向分量（1/155 LSB）；
 * 三轴增益差 19.76% 就是标定要修掉的软铁，C 是硬铁在 A 作用后的残差。 */


/* =====================================================================
 * I 组：EKF 观测模型（噪声 / 降频 / 偏置）
 * =====================================================================
 * ★ 全部由**静止记录实测**给出，不是猜。前提："这段确实没有移动"，
 *   于是位置/速度的全部变化都是**绝对误差**。
 *
 * 实测汇总（静止，真值 0）：
 *   水平位置   2D RMS 3.95 m（DGPS + 21 星 + HDOP 1.00）
 *              其余三份 4.50 / 6.00 / 14.93 m（几何或差分更差时）
 *              ★ 反推 UERE 3.75~4.09 m，健康 DGPS 应 0.5~1 m、单点 1~2 m
 *              -> 误差与几何无关、与是否差分基本无关，是**信号环境**问题
 *              -> 见 C/N0 通道（85~88），它能把"信号弱"和"多径"分开
 *   逐差(白噪) 0.065 m vs 总 3.95 m（60 倍）；自相关 lag1 0.999 / lag10 0.952
 *              / lag50 0.434  -> **几乎全是低频游走**，不是白噪声
 *   多普勒速度 静止时 mean +0.25~+0.40 m/s（真值 0！有直流偏置）
 *              标掉偏置后 std 0.15 m/s  -> 仍是最可信的水平观测
 *   GPS 高度   std 2.5~5.5 m
 *   气压高度   单样本 5.0 Pa(0.42 m)；软件平均 W=32 -> 1.0~1.5 Pa(0.09~0.13 m)
 *   磁航向     静止/准静态 0.7 度（见 H 组说明）
 *
 * ★ 为什么气压计不改 OSR/IIR（用户明确要求）：
 *   BMP388 保持 OSR x1（0x1C=0x00）、硬件 IIR 关闭（0x1F 从不写，保持 POR 默认），
 *   因为只有这样转换时间才短到能和 IST8310 **流水线**读取。噪声在软件里平均掉。
 * ===================================================================== */
#define V5F_MAG_YAW_R_DEG      0.5f    /* 磁航向 1sigma（度），准静态+倾斜门后 */
#define V5F_GPS_POS_R_H_M      4.0f    /* GPS 水平位置 1sigma（m）—— 按 2D RMS 取 */
#define V5F_GPS_POS_R_V_M      5.5f    /* GPS 垂直位置 1sigma（m）—— 只用做慢速绝对基准 */
#define V5F_GPS_ALT_R_M        5.5f    /* 同上（单独列出便于上层区分"高度观测"） */
#define V5F_GPS_POS_DECIM_HZ   0.3f    /* 位置更新降频（Hz）。误差自相关 ~5 s，降到 0.3 Hz
                                        * 后相邻样本近似独立，膨胀 R 就够，不必建偏置状态 */
#define V5F_GPS_VEL_R_MPS      0.15f   /* 多普勒速度 1sigma（m/s），标掉直流偏置后的 std */
#define V5F_GPS_VEL_BIAS_MPS   0.27f   /* 多普勒速度直流偏置（m/s）：静止真值 0，实测均值
                                        * +0.25~+0.40，取 0.27。★ 用之前先减掉它 */
#define V5F_BARO_AVG_W         32u     /* 气压软件平均窗口（样本数，193.8 Hz -> 0.165 s，
                                        * 滞后 83 ms）。实测这已接近 OSR x8 的水平 */
#define V5F_BARO_R_M           0.13f   /* 平均后气压高度 1sigma（m）—— 比 GPS 高度好约 40 倍 */

/* ★ 观测模型的使用原则（写在这里免得后面忘）：
 *   [1] GPS 位置**不能当白噪声**逐点更新 10 Hz。要么按 V5F_GPS_POS_R_H_M 给 R，
 *      要么按 V5F_GPS_POS_DECIM_HZ 降频；两者叠加更稳。
 *   [2] 高度用气压计（V5F_BARO_R_M）做主观测，GPS 高度只做慢速绝对锚点。
 *   [3] 速度用多普勒：先减 V5F_GPS_VEL_BIAS_MPS，R 取 V5F_GPS_VEL_R_MPS 的平方。
 *      它与位置误差不相关，可以按白噪声处理。
 *   [4] 磁力计只提供偏航维度（H 组），不参与修正，交给 EKF。 */


/* =====================================================================
 * 与工况无关、仅作引用（值在 v5f_proc.h）
 * ===================================================================== */
/* V5F_ACC_TRACTION_ZETA        有效阻尼 zeta（仅记录，代码不用） */
/* V5F_ACC_TRACTION_FLAG_ROLLBACK / V5F_GYRO_CORR_FLAG_ROLLBACK  标志位，非参数 */

/* =====================================================================
 * J 组：导航 EKF（处理函数 7/8）—— 设计见仓库根的 ekf_design.md
 *
 * ★ 允许在线改的只有**标量**（Q/R、门阈值、开关、抽取率）；数组尺寸与状态维
 *   数一律编译期固定（否则 P 的布局会随参数变，在线改就不可能安全）。
 *
 * ★ S0.3 实测（长静止记录逐差 + Allan）：加计零偏 / 陀螺零偏 / 气压基准三个
 *   随机游走的漂移**全部低于 300 s 的检测门限**，所以 Q 的三个 RW 项取 0。
 *   这不是"没测"，是"测到的上界比观测噪声还低"。陀螺零偏不稳定性实测
 *   0.000131 dps = 0.472 度/h，重复两次一致。
 * ===================================================================== */

/* ---- 开关与抽取 ---- */
#define V5F_EKF_DECIM            16u     /* 每 16 帧一个 EKF 步 = 8021.9/16 = 501.4 Hz */
#define V5F_EKF_YAW_OBS_EN       1u      /* M7 磁偏航在 EKF 内闭环（默认开） */
#define V5F_EKF_TILT_EN          1u      /* M6 重力/倾斜观测 */
#define V5F_EKF_DT_MAX_S         0.2f    /* 单帧 dt 上限，超过视为时间戳异常 */
#define V5F_EKF_G_MPS2           9.7985f /* 本地重力。与 V5F_VEL_G_LOCAL 同值但**独立成
                                          * 常量**：两环不许通过同一个宏耦合 */
#define V5F_EKF_R_EARTH_M        6378137.0f  /* WGS84 长半轴，经纬度 -> 米 */
#define V5F_EKF_ALIGN_AMAG_TOL   0.02f   /* 对齐时 |a| 必须落在 1 g +-2% */
/* ---- 对齐的兜底层级（保证 EKF 一定会启动）----
 * VER=26 实测：对齐条件里挂了 mag.trust（实测只有 25.6%）与 is_static（37.4%），
 * 两者没同时落上 -> gate_bits 恒 0、|ekf_q| 恒 0，整个 EKF 永久停摆。
 * 所以改成"逐级放宽 + 超时强制 + 自己建倾角"，不再依赖旧链标志的时序。 */
#define V5F_EKF_ALIGN_AMAG_LOOSE 0.06f   /* 超时兜底时 |a|^2 的容差（约 |a| 3%）*/
#define V5F_EKF_ALIGN_TIMEOUT_S  8.0f    /* 超过它就放宽（不再要求判静）*/
#define V5F_EKF_ALIGN_FORCE_S    20.0f   /* 再超过它就强行对齐（倾角误差交给 M6）*/   /* 对齐时 |a| 必须落在 1 g +-2% */

/* ---- 过程噪声（除 RW 外都来自实测）---- */
#define V5F_EKF_SIG_G_DPS        0.1224f /* 陀螺单样本噪声 dps（实测，三轴平均） */
#define V5F_EKF_SIG_G_RADS       (V5F_EKF_SIG_G_DPS * 0.017453292f)
#define V5F_EKF_SIG_A_MPS2       0.0217f /* 加计噪声 2.21 mg -> m/s^2（实测） */
/* ★ 这条不是"器件零偏"的随机游走，而是给**重力经倾角误差的泄漏**留的去处。
 *   S0.3 测出器件零偏的游走低于门限（所以不能拿它当器件模型），但泄漏本身是
 *   一段"对给定姿态恒定"的比力误差，物理归宿就是 ba。原来取 0 且 P0_BA 只有
 *   2 mg，而泄漏可达 0.1~0.2 m/s^2（= sigma_tilt 0.6~1.1 度 x g），滤波器推不动 ba，
 *   于是泄漏全跑到速度里去了（VER=23 实测：平移段速度被死区削掉 33~86%）。
 *   0.01 m/s^2/sqrt(s)：10 s 长到 0.032、100 s 长到 0.1 —— 正好覆盖泄漏量级。 */
#define V5F_EKF_SIG_BA_RW        0.01f
#define V5F_EKF_SIG_BG_RW        0.0f    /* 陀螺零偏随机游走：同上 */
#define V5F_EKF_SIG_BARO_RW      0.0f    /* 气压基准随机游走：同上 */
/* 加速度整流（离心项 a_c = w^2*r）在陀螺上的误差上界 [dps/g]。
 * 【项目实测】大幅摇晃 20.8 s、积分 a_c dt = 20.8 g*s -> 末态姿态反了 17.77 度；
 *   小幅 2.9 g*s -> 2.38 度。反推 0.85 / 0.82 dps/g。
 *   ★ 不拿它去**补偿**：tools/calib/g_sens_axis.py 扫出来的标量模型对三条记录
 *     全部是负效果（8.649 -> 8.997 度），所以 V5F_GYRO_GSENS_* 是 0。
 *   但它是**真实存在的不确定度**，必须进 Q，否则 sigma_yaw 会在剧烈运动里撒谎
 *   （实测真实偏航误差 15.7 度时 sigma_yaw 只报 0.441 度，差 35 倍）。 */
#define V5F_EKF_DIP_TAN          2.08f   /* = tan(I_measured) = tan(64.26 度)。
                                          * ★ 用**实测**倾角，不用 WMM 的 53.74 度：
                                          *   方位角 h 对倾角误差的灵敏度就是 tan(I_measured)
                                          *   （实测静止段 EKF 姿态量出的 I = 64.26 +- 1.96 度，
                                          *   WMM 真值 53.74 度 -> 磁标定有 10.5 度软铁误差，
                                          *   且随姿态变 4.1 度，内部 std 仅 0.16 度）。
                                          *   原来写 1.364 是把自适应 R 给小了 1.5 倍。 */  /* tan(真倾角 I)：I = 53.74 度（WMM）。
                                          * 倾角误差 dh 会让水平方位角偏 tan(I)*dh，
                                          * 所以 M7 的 R 要加上 (tan(I)*sigma_tilt)^2。
                                          * ★ 用 WMM 的真倾角，不用实测那个 63~64 度
                                          *   （实测 dip 异常是磁力计自身的问题，
                                          *    导航系里的地磁方向仍由真实地球磁场决定） */
#define V5F_EKF_RECT_DPS_PER_G   0.85f
#define V5F_EKF_Q_FLOOR          1.0e-12f
#define V5F_EKF_P_FLOOR          1.0e-12f

/* ---- P0（对齐那一帧）---- */
#define V5F_EKF_P0_POS_M         1.0f
#define V5F_EKF_P0_VEL_MPS       0.1f
#define V5F_EKF_P0_TILT_RAD      (0.5f * 0.017453292f)   /* 对齐残差实测中位 0.49 度 */
#define V5F_EKF_P0_YAW_RAD       (3.0f * 0.017453292f)   /* 磁航向初始化误差；此后由 M7 收紧 */
#define V5F_EKF_P0_BA_MPS2       0.02f
#define V5F_EKF_P0_BG_RADS       (0.02f * 0.017453292f)
#define V5F_EKF_P0_BARO_M        5.0f

/* ---- 观测噪声 R（数值来源都是 I 组的实测值）---- */
#define V5F_EKF_MAG_SIG_RAD      (V5F_MAG_YAW_R_DEG * 0.017453292f)  /* 0.7 度 */
#define V5F_EKF_TILT_SIG_RAD     (0.5f * 0.017453292f)               /* 单位矢量切向 0.5 度 */
#define V5F_EKF_BARO_SIG_M       V5F_BARO_R_M                        /* 0.13 m */
#define V5F_EKF_ZUPT_SIG_MPS     0.05f   /* vel_soft=255 时的速度 1sigma；按 lam 反比缩放 */
#define V5F_EKF_C_N0_REF_DBHZ    33.0f   /* C/N0 加权参考（实测 27.8->28.6 时 UERE 7.46->3.74 m）*/
#define V5F_EKF_POS_PERIOD_S     (1.0f / V5F_GPS_POS_DECIM_HZ)       /* 3.333 s */
#define V5F_MAG_DECL_RAD         (V5F_MAG_DECL_DEG * 0.017453292f)   /* -7.53 度 -> rad */

/* ---- 门阈值（第 8 步用；判据只用外生量）---- */
#define V5F_EKF_SV_MIN           6u
#define V5F_EKF_HDOP_MAX         2.0f
#define V5F_EKF_VDOP_MAX         4.0f
#define V5F_EKF_SNR_MIN_DBHZ     25.0f
#define V5F_EKF_VEL_SPEED_MIN_MPS    0.4f
#define V5F_EKF_ZUPT_SPEED_MAX_MPS   0.5f
/* ★ 不要再用 a_lin 做 ZUPT 判据。a_lin 是旧链加速度牵引环的**在线残差**，而那个环
 * 自己的判据就是 |a_lin|（V5F_ACG_ALIN_ON_MG=40 / OFF_MG=100）—— 实测它卡在自己的
 * 极限环里：静置段 |a_lin| p50 0.0487、max 0.1084 g，正好压在 40~100 mg 之间，
 * ZUPT 门因此只开 52.7%。用它就是把另一个环的病理接手过来。
 * 正确的外生量是 | |a| - 1 |：静止时比力模长恒为 1 g（**与姿态无关**），
 * 只用原始 LSB + 离线常量即可算出，实测静止残差 2.2 mg（运动大两个数量级）。 */
/* 磁力计模长的**基线偏离**门限。绝对模长门（V5F_MAG_ERR_LIM=0.10）对场次间的
 * 硬铁漂移没有免疫力：实测本场次 mag_norm p50=0.9321（漂 6.8%），
 * |mag_norm-1| 的 p50=0.0977 正好压在 0.10 上，门来回抖（开 53.7%）。
 * 外部磁干扰是**局部突变**，场次偏差是常数 —— 与稳健基线比就把两者分开了。 */
#define V5F_EKF_MAG_NORM_DEV     0.10f
#define V5F_EKF_MAG_NORM_ALPHA   0.002f  /* 基线跟踪系数（约 500 周期 ≈ 1.4 s）*/
#define V5F_EKF_MAG_NORM_LO      0.50f   /* 基线初值只在这个区间内才锁（开机时 mag_norm=0）*/
#define V5F_EKF_MAG_NORM_HI      2.00f
#define V5F_EKF_MAG_NORM_REBASE  1000u   /* 基线连续打不开这么多周期（约 3 s）就重新自举 */  /* 基线跟踪系数（约 500 周期 ≈ 1.4 s）*/

/* 水平速度死区系数：T = K * g * sigma_tilt_h（每次 EKF 步都按当前倾角不确定度重算）。
 * 目的是挡掉"倾角误差把重力漏进水平加速度"造成的常值偏置（实测 sigma_tilt 0.63 度
 * -> 0.108 m/s^2；不挡的话速度会以这个速率无界漂）。代价是被吃掉的真实小加速度也
 * 在这一量级 —— 但它是**瞬态**的，而泄漏造成的是**无界增长**，两者不对称。
 * 设 0 即关闭。 */
/* 死区默认**关闭**：实测它是"削掉一切低频"（一段 |a_lin|=0.129、门限 0.038 的
 * 真实运动仍被吃掉 86%），而且门限正比于 sigma_tilt -> 运动让 sigma_tilt 涨 4~5 倍，
 * 死区跟着放大，正好在最需要保留真实运动时最激进。泄漏交给 ba 去吸（见 SIG_BA_RW）。
 * 留成可在线改的标量，需要时可以拿来做 A/B 对照。 */
#define V5F_EKF_VDEAD_K          0.0f
/* ---- 路径 B：速度泄漏积分器（替代死区）----
 * lambda = K * sigma_tilt，即 tau = 1/(K*sigma_tilt)，每次 EKF 步对**水平两轴**做
 *   v *= (1 - lambda*dt_e)
 * 为什么不用死区：死区按幅值砍，实测把一段真实运动吃掉 86%，且门限正比于
 *   sigma_tilt -> 越不确定越激进。泄漏不砍任何单帧信息，只把常值泄漏造成的
 *   无界漂移限成有界（稳态误差 = b*tau）。
 * K=5 时：sigma_tilt 0.2 度 -> tau 57 s（几乎不干预）；5 度 -> tau 2.3 s（限住）。
 * 设 K=0 即关闭。 */
#define V5F_EKF_VLEAK_K          5.0f
#define V5F_EKF_VLEAK_TAU_MAX_S  10000.0f   /* tau 上限（lambda 下限），防姿态极好时不泄漏 */

#define V5F_EKF_ZUPT_AMAG_TOL    0.03f   /* | |a_离线| - 1 | 上限（g）。3% 已比静止残差
                                          * （2.2 mg）宽 13 倍，且真实运动轻松超过它 */
#define V5F_EKF_ZUPT_ALIN2       (0.05f * 0.05f)   /* 已废弃：只留常量以便对照旧记录 */
#define V5F_EKF_ZUPT_EAC_MAX     0.20f   /* ZUPT 追加的**交流能量**上限 dps^2（外生）。
                                          * 为什么必须有：没有 GPS 时 speed 那一路被旁路
                                          * （见下面 M5 的注释），门退化成纯 is_static，
                                          * 而等效原理下匀速平动对陀螺/加计不可见 ——
                                          * 实测走动时 is_static 可以 100% 成立。
                                          * 实测静止 e_ac 0.048~0.057、运动 0.37~84，
                                          * 门限 0.20 的分离度足够。它只能让门更保守。
                                          * ★ 用独立常量，不借 V5F_DET_AC_E_ON：
                                          *   一环一门，改一个不许动另一个。 */
#define V5F_EKF_TILT_AMAG_TOL    0.06f             /* |a|^2 偏离 1，约等于 |a| 偏离 3% */
#define V5F_EKF_TILT_LEV_DPS     2.0f
#define V5F_EKF_BARO_WARMUP_S    5.0f
#define V5F_EKF_BARO_PERIOD_S    0.164f
/* 气压改为**差值观测**（高通）：只负责补两次绝对基准之间的瞬态。
 * 实测等高段 press_avg(W=32) 段内 sigma=0.81~1.57 Pa(7~13 cm)，但段间慢漂 ±4 Pa
 * （60 s 峰-峰 73 cm），而 20 cm 抬高只有 2.4 Pa —— 绝对观测会被慢漂淹掉。
 * 差值窗口 = 尝试次数 N / 6.1 Hz，取 24 -> 约 3.9 s。 */
#define V5F_EKF_BARO_HP_N        24u
#define V5F_EKF_BARO_OLD_VAR_M2  0.09f   /* 老 p_z 估计的方差容差 (0.3 m)^2，算进 R */  /* 气压观测降频 = 1/6.1，设计指定的带宽。
                                          * press_avg 的噪声相关时间就是 165 ms，
                                          * 不降频就是 58 倍冗余，NIS 会失真 */   /* 实测上电 5 s 内气压有暂态：std 2481 Pa vs 5~6 Pa */
#define V5F_EKF_BARO_PA0         101325.0f
#define V5F_EKF_BARO_M_PER_PA    0.08326f  /* dh/dp = 44330*0.190263/101325，线性化 */
#define V5F_EKF_BARO_PA_LO       30000.0f
#define V5F_EKF_BARO_PA_HI       110000.0f
#define V5F_EKF_BARO_STEP_MAX_M  50.0f
#define V5F_EKF_BARO_DT_MAX_C    1.0f    /* 相邻气压样本的温差上限（设计的"温度在窗口内稳定"）。
                                          * BMP388 的 die 温度变化很慢，1 度已经是很宽的限 */
#define V5F_EKF_DOP_TAU_S        5.0f   /* 多普勒直流偏置牵引时间常数 */

/* ---- 内层 chi2 门限（与"外部门"分开：门=物理可用性，chi2=野值剔除）
 *   卡方分布上侧 99.9%：1 维 10.83 / 2 维 13.82 / 3 维 16.27 ---- */
#define V5F_EKF_NIS_MAX_1        10.83f
#define V5F_EKF_NIS_MAX_2        13.82f
#define V5F_EKF_NIS_MAX_3        16.27f

/* ---- chi2 的逃脱阀（没有它，任何一道观测都会被永久锁在门外）----
 * 实测两次死锁：气压 b_baro 差 13.5 m 时 nis 恒 180、磁偏航差 80 度时 nis 恒 1.3e4。
 * 机理：新息 > 3sigma 时 chi2 剔除；而剔除不改 P，S 不会变大，nis 就一直超限。
 * 做法：连续被剔够 ESCAPE 次后，用放大 ESC_R 倍的 R 放行一次（K 与 P 修正同比例
 *   缩小，等于只信这一笔的 1/ESC_R）。它把状态往观测方向软推，新息随之变小，
 *   正常剔除规则随即恢复。既保留了"挡单帧野值"，又不会把整条环关死。 */
/* ---- chi2：软加权，不再硬剔除，也不再需要逃脱阀 ----
 * 硬剔的机理缺陷：剔一次不改 P -> S 不变 -> nis 永远超限 -> 环永久锁死。
 * 实测三次（气压 nis 恒 180 / 偏航差 80 度时 nis 恒 1.3e4 / VER=20 里 nis_baro
 * p50=11.92 而 53.5% 的帧被剔、p_z 漂到 ±287 m）。
 * 现在：nis > 上限时把 Si 缩小 (nis/上限) 倍，等价于 R_eff = R*(nis/上限) ——
 * 极端野值的权重趋 0（仍然挡得住），但永不锁死。 */
#define V5F_EKF_CHI2_SC_MAX      1000.0f  /* 软加权倍率上限（权重不低于 1/1000）*/
/* 以下两个是旧逃脱阀的常量，已无用，留名以防旧记录对不上 */
#define V5F_EKF_CHI2_ESCAPE     8u
#define V5F_EKF_CHI2_ESC_R      9.0f
#define V5F_EKF_NIS_MAX_MAG     100.0f
/* ---- 观测更新的**物理约束**（不是调参）----
 * 实测 VER=35 板子静止时 EKF 单帧跳变 169 度（旧链同帧 0.0000 度），
 * 15 次最严重跳变全部伴随 mag 门开启。机理：坏磁样本（模长仍约 1，模长门抓不住）
 * + 整流项抬高 P[8][8] 使 S 变大 -> 软 chi2 不降权 -> K 约等于 1 -> 整体 snap。
 * 2.87 ms 转 169 度 = 59000 度/s，物理上不可能。 */
#define V5F_EKF_MAG_R_MAX_DEG    150.0f   /* 磁偏航硬新息门：|r| 超它整帧丢弃 */
#define V5F_EKF_MAG_K_MAX        0.05f   /* 磁偏航增益上限 = tau 约 0.057 s 的牵引（按 349 Hz 算）。
 * ★ 分工：**硬门**负责挡无效样本（|r|<=45 度、Bh/|B|>=0.30），
 *   **增益**只负责系统带宽。上一版把它压到 0.002（tau 1.4 s）再叠加 mag 门
 *   只有 53%% 的时间开着，牵引弱到等于没有 —— 用增益去承担系统稳定性是错的。
 *   现在最坏单步也只有 0.05*45 度 = 2.25 度，而正常 r~0.5 度 时每步 0.025 度。 */
/* 磁偏航的**死点门**：|B 的水平分量| / |B| 必须大于它，否则该样本的方位角无定义。
 * 真实地磁在导航系的倾角是 53.74 度 -> Bh/|B| = 0.59 恒成立，所以正常样本有约
 * 2 倍余量；只有当**姿态误差大到约 50 度以上**时（多轴运动中 tilt 门关闭、
 * 倾角靠陀螺积分），估计出来的 B 才会接近竖直 -> Bh -> 0 -> atan2 输出任意值、
 * H 的倾角列放大到无穷 —— 实测单周期跳到 169 度就是这么来的。
 * ★ 原来那个 if (bh2 > 1e-6f) 形同虚设：Bh = 0.001 时条件数已经放大 1000 倍。 */
#define V5F_EKF_MAG_BH_MIN       0.12f  /* 磁偏航增益上限（tau 约 1.4 s 的牵引）*/
/* ★VER=45 向量有效性判据（**机体系**）：
 * fhb = hypot(f_x,f_y)，即磁场与偏航所绕轴(机体 z)的夹角正弦。
 * fhb < 本值 -> 方位角不可用，本帧不修正。实测 fhb p10=0.096。 */
#define V5F_EKF_MAG_BHB_MIN      0.15f
/* ★VER=45 地磁模型误差（单位矢量），用于 R 连续加权：R += (FERR/fhb)^2。 */
#define V5F_EKF_MAG_FERR         0.010f
#define V5F_EKF_TILT_K_MAX       0.010f  /* 重力增益上限（比磁快，它是强观测）*/
/* 磁偏航环的**单周期修正上限**（度）。等价于给地磁牵引一个 τ 下限：
 *   tau_min = dt_e / (STEP*DEG2RAD) = 2.87ms / (0.05*0.01745) = 3.3 s
 * 动机：K = P[8][8]/(HPH'+R)，而 Q_tt 里的整流项在运动中把 P[8][8] 抬高，
 * 使 K 从 0.06 冲到 0.9 -> 磁观测由"轻推"变成"每周期硬拉"，
 * 偏航于是逐样本跟随 IST8310 的 0.5~0.7 度噪声 = 曲线上的自行震动。
 * 限幅后噪声被压平，而真实陀螺零偏漂移（0.01~0.1 dps = 最大 0.1 度/周期）
 * 仍在限幅速率（0.05 度/周期 = 17 度/s）之内，照拉无误。 */
#define V5F_EKF_YAW_STEP_MAX_DEG 1000.0f   /* 暂时置大 = 关闭。
 * 为什么撤：限幅只回滚状态、不回滚协方差 -> P 越来越小 -> K 越大 -> 越容易触发
 * 限幅 -> 每周期都把修正顶到限幅值执行。若修正方向有一点点错，它就变成
 * "每周期以最大速率朝错误方向走"= **恒速漂移**（实测崩溃性漂移）。
 * 限幅把有界误差变成了无界漂移，这是设计错误，不是参数问题。
 * 正确限带宽的方式是**降频**：相关观测不该以 349 Hz 满增益进姿态，
 * 下一版改成对 M6/M7 做抽取。 */
/* 重力/倾斜观测（M6）的**单周期姿态修正上限**（度）。
 * 实测 ekf_q 全程抖（静止也抖）而旧链稳，根因是带宽而非增益大小：
 *   R=(0.5 度)^2 配 349 Hz 满增益更新 -> 闭环带宽约 100 Hz，
 *   加计方向噪声（0.127 度）几乎原样进姿态；旧链 Mahony tau=5 s -> 0.03 Hz。
 * 0.02 度/周期 -> 等效 tau = 2.87ms/(0.02*0.01745) = 8.2 s，与旧链同量级。
 * 加计/磁的方向误差是**相关**的（DC 偏置、安装残差），不是白噪声，
 * 必须先限带宽再进姿态。 */
#define V5F_EKF_TILT_STEP_MAX_DEG 1000.0f   /* 暂时置大 = 关闭。
 * 为什么撤：限幅只回滚状态、不回滚协方差 -> P 越来越小 -> K 越大 -> 越容易触发
 * 限幅 -> 每周期都把修正顶到限幅值执行。若修正方向有一点点错，它就变成
 * "每周期以最大速率朝错误方向走"= **恒速漂移**（实测崩溃性漂移）。
 * 限幅把有界误差变成了无界漂移，这是设计错误，不是参数问题。
 * 正确限带宽的方式是**降频**：相关观测不该以 349 Hz 满增益进姿态，
 * 下一版改成对 M6/M7 做抽取。 */  /* 磁偏航单独放宽：绝对航向，不是野值多发道 */

/* ---- 零偏残差钳位（离线标定常量之上的残差）----
 * ★ bg/ba 没有任何直接观测，只靠与新息的弱相关被间接推；不钳位就能漂到
 *   物理上不可能的值（实测 bg_z = -40.7 dps 且恒定）。而 bg 现在**参与积分**，
 *   漂了就会真去转姿态 —— 这是"偏置状态必须钳位"的实证。 */
#define V5F_EKF_BG_LIM_DPS      10.0f
#define V5F_EKF_BG_LIM_RADS     (V5F_EKF_BG_LIM_DPS * 0.017453292f)
#define V5F_EKF_BA_LIM_MPS2     0.05f   /* 约 5 mg */

/* =====================================================================
 * S1 的范围 = **非 GPS 传感器的全融合**（用户 2026-09-15 定的）
 *
 * 没有 GPS 时 7 道观测里活着的是 4 道：M3 气压 / M5 ZUPT / M6 重力倾斜 / M7 磁偏航；
 * M1/M2/M4 与 ENU 原点自然关闭（gate_bits 的 bit0/1/3/10 恒 0）。这不是降级：
 * 同一个滤波器、同一个状态，只是那三道观测缺席。
 *
 * ★ 这一阶段**能承诺**的（VER=15 实测）：
 *     姿态 q（重力系世界四元数）：偏航误差 p50 0.272 度；380 度累计转动跟踪
 *       误差 0.65%（=1.0065 比值）；静止段 0.13 +- 0.22 度。
 *     合加速度 |a_nav|（标准单位 m/s^2）：静止 0.0143。
 *     相对高度：**只有 p_z + b_baro 这个和**（气压高度）是可观测的。
 * ★ 这一阶段**不能承诺**的：
 *     水平位置/速度在运动段不可用 —— 没有绝对基准，ZUPT 只能把它按在"静止"上。
 *     下游必须看 gate_bits 的 bit10（ENU 原点）与 sigma_pos_h / sigma_vel_h，
 *     不许把 p 当绝对坐标用。
 *     p_z 的**单独**读数没有绝对意义（与 b_baro 不可分，要等 M2/GPS 高度）。
 * ===================================================================== */

/* ---- gate_bits 位定义（上报列 104 的原始值）---- */
#define V5F_EKF_GB_GPS_POS       0x0001u
#define V5F_EKF_GB_GPS_ALT       0x0002u
#define V5F_EKF_GB_BARO          0x0004u
#define V5F_EKF_GB_GPS_VEL       0x0008u
#define V5F_EKF_GB_ZUPT          0x0010u
#define V5F_EKF_GB_TILT          0x0020u
#define V5F_EKF_GB_MAG           0x0040u
#define V5F_EKF_GB_ALIGN         0x0080u   /* 已对齐（一次性，之后恒置） */
#define V5F_EKF_GB_STEP          0x0100u   /* 本周期完成了一次 EKF 步 */
#define V5F_EKF_GB_CHI2          0x0200u   /* 本周期有观测被内层 chi2 剔除 */
#define V5F_EKF_GB_ORIGIN        0x0400u   /* ENU 原点已建立（位置列才有绝对意义） */
#define V5F_EKF_GB_SAT           0x0800u   /* 本周期有加计削顶帧（比力不可信） */
#define V5F_EKF_GB_ALIGN_FORCE   0x1000u   /* 对齐是超时/强制兜底来的 */

#endif /* __V5F_TUNE_H */
