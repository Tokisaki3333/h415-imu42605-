/* ============================================================================
 * proc_ekf.c   第 7 步：16 维导航 EKF（误差状态，影子模式）
 *              第 8 步：EKF 各观测的**外部门控**（下游写、上游下一帧读）
 *
 * ---- 状态 ----
 *   标称 x  = [ p(3,m,ENU) v(3,m/s) q(4,机体->导航) ba(3,m/s^2) bg(3,rad/s) b_baro(1,m) ]
 *   误差 dx = [ dp(3) dv(3) dth(3,导航系) dba(3) dbg(3) db_baro(1) ]   共 16 维
 *   姿态误差用**全局(导航系)**约定：q_true = Exp(dth) (x) q_hat
 *   索引： dp 0..2  dv 3..5  dth 6..8  dba 9..11  dbg 12..14  db_baro 15
 *
 * ---- 导航系 ----
 *   真 ENU（x = 东, y = 北, z = 上），对齐那一帧用**磁力计一次性**把 x 轴定到真东，
 *   于是地磁水平分量的方位恒等于磁偏角 D（已知常数）。此后偏航闭环在**滤波器内部**由
 *   M7 承担 —— 旧 proc_attitude 链仍然不闭环，两者分工不混（见 ekf_design.md 0.1/4.1）。
 *
 * ---- 单位 ----
 *   内部一律 SI + 弧度。只有上报那一步才换成度 / dps（见 ekf_publish）。
 *
 * ---- 自环纪律（本仓库铁律，逐条落实）----
 *   1) 第 8 步（下游）算门，第 7 步（上游）**下一帧**读 —— 与"第 2 步写第 1 步读"同构。
 *   2) 门判据只用**外生量**：原始 LSB、离线标定常量、stat / acc_valid / mag.trust /
 *      GPS 报文质量字段。绝不取滤波器自己的输出（新息、P、sigma）。
 *   3) 新息 chi2（内层）在第 7 步算，与门**分开**记录：gate_bits bit9 = 本周期有观测被剔除。
 *      门回答"物理上能不能用"，chi2 回答"这一帧数值上像不像野值"，两件事不许混。
 *   4) 不用 h->imu.gyro_dps / accel_g（那两个被在线牵引改过，会与 EKF 的零偏状态互相污染），
 *      一律从原始 lsb 出发，只套离线标定常量。
 *
 * ---- 频率与尖峰抑制 ----
 *   每 V5F_EKF_DECIM 帧（16 帧，约 501 Hz）一个 EKF 步。16x16 的 F P F^T 拆成**每帧一行**
 *   摊在这 16 帧里，累积够 16 帧的那一帧正好算完最后一行 -> 随即做观测更新 + 标称推进 +
 *   建新 F。单帧新增约 512 flops 而不是 1.6e4。
 * ========================================================================== */
#include "SPI_rx.h"
#include "v5f_proc.h"

#include <math.h>     /* sqrtf / atan2f / sinf / cosf：-Ofast 下是单条指令，不引入 libm 调用 */
#include <string.h>   /* memset */

/* ---------------- 状态索引 ---------------- */
#define EKF_N        16u
#define IX_P         0u
#define IX_V         3u
#define IX_Q         6u     /* 标称四元数占 4 个 */
#define IX_BA        10u
#define IX_BG        13u
#define IX_BB        16u    /* 标称量第 17 个 */
#define EKF_NX       17u

#define DEG2RAD      0.017453292f
#define RAD2DEG      57.2957795f
#define EKF_PI       3.14159265f
#define EKF_TWOPI    6.28318531f

/* ---------------- 内部状态 ---------------- */
static float    s_x[EKF_NX];          /* 标称状态 */
static float    s_P[EKF_N][EKF_N];    /* 当前协方差（上一个周期更新后的） */
static float    s_Pn[EKF_N][EKF_N];   /* 传播中的协方差（本周期） */
static float    s_F[EKF_N][EKF_N];    /* 状态转移（上个周期建好） */
static float    s_G[EKF_N][EKF_N];    /* 行传播中间量 */

static uint8_t  s_aligned;            /* 1 = 已用重力 + 磁力计对齐 */
static uint8_t  s_origin_ok;          /* 1 = ENU 原点已由首个有效定位建立 */
static uint8_t  s_F_ok;               /* 1 = s_F 已就绪（第一个周期还没有） */
static uint8_t  s_prop_row;           /* 已传播的行数 0..16 */
static uint16_t s_nacc;               /* 本周期已累积帧数 */
static float    s_dt_e;               /* 本周期累计时长 s */
static float    s_dt_prev;            /* 上一个周期总时长 s（Q 用） */
static float    s_t_run;              /* 上电以来累计时长 s（气压计预热用） */
static float    s_dth[3], s_dvb[3];   /* 预积分：角度增量 rad、速度增量 m/s（机体系） */
static float    s_Rn[3][3];           /* R(q_hat)：机体 -> 导航 */
static float    s_Rf[3][3];           /* [R(f-ba)]x 的叉乘阵 */
static float    s_a_nav[3];           /* 最近一次步进算出的导航系线性加速度 m/s^2 */

static uint64_t s_last_tick;

/* ENU 原点：首个有效定位那一帧建立，位置/速度同时清零 */
static int32_t  s_lat0_e7, s_lon0_e7;
static float    s_m_per_deg_lat, s_m_per_deg_lon;

/* 多普勒直流偏置（一阶牵引，不做状态；门 = 上一帧的 ekf_zupt） */
static float    s_b_dop;

/* 气压高度：线性化 h = (p0 - p) * k。绝对基准由 b_baro 吸收，只需相对变化准确 */
static float    s_baro_h;             /* 本帧气压高度 m（新样本才更新） */
static float    s_baro_h_last;        /* 上一个样本的高度（做 |dh| 跳变门） */
static uint8_t  s_baro_new;           /* 本帧有新的气压样本 */
static uint8_t  s_baro_seen;          /* 见过至少一个样本 */

/* 位置观测降频 / 新样本标志（第 8 步置，第 7 步下一帧读并清） */
static float    s_pos_wait;
static uint8_t  s_gps_new;

/* 发布量 */
static uint16_t s_gate_bits;
static float    s_nis[5];             /* 位置 / 速度 / 气压 / 重力 / 磁偏航 */
static float    s_sig[3];             /* 偏航(度) / 水平位置(m) / 水平速度(m/s) */

/* ---------------------------------------------------------------------------
 * 小工具
 * ------------------------------------------------------------------------- */
static float wrap_pi(float a)
{
    while (a >  EKF_PI) a -= EKF_TWOPI;
    while (a < -EKF_PI) a += EKF_TWOPI;
    return a;
}

/* 四元数：o = a (x) b（Hamilton），q = {w,x,y,z} */
static void q_mul(const float *a, const float *b, float *o)
{
    float w = a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3];
    float x = a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2];
    float y = a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1];
    float z = a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0];
    o[0] = w; o[1] = x; o[2] = y; o[3] = z;
}

static void q_norm(float *q)
{
    float s, n2 = q[0]*q[0] + q[1]*q[1] + q[2]*q[2] + q[3]*q[3];
    if (n2 < 1e-12f) { q[0] = 1.0f; q[1] = q[2] = q[3] = 0.0f; return; }
    s = 1.0f / sqrtf(n2);
    q[0] *= s; q[1] *= s; q[2] *= s; q[3] *= s;
}

/* R(q)：机体 -> 导航 */
static void q_to_R(const float *q, float R[3][3])
{
    float w = q[0], x = q[1], y = q[2], z = q[3];
    R[0][0] = 1.0f - 2.0f*(y*y + z*z);
    R[0][1] = 2.0f*(x*y - w*z);
    R[0][2] = 2.0f*(x*z + w*y);
    R[1][0] = 2.0f*(x*y + w*z);
    R[1][1] = 1.0f - 2.0f*(x*x + z*z);
    R[1][2] = 2.0f*(y*z - w*x);
    R[2][0] = 2.0f*(x*z - w*y);
    R[2][1] = 2.0f*(y*z + w*x);
    R[2][2] = 1.0f - 2.0f*(x*x + y*y);
}

/* o = R v（机体 -> 导航） */
static void rot_bn(const float R[3][3], const float *v, float *o)
{
    float a = R[0][0]*v[0] + R[0][1]*v[1] + R[0][2]*v[2];
    float b = R[1][0]*v[0] + R[1][1]*v[1] + R[1][2]*v[2];
    float c = R[2][0]*v[0] + R[2][1]*v[1] + R[2][2]*v[2];
    o[0] = a; o[1] = b; o[2] = c;
}

/* o = R^T v（导航 -> 机体） */
static void rot_nb(const float R[3][3], const float *v, float *o)
{
    float a = R[0][0]*v[0] + R[1][0]*v[1] + R[2][0]*v[2];
    float b = R[0][1]*v[0] + R[1][1]*v[1] + R[2][1]*v[2];
    float c = R[0][2]*v[0] + R[1][2]*v[1] + R[2][2]*v[2];
    o[0] = a; o[1] = b; o[2] = c;
}

/* 原始 LSB -> 比力 m/s^2（只用离线常量：减零偏、除标度、乘本地重力） */
static void raw_f_mps2(const volatile v5f_hold_t *h, float *f)
{
    static const float b0[3] = { V5F_ACCEL_BIAS_LSB_X, V5F_ACCEL_BIAS_LSB_Y, V5F_ACCEL_BIAS_LSB_Z };
    uint32_t i;
    for (i = 0u; i < 3u; i++) {
        f[i] = ((float)h->imu.accel_lsb[i] - b0[i]) / g_v5f_accel_lsb_per_g[i] * V5F_EKF_G_MPS2;
    }
}

/* 原始 LSB -> 角速度 rad/s（只用离线常量） */
static void raw_w_rads(const volatile v5f_hold_t *h, float *w)
{
    static const float g0[3] = { V5F_GYRO_BIAS_LSB_X, V5F_GYRO_BIAS_LSB_Y, V5F_GYRO_BIAS_LSB_Z };
    uint32_t i;
    for (i = 0u; i < 3u; i++) {
        w[i] = ((float)h->imu.gyro_lsb[i] - g0[i]) / g_v5f_gyro_lsb_per_dps[i] * DEG2RAD;
    }
}

/* ---------------------------------------------------------------------------
 * 误差注入：dx -> 标称状态。q <- Exp(dth) (x) q（全局误差约定，一阶半角）
 * ------------------------------------------------------------------------- */
static void ekf_inject(const float *dx)
{
    float dq[4], t[4];
    uint32_t i;

    if (s_origin_ok) {
        for (i = 0u; i < 3u; i++) s_x[IX_P + i] += dx[IX_P + i];
    }
    for (i = 0u; i < 3u; i++) s_x[IX_V  + i] += dx[IX_V  + i];
    for (i = 0u; i < 3u; i++) s_x[IX_BA + i] += dx[IX_BA + i];
    for (i = 0u; i < 3u; i++) s_x[IX_BG + i] += dx[IX_BG + i];
    s_x[IX_BB] += dx[15];

    dq[0] = 1.0f;
    dq[1] = 0.5f * dx[6];
    dq[2] = 0.5f * dx[7];
    dq[3] = 0.5f * dx[8];
    q_norm(dq);
    q_mul(dq, &s_x[IX_Q], t);
    for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = t[i];
    q_norm(&s_x[IX_Q]);
}

/* ---------------------------------------------------------------------------
 * 通用观测更新（m = 1/2/3）
 *   H 为 m x 16（密集，调用方只把用到的列置好），R 为 m x m
 *   P 用标准形式 P <- P - K S K^T（周期末统一对称化 + 对角下限）
 *   返回：0 = 已更新；1 = 内层 chi2 剔除；2 = 数值失败（不更新）
 * ------------------------------------------------------------------------- */
static uint8_t ekf_update(const float H[3][EKF_N], const float *R, uint8_t m,
                          const float *r, float nis_max, float *nis_out)
{
    float S[3][3], Si[3][3], PHt[EKF_N][3], K[EKF_N][3], KS[EKF_N][3], dx[EKF_N];
    float det, nis = 0.0f, s;
    uint32_t i, j, k;

    /* PHt = P H^T  (16 x m) */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < EKF_N; k++) s += s_Pn[i][k] * H[j][k];
            PHt[i][j] = s;
        }
    }
    /* S = H PHt + R */
    for (i = 0u; i < m; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < EKF_N; k++) s += H[i][k] * PHt[k][j];
            S[i][j] = s + R[i*m + j];
        }
    }
    /* 求逆（m <= 3，伴随矩阵） */
    if (m == 1u) {
        if (S[0][0] < 1e-12f) return 2u;
        Si[0][0] = 1.0f / S[0][0];
    } else if (m == 2u) {
        det = S[0][0]*S[1][1] - S[0][1]*S[1][0];
        if (det < 1e-18f) return 2u;
        Si[0][0] =  S[1][1]/det; Si[0][1] = -S[0][1]/det;
        Si[1][0] = -S[1][0]/det; Si[1][1] =  S[0][0]/det;
    } else {
        det = S[0][0]*(S[1][1]*S[2][2] - S[1][2]*S[2][1])
            - S[0][1]*(S[1][0]*S[2][2] - S[1][2]*S[2][0])
            + S[0][2]*(S[1][0]*S[2][1] - S[1][1]*S[2][0]);
        if (det < 1e-18f) return 2u;
        Si[0][0] = (S[1][1]*S[2][2] - S[1][2]*S[2][1])/det;
        Si[0][1] = (S[0][2]*S[2][1] - S[0][1]*S[2][2])/det;
        Si[0][2] = (S[0][1]*S[1][2] - S[0][2]*S[1][1])/det;
        Si[1][0] = (S[1][2]*S[2][0] - S[1][0]*S[2][2])/det;
        Si[1][1] = (S[0][0]*S[2][2] - S[0][2]*S[2][0])/det;
        Si[1][2] = (S[0][2]*S[1][0] - S[0][0]*S[1][2])/det;
        Si[2][0] = (S[1][0]*S[2][1] - S[1][1]*S[2][0])/det;
        Si[2][1] = (S[0][1]*S[2][0] - S[0][0]*S[2][1])/det;
        Si[2][2] = (S[0][0]*S[1][1] - S[0][1]*S[1][0])/det;
    }
    /* NIS = r^T Si r */
    for (i = 0u; i < m; i++) {
        s = 0.0f;
        for (j = 0u; j < m; j++) s += Si[i][j] * r[j];
        nis += r[i] * s;
    }
    if (nis_out) *nis_out = nis;
    if (nis > nis_max) return 1u;                 /* 内层 chi2：野值，不更新 */

    /* K = PHt Si  (16 x m) */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += PHt[i][k] * Si[k][j];
            K[i][j] = s;
        }
    }
    /* dx = K r */
    for (i = 0u; i < EKF_N; i++) {
        s = 0.0f;
        for (k = 0u; k < m; k++) s += K[i][k] * r[k];
        dx[i] = s;
    }
    /* P <- P - K S K^T：先 KS = K S (16 x m) */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += K[i][k] * S[k][j];
            KS[i][j] = s;
        }
    }
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += KS[i][k] * K[j][k];
            s_Pn[i][j] -= s;
        }
    }
    ekf_inject(dx);
    return 0u;
}

/* 把 H 的 m 行清零 */
static void H_zero(float H[3][EKF_N], uint8_t m)
{
    uint32_t i, j;
    for (i = 0u; i < m; i++) {
        for (j = 0u; j < EKF_N; j++) H[i][j] = 0.0f;
    }
}

/* ---------------------------------------------------------------------------
 * 周期末：观测更新（门取上一帧第 8 步写下的结果）
 * ------------------------------------------------------------------------- */
static void ekf_measure(const volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float H[3][EKF_N], R[9], r[3], f[3];
    uint8_t st;
    uint32_t i;

    /* ---- M6 重力/倾斜（3 维，秩 2） ---- */
    if (V5F_EKF_TILT_EN && gate->ekf_tilt && h->imu.acc_valid) {
        float Rt[3][3], pr[3], e2;
        q_to_R(&s_x[IX_Q], Rt);
        raw_f_mps2(h, f);
        e2 = sqrtf(f[0]*f[0] + f[1]*f[1] + f[2]*f[2]);
        if (e2 > 1e-6f) {
            float fb[3], up[3], ex[3], tang, M[3][3], Sx[3][3];
            fb[0] = f[0]/e2; fb[1] = f[1]/e2; fb[2] = f[2]/e2;
            up[0] = 0.0f; up[1] = 0.0f; up[2] = 1.0f;
            rot_nb(Rt, up, pr);                        /* 预测：静止时"上"在机体系的表示 */
            /* 切平面投影：r = (I - pr pr^T)(fb - pr)。径向分量对倾角没有信息，
             * 不投影就等于把"比力模长残差"当成倾角误差灌进滤波器。 */
            ex[0] = fb[0] - pr[0]; ex[1] = fb[1] - pr[1]; ex[2] = fb[2] - pr[2];
            tang = ex[0]*pr[0] + ex[1]*pr[1] + ex[2]*pr[2];
            for (i = 0u; i < 3u; i++) r[i] = ex[i] - tang*pr[i];
            /* H = (I - pr pr^T) R^T [up]x ；d(pred)/d(dth) = R^T [up]x */
            Sx[0][0] = 0.0f;    Sx[0][1] = -up[2]; Sx[0][2] =  up[1];
            Sx[1][0] = up[2];   Sx[1][1] = 0.0f;   Sx[1][2] = -up[0];
            Sx[2][0] = -up[1];  Sx[2][1] = up[0];  Sx[2][2] = 0.0f;
            {
                uint32_t j, k;
                for (i = 0u; i < 3u; i++) {
                    for (j = 0u; j < 3u; j++) {
                        float s2 = 0.0f;
                        for (k = 0u; k < 3u; k++) s2 += Rt[k][i] * Sx[k][j];
                        M[i][j] = s2;
                    }
                }
                H_zero(H, 3u);
                for (i = 0u; i < 3u; i++) {
                    for (j = 0u; j < 3u; j++) {
                        H[i][6u + j] = M[i][j]
                            - pr[i]*(pr[0]*M[0][j] + pr[1]*M[1][j] + pr[2]*M[2][j]);
                    }
                }
            }
            for (i = 0u; i < 9u; i++) R[i] = 0.0f;
            R[0] = R[4] = R[8] = V5F_EKF_TILT_SIG_RAD * V5F_EKF_TILT_SIG_RAD;
            st = ekf_update((const float (*)[EKF_N])H, R, 3u, r,
                            V5F_EKF_NIS_MAX_3, &s_nis[3]);
            if      (st == 0u) s_gate_bits |= V5F_EKF_GB_TILT;
            else if (st == 1u) s_gate_bits |= V5F_EKF_GB_CHI2;
        }
    }

    /* ---- M7 磁偏航（1 维，只挂第 8 项） ---- */
    if (V5F_EKF_YAW_OBS_EN && gate->ekf_mag_yaw) {
        float Rt[3][3], Bn[3], mf[3], hh, rr;
        for (i = 0u; i < 3u; i++) mf[i] = h->mag.f[i];
        q_to_R(&s_x[IX_Q], Rt);
        rot_bn(Rt, mf, Bn);                    /* B = R(q) f -> 导航系地磁方向 */
        hh = atan2f(Bn[0], Bn[1]);             /* 地磁水平分量方位（东/北），应恒等于 D */
        rr = wrap_pi(V5F_MAG_DECL_RAD - hh);
        H_zero(H, 1u);
        H[0][8] = -1.0f;                       /* dh/d(dth_z) = -1（弧度/弧度） */
        R[0] = V5F_EKF_MAG_SIG_RAD * V5F_EKF_MAG_SIG_RAD;
        r[0] = rr;
        st = ekf_update((const float (*)[EKF_N])H, R, 1u, r,
                        V5F_EKF_NIS_MAX_1, &s_nis[4]);
        if      (st == 0u) s_gate_bits |= V5F_EKF_GB_MAG;
        else if (st == 1u) s_gate_bits |= V5F_EKF_GB_CHI2;
    }

    /* ---- M5 软 ZUPT（3 维） ---- */
    if (gate->ekf_zupt) {
        float lam = (float)gate->vel_soft * (1.0f/255.0f);
        float sg;
        if (lam < 0.05f) lam = 0.05f;
        sg = V5F_EKF_ZUPT_SIG_MPS / lam;
        H_zero(H, 3u);
        H[0][3] = 1.0f; H[1][4] = 1.0f; H[2][5] = 1.0f;
        for (i = 0u; i < 9u; i++) R[i] = 0.0f;
        R[0] = R[4] = R[8] = sg * sg;
        for (i = 0u; i < 3u; i++) r[i] = -s_x[IX_V + i];
        st = ekf_update((const float (*)[EKF_N])H, R, 3u, r, V5F_EKF_NIS_MAX_3, &s_nis[1]);
        if (st == 0u) s_gate_bits |= V5F_EKF_GB_ZUPT;
    }

    /* ---- M3 气压高度（1 维，同时观测 p_z 与 b_baro） ---- */
    if (gate->ekf_baro && s_baro_new) {
        H_zero(H, 1u);
        H[0][2]  = 1.0f;                       /* d/dp_z */
        H[0][15] = 1.0f;                       /* d/db_baro（气压高度 = p_z + b_baro） */
        R[0] = V5F_EKF_BARO_SIG_M * V5F_EKF_BARO_SIG_M;
        r[0] = s_baro_h - (s_x[IX_P + 2] + s_x[IX_BB]);
        st = ekf_update((const float (*)[EKF_N])H, R, 1u, r, V5F_EKF_NIS_MAX_1, &s_nis[2]);
        if (st == 0u) s_gate_bits |= V5F_EKF_GB_BARO;
    }

    /* ---- M1 GPS 水平位置（2 维，按 V5F_EKF_POS_PERIOD_S 降频） ---- */
    if (gate->ekf_gps_pos && s_origin_ok && s_gps_new && s_pos_wait >= V5F_EKF_POS_PERIOD_S) {
        float rb[2], rw;
        int32_t dla = h->gps_rmc.lat_e7 - s_lat0_e7;
        int32_t dlo = h->gps_rmc.lon_e7 - s_lon0_e7;
        rb[0] = (float)dlo * 1e-7f * s_m_per_deg_lon;      /* 东 */
        rb[1] = (float)dla * 1e-7f * s_m_per_deg_lat;      /* 北 */
        H_zero(H, 2u);
        H[0][0] = 1.0f; H[1][1] = 1.0f;
        rw = 1.0f;
        if (h->gps_gsv.snr_n > 0u && h->gps_gsv.snr_avg_dbhz > 1.0f) {
            float ratio = V5F_EKF_C_N0_REF_DBHZ / h->gps_gsv.snr_avg_dbhz;
            rw = ratio * ratio;
            if (rw < 1.0f) rw = 1.0f;
            if (rw > 9.0f) rw = 9.0f;
        }
        R[0] = V5F_GPS_POS_R_H_M * V5F_GPS_POS_R_H_M * rw;
        R[1] = 0.0f; R[2] = 0.0f; R[3] = R[0];
        r[0] = rb[0] - s_x[IX_P + 0u];
        r[1] = rb[1] - s_x[IX_P + 1u];
        st = ekf_update((const float (*)[EKF_N])H, R, 2u, r, V5F_EKF_NIS_MAX_2, &s_nis[0]);
        if (st == 0u) { s_gate_bits |= V5F_EKF_GB_GPS_POS; s_pos_wait = 0.0f; }
    }

    /* ---- M2 GPS 高度（1 维，只为把 b_baro 与 p_z 分开） ---- */
    if (gate->ekf_gps_alt && s_gps_new) {
        H_zero(H, 1u);
        H[0][2] = 1.0f;
        R[0] = V5F_GPS_ALT_R_M * V5F_GPS_ALT_R_M;
        r[0] = h->gps_gga.alt_m - s_x[IX_P + 2];
        st = ekf_update((const float (*)[EKF_N])H, R, 1u, r, V5F_EKF_NIS_MAX_1, NULL);
        if (st == 0u) s_gate_bits |= V5F_EKF_GB_GPS_ALT;
    }

    /* ---- M4 GPS 多普勒速度（2 维：speed 与 course 同源，不许拆成两个观测） ---- */
    if (gate->ekf_gps_vel && s_gps_new) {
        float cr = h->gps_rmc.course_deg * DEG2RAD;
        float sp = h->gps_rmc.speed_mps;
        H_zero(H, 2u);
        H[0][3] = 1.0f; H[1][4] = 1.0f;
        R[0] = V5F_GPS_VEL_R_MPS * V5F_GPS_VEL_R_MPS;
        R[1] = 0.0f; R[2] = 0.0f; R[3] = R[0];
        r[0] = sp * sinf(cr) - s_b_dop - s_x[IX_V + 0u];
        r[1] = sp * cosf(cr) - s_b_dop - s_x[IX_V + 1u];
        st = ekf_update((const float (*)[EKF_N])H, R, 2u, r, V5F_EKF_NIS_MAX_2, &s_nis[1]);
        if (st == 0u) s_gate_bits |= V5F_EKF_GB_GPS_VEL;
    }
}

/* ---------------------------------------------------------------------------
 * 周期末：标称推进 + 建 F
 * ------------------------------------------------------------------------- */
static void ekf_step_nominal(void)
{
    float R[3][3], dvn[3], an[3], dv[3], t;
    float dq[4], qn[4];
    uint32_t i, j;

    q_to_R(&s_x[IX_Q], R);

    /* 机体系速度增量里先去掉加计零偏残差，再转到导航系 */
    for (i = 0u; i < 3u; i++) dv[i] = s_dvb[i] - s_x[IX_BA + i] * s_dt_e;
    rot_bn(R, dv, dvn);
    for (i = 0u; i < 3u; i++) {
        dv[i] = dvn[i] + ((i == 2u) ? (-V5F_EKF_G_MPS2 * s_dt_e) : 0.0f);
    }
    for (i = 0u; i < 3u; i++) an[i] = dv[i] / s_dt_e;
    if (s_origin_ok) {
        for (i = 0u; i < 3u; i++) {
            s_x[IX_P + i] += s_x[IX_V + i] * s_dt_e + 0.5f * an[i] * s_dt_e * s_dt_e;
        }
    }
    for (i = 0u; i < 3u; i++) s_x[IX_V + i] += dv[i];
    for (i = 0u; i < 3u; i++) s_a_nav[i] = an[i];      /* 上报用 */

    /* 姿态：q <- q (x) Exp(dth)。dth 是**机体**系增量 -> 右乘。 */
    dq[0] = 1.0f; dq[1] = 0.5f*s_dth[0]; dq[2] = 0.5f*s_dth[1]; dq[3] = 0.5f*s_dth[2];
    q_norm(dq);
    q_mul(&s_x[IX_Q], dq, qn);
    for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = qn[i];
    q_norm(&s_x[IX_Q]);

    /* ---- 建 F = I + A dt ---- */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) s_F[i][j] = 0.0f;
        s_F[i][i] = 1.0f;
    }
    for (i = 0u; i < 3u; i++) s_F[IX_P + i][IX_V + i] = s_dt_e;   /* dp' = dv */

    q_to_R(&s_x[IX_Q], R);
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) s_Rn[i][j] = R[i][j];
    }
    {
        float fb[3], fnv[3];
        for (i = 0u; i < 3u; i++) fb[i] = s_dvb[i]/s_dt_e - s_x[IX_BA + i];
        rot_bn(R, fb, fnv);                       /* [R(f-ba)]x 用的矢量 */
        s_Rf[0][0] = 0.0f;    s_Rf[0][1] = -fnv[2]; s_Rf[0][2] =  fnv[1];
        s_Rf[1][0] = fnv[2];  s_Rf[1][1] = 0.0f;    s_Rf[1][2] = -fnv[0];
        s_Rf[2][0] = -fnv[1]; s_Rf[2][1] = fnv[0];  s_Rf[2][2] = 0.0f;
    }
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) {
            s_F[IX_V + i][IX_Q  + j] = -s_Rf[i][j] * s_dt_e;
            s_F[IX_V + i][IX_BA + j] = -s_Rn[i][j] * s_dt_e;
            s_F[IX_Q + i][IX_BG + j] = -s_Rn[i][j] * s_dt_e;
        }
    }
    s_dt_prev = s_dt_e;
    s_F_ok = 1u;
    (void)t;
}

/* ---------------------------------------------------------------------------
 * 每帧：协方差传播的第 s_prop_row 行（用上个周期建好的 F 与本周期时长）
 * ------------------------------------------------------------------------- */
static void ekf_prop_row(void)
{
    uint32_t j, k, row = s_prop_row;
    float sa2, sg2, qd, dtq = s_dt_prev;

    for (j = 0u; j < EKF_N; j++) {
        float s = 0.0f;
        for (k = 0u; k < EKF_N; k++) s += s_F[row][k] * s_P[k][j];
        s_G[row][j] = s;
    }
    sa2 = V5F_EKF_SIG_A_MPS2 * V5F_EKF_SIG_A_MPS2;
    sg2 = V5F_EKF_SIG_G_RADS  * V5F_EKF_SIG_G_RADS;
    for (j = 0u; j < EKF_N; j++) {
        float s = 0.0f;
        for (k = 0u; k < EKF_N; k++) s += s_G[row][k] * s_F[j][k];
        if (j == row) {
            qd = V5F_EKF_Q_FLOOR;
            if      (row >= 3u  && row <= 5u)  qd += sa2 * dtq;
            else if (row >= 6u  && row <= 8u)  qd += sg2 * dtq;
            else if (row >= 9u  && row <= 11u) qd += V5F_EKF_SIG_BA_RW * V5F_EKF_SIG_BA_RW * dtq;
            else if (row >= 12u && row <= 14u) qd += V5F_EKF_SIG_BG_RW * V5F_EKF_SIG_BG_RW * dtq;
            else if (row == 15u)               qd += V5F_EKF_SIG_BARO_RW * V5F_EKF_SIG_BARO_RW * dtq;
            s += qd;
        }
        s_Pn[row][j] = s;
    }
    s_prop_row++;
}

/* ---------------------------------------------------------------------------
 * 周期末：对称化 + 对角下限 + 派生 1sigma
 * ------------------------------------------------------------------------- */
static void ekf_finalize(void)
{
    uint32_t i, j;
    for (i = 0u; i < EKF_N; i++) {
        for (j = i; j < EKF_N; j++) {
            float a = 0.5f * (s_Pn[i][j] + s_Pn[j][i]);
            if (i == j && a < V5F_EKF_P_FLOOR) a = V5F_EKF_P_FLOOR;
            s_Pn[i][j] = a;
            s_Pn[j][i] = a;
        }
    }
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) s_P[i][j] = s_Pn[i][j];
    }
    s_sig[0] = sqrtf(s_Pn[8][8]) * RAD2DEG;              /* 偏航 1sigma，度 */
    s_sig[1] = sqrtf(s_Pn[0][0] + s_Pn[1][1]);           /* 水平位置 1sigma，m */
    s_sig[2] = sqrtf(s_Pn[3][3] + s_Pn[4][4]);           /* 水平速度 1sigma，m/s */
}

/* ---------------------------------------------------------------------------
 * 发布到保持器（上报用）
 * ------------------------------------------------------------------------- */
static void ekf_publish(volatile v5f_hold_t *h)
{
    uint32_t i;
    for (i = 0u; i < 3u; i++) h->ekf.p[i] = s_x[IX_P + i];
    for (i = 0u; i < 3u; i++) h->ekf.v[i] = s_x[IX_V + i];
    for (i = 0u; i < 4u; i++) h->ekf.q[i] = s_x[IX_Q + i];
    for (i = 0u; i < 3u; i++) h->ekf.ba[i] = s_x[IX_BA + i];
    for (i = 0u; i < 3u; i++) h->ekf.bg[i] = s_x[IX_BG + i] * RAD2DEG;   /* rad/s -> dps */
    h->ekf.b_baro = s_x[IX_BB];
    for (i = 0u; i < 3u; i++) h->ekf.a_nav[i] = s_a_nav[i];
    h->ekf.gate_bits     = s_gate_bits;
    h->ekf.sigma_yaw_deg = s_sig[0];
    h->ekf.sigma_pos_h   = s_sig[1];
    h->ekf.sigma_vel_h   = s_sig[2];
    for (i = 0u; i < 5u; i++) h->ekf.nis[i] = s_nis[i];
    h->ekf.aligned  = s_aligned;
    h->ekf.valid    = s_aligned;
    h->ekf.origin_ok = s_origin_ok;
}

/* ===========================================================================
 * 第 7 步：EKF 本体（上游读门）
 * ========================================================================= */
uint8_t v5f_proc_ekf(volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float dt, w[3], f[3];
    uint64_t tk;
    uint32_t i, j;

    if (!V5F_EKF_EN) return V5F_PROC_OK;

    tk = h->imu.fresh.drdy_tick;
    if (tk == 0ULL) return V5F_PROC_OK;
    if (s_last_tick == 0ULL) { s_last_tick = tk; return V5F_PROC_OK; }
    if (tk <= s_last_tick) { s_last_tick = tk; return V5F_PROC_OK; }
    dt = (float)(tk - s_last_tick) * 1e-8f;
    s_last_tick = tk;
    if (dt <= 0.0f || dt > V5F_EKF_DT_MAX_S) return V5F_PROC_OK;   /* 时间戳异常：本帧不参与 */

    s_t_run += dt;

    /* ---------------- 一次性对齐 ---------------- */
    if (!s_aligned) {
        float am = h->imu.accel_g[0]*h->imu.accel_g[0]
                 + h->imu.accel_g[1]*h->imu.accel_g[1]
                 + h->imu.accel_g[2]*h->imu.accel_g[2];
        if (h->imu.acc_valid && h->stat.valid && h->stat.is_static
            && h->att.up_ref_ok && h->mag.trust
            && fabsf(am - 1.0f) < V5F_EKF_ALIGN_AMAG_TOL) {
            float Ri[3][3], mf[3], Bn[3], azi, dpsi, hq[4], qz[4];
            for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = h->att.q[i];
            q_norm(&s_x[IX_Q]);
            /* 偏航：把小 q 的导航系绕 z 转 dpsi，使 R(q) f 的水平方位 == D。
             * 这是**唯一**一次用磁力计定朝向（此后由 M7 持续闭环）。 */
            q_to_R(&s_x[IX_Q], Ri);
            for (i = 0u; i < 3u; i++) mf[i] = h->mag.f[i];
            rot_bn(Ri, mf, Bn);
            azi  = atan2f(Bn[0], Bn[1]);
            dpsi = wrap_pi(V5F_MAG_DECL_RAD - azi);
            hq[0] = cosf(0.5f*dpsi); hq[1] = 0.0f; hq[2] = 0.0f; hq[3] = sinf(0.5f*dpsi);
            q_mul(hq, &s_x[IX_Q], qz);          /* q <- Exp(dpsi z) (x) q */
            for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = qz[i];
            q_norm(&s_x[IX_Q]);

            for (i = 0u; i < 3u; i++) s_x[IX_P  + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_V  + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_BA + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_BG + i] = 0.0f;
            s_x[IX_BB] = s_baro_seen ? s_baro_h : 0.0f;

            for (i = 0u; i < EKF_N; i++) {
                for (j = 0u; j < EKF_N; j++) s_P[i][j] = 0.0f;
            }
            s_P[0][0] = s_P[1][1] = s_P[2][2] = V5F_EKF_P0_POS_M * V5F_EKF_P0_POS_M;
            s_P[3][3] = s_P[4][4] = s_P[5][5] = V5F_EKF_P0_VEL_MPS * V5F_EKF_P0_VEL_MPS;
            s_P[6][6] = s_P[7][7] = V5F_EKF_P0_TILT_RAD * V5F_EKF_P0_TILT_RAD;
            s_P[8][8] = V5F_EKF_P0_YAW_RAD * V5F_EKF_P0_YAW_RAD;
            s_P[9][9] = s_P[10][10] = s_P[11][11] = V5F_EKF_P0_BA_MPS2 * V5F_EKF_P0_BA_MPS2;
            s_P[12][12] = s_P[13][13] = s_P[14][14] = V5F_EKF_P0_BG_RADS * V5F_EKF_P0_BG_RADS;
            s_P[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;

            for (i = 0u; i < 3u; i++) { s_dth[i] = 0.0f; s_dvb[i] = 0.0f; }
            s_dt_e = 0.0f; s_dt_prev = 0.0f;
            s_prop_row = 0u; s_nacc = 0u; s_F_ok = 0u;
            for (i = 0u; i < 5u; i++) s_nis[i] = 0.0f;
            s_sig[0] = V5F_EKF_P0_YAW_RAD * RAD2DEG;
            s_sig[1] = V5F_EKF_P0_POS_M;
            s_sig[2] = V5F_EKF_P0_VEL_MPS;
            s_a_nav[0] = s_a_nav[1] = s_a_nav[2] = 0.0f;
            s_aligned = 1u;
            s_gate_bits |= V5F_EKF_GB_ALIGN;
            ekf_publish(h);
            return V5F_PROC_OK;
        }
        return V5F_PROC_OK;
    }

    /* ---------------- 预积分（每帧） ---------------- */
    raw_w_rads(h, w);
    raw_f_mps2(h, f);
    for (i = 0u; i < 3u; i++) {
        s_dth[i] += w[i] * dt;
        s_dvb[i] += f[i] * dt;
    }
    s_dt_e += dt;
    s_nacc++;

    /* 协方差：本帧传播一行（用上个周期建好的 F） */
    if (s_F_ok && s_prop_row < EKF_N) ekf_prop_row();

    /* ---------------- 周期边界 ---------------- */
    if (s_nacc >= V5F_EKF_DECIM) {
        if (s_F_ok && s_prop_row >= EKF_N) {
            s_gate_bits = 0u;                 /* 本周期实际进来的观测 */
            ekf_measure(h, gate);             /* 先更新（门取上一帧写下的） */
            ekf_finalize();
        }
        if (s_dt_e > 1e-6f) {
            ekf_step_nominal();               /* 再推进标称状态 + 建新 F */
        } else {
            s_F_ok = 0u;
        }
        s_gate_bits |= V5F_EKF_GB_STEP;
        if (s_aligned)   s_gate_bits |= V5F_EKF_GB_ALIGN;
        if (s_origin_ok) s_gate_bits |= V5F_EKF_GB_ORIGIN;
        for (i = 0u; i < 3u; i++) { s_dth[i] = 0.0f; s_dvb[i] = 0.0f; }
        s_dt_e = 0.0f;
        s_nacc = 0u;
        s_prop_row = 0u;
        ekf_publish(h);
    }

    /* ---------------- 每帧收尾 ---------------- */
    s_pos_wait += dt;
    /* 多普勒直流偏置一阶牵引：门 = 上一帧的 ZUPT 门（外生），与陀螺零偏牵引同构 */
    if (gate->ekf_zupt && h->gps_rmc.status == (uint8_t)'A') {
        float a = dt / V5F_EKF_DOP_TAU_S;
        s_b_dop += (h->gps_rmc.speed_mps - s_b_dop) * a;
    }
    /* 第 8 步在本帧稍后写入，这里清 0 => 它们只被下一帧的第 7 步消费一次 */
    s_gps_new  = 0u;
    s_baro_new = 0u;

    return V5F_PROC_OK;
}

/* ===========================================================================
 * 第 8 步：EKF 各观测的**外部门控**（下游写、上游下一帧读）
 *   判据只用外生量；新息 chi2 留给第 7 步（内层），两者分开记录。
 * ========================================================================= */
uint8_t v5f_proc_ekf_gate(volatile v5f_hold_t *h, volatile v5f_proc_gate_t *gate)
{
    static uint32_t s_gga_cnt_last, s_rmc_cnt_last, s_bmp_cnt_last;
    static uint8_t  s_started;
    uint32_t gga_cnt, rmc_cnt, bmp_cnt;
    uint8_t  gq_ok, gn_ok, snr_ok, vd_ok;
    float    spac, am2;

    if (!V5F_EKF_EN) return V5F_PROC_OK;

    gga_cnt = g_shm ? g_shm->gps_gga.hdr.cnt : 0u;
    rmc_cnt = g_shm ? g_shm->gps_rmc.hdr.cnt : 0u;
    bmp_cnt = g_shm ? g_shm->bmp.hdr.cnt     : 0u;
    if (!s_started) {
        s_started = 1u;
        s_gga_cnt_last = gga_cnt;
        s_rmc_cnt_last = rmc_cnt;
        s_bmp_cnt_last = bmp_cnt;
    }
    if (gga_cnt != s_gga_cnt_last) { s_gps_new = 1u; s_gga_cnt_last = gga_cnt; }
    if (rmc_cnt != s_rmc_cnt_last) { s_rmc_cnt_last = rmc_cnt; }
    if (bmp_cnt != s_bmp_cnt_last) {
        s_bmp_cnt_last = bmp_cnt;
        /* 气压高度：线性化 h = (p0 - p) * k。绝对基准由 b_baro 吸收，只需相对变化准确。
         * 为什么不上 powf：本工程不用 libm 的 pow（其余处理函数一律只做乘加 + sqrt），
         * 而气压高度只作**相对**观测，绝对项被 b_baro 与 M2 吸收。 */
        if (h->baro.press_avg_pascal > V5F_EKF_BARO_PA_LO
            && h->baro.press_avg_pascal < V5F_EKF_BARO_PA_HI) {
            float hnew = V5F_EKF_BARO_M_PER_PA * (V5F_EKF_BARO_PA0 - h->baro.press_avg_pascal);
            if (!s_baro_seen || fabsf(hnew - s_baro_h_last) < V5F_EKF_BARO_STEP_MAX_M) {
                s_baro_h_last = hnew;
            }
            s_baro_h = hnew;
            s_baro_seen = 1u;
            s_baro_new  = 1u;
        }
    }

    /* ---- GPS 报文质量（只看 GGA 定位质量 / GSV 载噪比 / GSA 几何） ---- */
    gq_ok  = (uint8_t)((h->gps_gga.fix_quality >= 1u)
                    && (h->gps_gga.sat_num >= V5F_EKF_SV_MIN)
                    && (h->gps_gga.hdop > 0.0f)
                    && (h->gps_gga.hdop <= V5F_EKF_HDOP_MAX));
    snr_ok = (uint8_t)((h->gps_gsv.snr_n == 0u)
                    || (h->gps_gsv.snr_avg_dbhz >= V5F_EKF_SNR_MIN_DBHZ));
    gn_ok  = (uint8_t)(h->gps_rmc.status == (uint8_t)'A');
    vd_ok  = (uint8_t)((h->gps_gsa.vdop <= 0.0f) || (h->gps_gsa.vdop <= V5F_EKF_VDOP_MAX));
    spac   = h->gps_rmc.speed_mps;

    /* M1 水平位置 */
    gate->ekf_gps_pos = (uint8_t)(gq_ok && snr_ok && gn_ok
                        && (h->gps_gga.fresh.flags & SHM_GGA_QUALITY)
                        && (h->gps_rmc.fresh.flags & SHM_RMC_POS));
    /* M2 高度（同 M1，另加几何） */
    gate->ekf_gps_alt = (uint8_t)(gate->ekf_gps_pos && vd_ok
                        && (h->gps_gga.fresh.flags & SHM_GGA_ALT));
    /* M4 多普勒速度：低速时 course 无意义（静止时 course 噪声可任意大），
     *    所以要求 speed 本身够大。注意这里用**原始** speed，不用 b_dop（防自环）。 */
    gate->ekf_gps_vel = (uint8_t)(gq_ok && gn_ok && snr_ok
                        && (h->gps_rmc.fresh.flags & SHM_RMC_SPEED)
                        && (h->gps_rmc.fresh.flags & SHM_RMC_COURSE)
                        && (spac > V5F_EKF_VEL_SPEED_MIN_MPS));
    /* M3 气压：预热（上电 5 s 内气压有 2481 Pa 的暂态）+ 温度合理 + 未饱和 */
    gate->ekf_baro = (uint8_t)(s_t_run >= V5F_EKF_BARO_WARMUP_S
                    && h->baro.temp_celsius > -40.0f
                    && h->baro.temp_celsius < 85.0f);
    /* M6 重力/倾斜：判据与外链同源但**独立字段**（一环一门，改一个不动另一个） */
    am2 = h->imu.accel_g[0]*h->imu.accel_g[0]
        + h->imu.accel_g[1]*h->imu.accel_g[1]
        + h->imu.accel_g[2]*h->imu.accel_g[2];
    gate->ekf_tilt = (uint8_t)(h->imu.acc_valid
                    && (fabsf(am2 - 1.0f) < V5F_EKF_TILT_AMAG_TOL)
                    && ((h->stat.level_dps < V5F_EKF_TILT_LEV_DPS) || h->stat.ac_bypass));
    /* M7 磁偏航：门只用**外生**的 mag.trust（它已含 |y| 模长门与 |a_lin| 倾斜门）。
     *    新息 chi2 在第 7 步做，剔除单独记 bit9 —— 门与野值剔除是两件事。 */
    gate->ekf_mag_yaw = (uint8_t)((h->mag.trust != 0u) && (V5F_EKF_YAW_OBS_EN != 0u));
    /* M5 软 ZUPT：is_static + |a_lin| + **原始** GPS 速度。
     *    只用 is_static 不行：等效原理下匀速平动对陀螺/加计都不可见，实测走动时
     *    is_static 可 100% 成立；GPS 多普勒是唯一能分开"静止"与"匀速平动"的外生量。
     *    这里用不到 b_dop（它由本门牵引，用它就是自环）。 */
    gate->ekf_zupt = (uint8_t)(h->stat.is_static
                    && ((h->imu.a_lin[0]*h->imu.a_lin[0]
                       + h->imu.a_lin[1]*h->imu.a_lin[1]
                       + h->imu.a_lin[2]*h->imu.a_lin[2]) < V5F_EKF_ZUPT_ALIN2)
                    && ((spac < V5F_EKF_ZUPT_SPEED_MAX_MPS)
                        || !(h->gps_rmc.fresh.flags & SHM_RMC_SPEED)));

    /* ENU 原点：首个有效定位那一帧建立（位置/速度同时清零），此后坐标才有绝对意义 */
    if (!s_origin_ok && gate->ekf_gps_pos && h->gps_rmc.lat_e7 != 0) {
        float lat0 = (float)h->gps_rmc.lat_e7 * 1e-7f;
        s_lat0_e7 = h->gps_rmc.lat_e7;
        s_lon0_e7 = h->gps_rmc.lon_e7;
        s_m_per_deg_lat = V5F_EKF_R_EARTH_M * DEG2RAD;
        s_m_per_deg_lon = V5F_EKF_R_EARTH_M * DEG2RAD * cosf(lat0 * DEG2RAD);
        s_origin_ok = 1u;
        s_x[IX_P + 0u] = 0.0f; s_x[IX_P + 1u] = 0.0f;
        s_x[IX_V + 0u] = 0.0f; s_x[IX_V + 1u] = 0.0f;
        s_gate_bits |= V5F_EKF_GB_ORIGIN;
    }

    return V5F_PROC_OK;
}
