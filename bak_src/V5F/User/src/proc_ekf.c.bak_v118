/* ---------------------------------------------------------------------------
 * Ğ¡¹¤¾ß
 * ------------------------------------------------------------------------- */
static float wrap_pi(float a)
{
    while (a >  EKF_PI) a -= EKF_TWOPI;
    while (a < -EKF_PI) a += EKF_TWOPI;
    return a;
}

static void q_mul(const float *a, const float *b, float *o)
{
    float w = a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3];
    float x = a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2];
    float y = a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1];
    float z = a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0];
    o[0] = w; o[1] = x; o[2] = y; o[3] = z;
}

static void q_norm(float *q)
{
    float s, n2 = q[0]*q[0] + q[1]*q[1] + q[2]*q[2] + q[3]*q[3];
    if (n2 < 1e-12f) { q[0] = 1.0f; q[1] = q[2] = q[3] = 0.0f; return; }
    s = 1.0f / sqrtf(n2);
    q[0] *= s; q[1] *= s; q[2] *= s; q[3] *= s;
}

static void q_to_R(const float *q, float R[3][3])
{
    float w = q[0], x = q[1], y = q[2], z = q[3];
    R[0][0] = 1.0f - 2.0f*(y*y + z*z);
    R[0][1] = 2.0f*(x*y - w*z);
    R[0][2] = 2.0f*(x*z + w*y);
    R[1][0] = 2.0f*(x*y + w*z);
    R[1][1] = 1.0f - 2.0f*(x*x + z*z);
    R[1][2] = 2.0f*(y*z - w*x);
    R[2][0] = 2.0f*(x*z - w*y);
    R[2][1] = 2.0f*(y*z + w*x);
    R[2][2] = 1.0f - 2.0f*(x*x + y*y);
}

static void rot_bn(const float R[3][3], const float *v, float *o)
{
    float a = R[0][0]*v[0] + R[0][1]*v[1] + R[0][2]*v[2];
    float b = R[1][0]*v[0] + R[1][1]*v[1] + R[1][2]*v[2];
    float c = R[2][0]*v[0] + R[2][1]*v[1] + R[2][2]*v[2];
    o[0] = a; o[1] = b; o[2] = c;
}

static void rot_nb(const float R[3][3], const float *v, float *o)
{
    float a = R[0][0]*v[0] + R[1][0]*v[1] + R[2][0]*v[2];
    float b = R[0][1]*v[0] + R[1][1]*v[1] + R[2][1]*v[2];
    float c = R[0][2]*v[0] + R[1][2]*v[1] + R[2][2]*v[2];
    o[0] = a; o[1] = b; o[2] = c;
}

/* Ô­Ê¼ LSB -> ±ÈÁ¦ m/s^2£¨Ö»ÓÃÀëÏß³£Á¿£º¼õÁãÆ«¡¢³ı±ê¶È¡¢³Ë±¾µØÖØÁ¦£© */
static void raw_f_mps2(const volatile v5f_hold_t *h, float *f)
{
    static const float b0[3] = { V5F_ACCEL_BIAS_LSB_X, V5F_ACCEL_BIAS_LSB_Y, V5F_ACCEL_BIAS_LSB_Z };
    uint32_t i;
    for (i = 0u; i < 3u; i++) {
        f[i] = ((float)h->imu.accel_lsb[i] - b0[i]) / g_v5f_accel_lsb_per_g[i] * V5F_EKF_G_MPS2;
    }
}

/* Ô­Ê¼ LSB -> ½ÇËÙ¶È rad/s£¨Ö»ÓÃÀëÏß³£Á¿£© */
/* ÍÓÂİµÄ**ÍêÕûÀëÏßÄ£ĞÍ**£ºÖğÖá±ê¶È -> ¶Ô³Æ½»²æÏî¡£Ë³ĞòÓë³£Á¿Óë¾ÉÁ´
 * proc_gyro_bias.c ÍêÈ«Ò»ÖÂ£¨ÄÇÀïÊÇ dv[i] -> ½»²æ -> Êä³ö£¬ÔÙÔÚ proc_attitude.c Àï
 * ×ö¼ÓËÙ¶ÈÃô¸Ğ¶È£©¡£Î¨Ò»²»º¬µÄÊÇ**ÔÚÏßÇ£Òı³öÀ´µÄÁãÆ«**£¬ÄÇÖ»ÓÉ EKF ×Ô¼ºµÄ bg ×´Ì¬³Ğµ£¡£
 * ¡ï ¼ÓËÙ¶ÈÃô¸Ğ¶È°´ÏîÄ¿½áÂÛ**²»×ö**£ºÊµ²â±êÁ¿Ä£ĞÍ²»³ÉÁ¢
 *   £¨²»²¹ 8.649 ¶È -> ²¹ÁË 8.997 ¶È£¬ÈıÌõÒ¡»Î¼ÇÂ¼È«²¿±ä²î£©£¬
 *   V5F_GYRO_GSENS_* ÒÑ±»¹ÊÒâÖÃ 0¡£"Óë¾ÉÁ´Í¬Ò»Ì×ÀëÏßÄ£ĞÍ"¾Í°üº¬"Ëü¹Ø×ÅµÄÎÒÒ²²»¿ª"¡£ */
static void raw_w_rads(const volatile v5f_hold_t *h, float *w)
{
    static const float g0[3] = { V5F_GYRO_BIAS_LSB_X, V5F_GYRO_BIAS_LSB_Y, V5F_GYRO_BIAS_LSB_Z };
    float dv[3];
    uint32_t i;

    for (i = 0u; i < 3u; i++) {
        dv[i] = ((float)h->imu.gyro_lsb[i] - g0[i]) / g_v5f_gyro_lsb_per_dps[i];
    }
    /* ¶Ô³Æ½»²æ£ºdps_out[i] = dps[i] + sum_{j!=i} k_ij * dps[j]£¨0.15~0.19%£© */
    w[0] = (dv[0] + V5F_GYRO_KXY * dv[1] + V5F_GYRO_KXZ * dv[2]) * DEG2RAD;
    w[1] = (dv[1] + V5F_GYRO_KXY * dv[0] + V5F_GYRO_KYZ * dv[2]) * DEG2RAD;
    w[2] = (dv[2] + V5F_GYRO_KXZ * dv[0] + V5F_GYRO_KYZ * dv[1]) * DEG2RAD;
}

/* Îó²î×¢Èë£ºq <- Exp(dth) (x) q£¨È«¾ÖÎó²îÔ¼¶¨£¬Ò»½×°ë½Ç£©
 * ¡ï dp µÄ×¢Èë**²»**¿´ s_origin_ok£ºÎ»ÖÃ±¾À´¾ÍÊÇ"Ïà¶Ô¶ÔÆëµã"£¬ÓĞÃ»ÓĞ ENU Ô­µã¶¼³ÉÁ¢¡£
 *   µÚÒ»°æÔÚÕâÀï¼ÓÁË origin_ok µÄÃÅ£¬½á¹ûÃ»ÓĞ GPS Ê±ÆøÑ¹¹Û²âĞŞ³öÀ´µÄ dp ±»¶ªµô£¬
 *   ÂË²¨Æ÷Ö»ÄÜÄÃ b_baro È¥ÎüÊÕ£¬·´¶ø°Ñ¸ß¶È»·¸ã³Éµ¥±ß¡£ */
static void ekf_inject(const float *dx)
{
    float dq[4], t[4];
    uint32_t i;

    for (i = 0u; i < 3u; i++) s_x[IX_P  + i] += dx[IX_P  + i];
    for (i = 0u; i < 3u; i++) s_x[IX_V  + i] += dx[IX_V  + i];
    for (i = 0u; i < 3u; i++) s_x[IX_BA + i] += dx[IX_BA + i];
    for (i = 0u; i < 3u; i++) s_x[IX_BG + i] += dx[IX_BG + i];
    /* Ç¯Î»£ºÕâÁ½¸ö×´Ì¬Ã»ÓĞÖ±½Ó¹Û²â£¬Ö»±»ÈõÏà¹Ø¼ä½ÓÍÆ£»²»Ç¯¾ÍÄÜÆ¯µ½²»¿ÉÄÜµÄÖµ
     * £¨Êµ²â bg_z = -40.7 dps£©£¬¶ø bg ²ÎÓë»ı·Ö -> »áÕæÈ¥×ª×ËÌ¬¡£ */
    for (i = 0u; i < 3u; i++) {
        if (s_x[IX_BA + i] >  V5F_EKF_BA_LIM_MPS2) s_x[IX_BA + i] =  V5F_EKF_BA_LIM_MPS2;
        if (s_x[IX_BA + i] < -V5F_EKF_BA_LIM_MPS2) s_x[IX_BA + i] = -V5F_EKF_BA_LIM_MPS2;
        if (s_x[IX_BG + i] >  V5F_EKF_BG_LIM_RADS) s_x[IX_BG + i] =  V5F_EKF_BG_LIM_RADS;
        if (s_x[IX_BG + i] < -V5F_EKF_BG_LIM_RADS) s_x[IX_BG + i] = -V5F_EKF_BG_LIM_RADS;
    }
    s_x[IX_BB] += dx[15];

    dq[0] = 1.0f;
    dq[1] = 0.5f * dx[6];
    dq[2] = 0.5f * dx[7];
    dq[3] = 0.5f * dx[8];
    q_norm(dq);
    q_mul(dq, &s_x[IX_Q], t);
    for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = t[i];
    q_norm(&s_x[IX_Q]);
}

/* o = q (x) v (x) q*£º°ÑÒ»¸ö**Ê¸Á¿**°´µ¥Î»ËÄÔªÊıĞı×ª£¨Óë q_mul ²»ÊÇÒ»»ØÊÂ£©¡£
 * ÓÃÓÚ°Ñ´ÅÁ¦¼Æ²ÉÑùÊ±¿ÌµÄ»úÌåÏµÊ¸Á¿×ªµ½µ±Ç°»úÌåÏµ¡£ */
static void q_rot_vec(const float *q, const float *v, float *o)
{
    float u[3], tt[3], c[3];
    u[0] = q[1]; u[1] = q[2]; u[2] = q[3];
    tt[0] = 2.0f*(u[1]*v[2] - u[2]*v[1]);
    tt[1] = 2.0f*(u[2]*v[0] - u[0]*v[2]);
    tt[2] = 2.0f*(u[0]*v[1] - u[1]*v[0]);
    c[0] = u[1]*tt[2] - u[2]*tt[1];
    c[1] = u[2]*tt[0] - u[0]*tt[2];
    c[2] = u[0]*tt[1] - u[1]*tt[0];
    o[0] = v[0] + q[0]*tt[0] + c[0];
    o[1] = v[1] + q[0]*tt[1] + c[1];
    o[2] = v[2] + q[0]*tt[2] + c[2];
}

static void H_zero(uint8_t m)
{
    uint32_t i, j;
    for (i = 0u; i < m; i++) {
        for (j = 0u; j < EKF_N; j++) s_H[i][j] = 0.0f;
    }
}

/* ---------------------------------------------------------------------------
 * Í¨ÓÃ¹Û²â¸üĞÂ£¨m = 1/2/3£©£ºH = s_H£¬R = m x m
 *   P ÓÃ±ê×¼ĞÎÊ½ P <- P - K S K^T£¨ÖÜÆÚÄ©Í³Ò»¶Ô³Æ»¯ + ¶Ô½ÇÏÂÏŞ£©
 *   ·µ»Ø 0 = ÒÑ¸üĞÂ£¨**º¬±»Èí¼ÓÈ¨**£º¹Û²âÈ·Êµ½øÈ¥ÁË¡¢Ö»ÊÇÈ¨ÖØĞ¡£©£»2 = ÊıÖµÊ§°Ü¡£
 * ------------------------------------------------------------------------- */
static uint8_t ekf_update(const float *R, uint8_t m, const float *r,
                          float nis_max, float *nis_out, uint8_t *rej,
                          uint16_t inj_mask, float k_cap)
{
    float S[3][3], Si[3][3];
    float det, nis = 0.0f, s;
    float s_soft = 1.0f;   /* ¡ïVER=86 chi2 Èí¼ÓÈ¨µÄÊµ¼Ê R ·Å´ó±¶Êı */
    uint32_t i, j, k;

    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < EKF_N; k++) s += s_Pn[i][k] * s_H[j][k];
            s_PHt[i][j] = s;
        }
    }
    for (i = 0u; i < m; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < EKF_N; k++) s += s_H[i][k] * s_PHt[k][j];
            S[i][j] = s + R[i*m + j];
        }
    }
    if (m == 1u) {
        if (S[0][0] < 1e-12f) return 2u;
        Si[0][0] = 1.0f / S[0][0];
    } else if (m == 2u) {
        det = S[0][0]*S[1][1] - S[0][1]*S[1][0];
        if (det < 1e-18f) return 2u;
        Si[0][0] =  S[1][1]/det; Si[0][1] = -S[0][1]/det;
        Si[1][0] = -S[1][0]/det; Si[1][1] =  S[0][0]/det;
    } else {
        det = S[0][0]*(S[1][1]*S[2][2] - S[1][2]*S[2][1])
            - S[0][1]*(S[1][0]*S[2][2] - S[1][2]*S[2][0])
            + S[0][2]*(S[1][0]*S[2][1] - S[1][1]*S[2][0]);
        if (det < 1e-18f) return 2u;
        Si[0][0] = (S[1][1]*S[2][2] - S[1][2]*S[2][1])/det;
        Si[0][1] = (S[0][2]*S[2][1] - S[0][1]*S[2][2])/det;
        Si[0][2] = (S[0][1]*S[1][2] - S[0][2]*S[1][1])/det;
        Si[1][0] = (S[1][2]*S[2][0] - S[1][0]*S[2][2])/det;
        Si[1][1] = (S[0][0]*S[2][2] - S[0][2]*S[2][0])/det;
        Si[1][2] = (S[0][2]*S[1][0] - S[0][0]*S[1][2])/det;
        Si[2][0] = (S[1][0]*S[2][1] - S[1][1]*S[2][0])/det;
        Si[2][1] = (S[0][1]*S[2][0] - S[0][0]*S[2][1])/det;
        Si[2][2] = (S[0][0]*S[1][1] - S[0][1]*S[1][0])/det;
    }
    for (i = 0u; i < m; i++) {
        s = 0.0f;
        for (j = 0u; j < m; j++) s += Si[i][j] * r[j];
        nis += r[i] * s;
    }
    if (nis_out) *nis_out = nis;
    if (nis > nis_max) {
        /* Èí¼ÓÈ¨£¬²»Ó²ÌŞ£ºSi /= (nis/nis_max)£¬µÈ¼Û R_eff = R*(nis/nis_max)¡£
         * ÎªÊ²Ã´²»ÄÜÓ²ÌŞ£ºÌŞÒ»´Î²»¸Ä P -> S ²»±ä -> nis ÓÀÔ¶³¬ÏŞ -> »·ÓÀ¾ÃËøËÀ
         * £¨Êµ²âÈı´Î£»×î½üÒ»´ÎÊÇ VER=20 Àï nis_baro p50=11.92¡¢53.5% µÄÖ¡±»ÌŞ¡¢
         *  p_z Æ¯µ½ ¡À287 m ¶ø b_baro ¶³ÔÚ 0£©¡£¼«¶ËÒ°ÖµÈ¨ÖØÇ÷ 0£¬ÈÔÈ»µ²µÃ×¡¡£ */
        float sc = nis / nis_max;
        if (sc > V5F_EKF_CHI2_SC_MAX) sc = V5F_EKF_CHI2_SC_MAX;
        for (i = 0u; i < m; i++) {
            for (j = 0u; j < m; j++) Si[i][j] /= sc;
        }
        s_soft = sc;                     /* ¡ïVER=86 S_eff = soft*S */
        s_chi2_soft = 1u;
        if (rej && *rej < 250u) (*rej)++;
    } else if (rej) {
        *rej = 0u;
    }

    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += s_PHt[i][k] * Si[k][j];
            s_K[i][j] = s;
        }
    }
    /* ¡ï ×¢ÈëÑÚÂë£ºÃ¿µÀ¹Û²âÖ»ÄÜ¶¯ËüÓĞÎïÀí×Ê¸ñ¶¯µÄ×´Ì¬¡£
     * °Ñ K Àï²»¸Ã¶¯µÄĞĞÇåÁã£¬dx Óë P µÄĞŞÕı¾ÍÍ¬Ê±ÊÜÏŞ ¡ª¡ª Õâ½Ğ"¹Û²âÔÚ×Ó¿Õ¼äÀï×÷ÓÃ"¡£
     * ÎªÊ²Ã´±ØĞë×ö£ºK = P H^T S^-1 »áÍ¨¹ıĞ­·½²î½»²æÏî°Ñ¹Û²â×¢Èëµ½ H Àï¸ù±¾Ã»ÓĞµÄ
     * ×´Ì¬ÉÏ¡£Êµ²â VER=29£ºÆøÑ¹¹Û²âÒ»»Ö¸´£¬¾Í¾­ P[8][2] ÍùÆ«º½×¢Èë£¬bg_z ¶¥µ½
     * ¡À10 dps Ç¯Î»¡¢Æ«º½ÒÔ 10 dps ×ª·É£¨-156 ¶È vs ¾ÉÁ´ +4 ¶È£©¡£ */
    for (i = 0u; i < EKF_N; i++) {
        if (!(inj_mask & (uint16_t)(1u << i))) {
            for (j = 0u; j < m; j++) s_K[i][j] = 0.0f;
        }
    }
    /* ¡ï ÔöÒæÉÏÏŞ k_cap£ºK µÄÃ¿Ò»ÏîÈ¡¾ø¶ÔÖµÉÏÏŞ¡£¹Ø¼ü£ºdx ÓëÏÂÃæµÄ P ĞŞÕıÓÃµÄÊÇ
     * **Í¬Ò»¸ö K**£¬ËùÒÔ×´Ì¬ÓëĞ­·½²îÊ¼ÖÕÒ»ÖÂ ¡ª¡ª ÕâÕıÊÇÉÏ´Î"ÏŞ·ù"·¸µÄ´í
     * £¨Ö»»Ø¹ö×´Ì¬¡¢²»»Ø¹ö P£¬ĞÎ³ÉÕı·´À¡£¬°ÑÉÁÏÖ±ä³ÉÁËºãËÙÆ¯ÒÆ£©¡£ */
    /* ¡ïVER=85 È¥µô K µÄÖğÔªËØÇ¯Î»£¨ÓÃÉÏ±¨Êı¾İÀëÏß»Ø·ÅÑéÖ¤£©£º
     * Ç¯ K ºóĞ­·½²îÊÕËõÍË»¯³É K^2*S£¨Óë P ÎŞ¹Ø£©£¬P Òò´ËÓĞµØ°å£º
     *   Êµ²â sigma_yaw ¿¨ÔÚ 54~68 ¶È£¨»Ø·ÅÖğ¶ÎÎó²î <=1.1 ¶È£©¡¢
     *   sigma_tilt ¿¨ÔÚ 4.4~17 ¶È£»²»Ç¯Ê±·Ö±ğÊÕÁ²µ½ 2.2 ¶ÈÓë ~3.3 ¶È¡£
     * ÏÖÔÚ£ºK ±£³Ö×îÓÅ -> P -= K S K' ¾ÍÊÇ¾«È·µÄ (I-KH)P£»
     *        ÏŞ²½¸ÄÓÉ"Ç¯ĞÂÏ¢"³Ğµ££º|r_k| <= k_cap¡£K<=1 Ê± dx=K*r ·ù¶È²»³¬¹ı k_cap£¬
     *        ËùÒÔ k_cap µÄÎïÀíº¬ÒåÈÔÊÇ"µ¥´Î×î´óĞŞÕıÁ¿"£¬¸÷µ÷ÓÃµãÈ¡Öµº¬Òå²»±ä¡£ */
    /* ¡ïVER=86 »Ö¸´ K µÄÖğÔªËØÇ¯Î»£¨ÏŞ²½£©¡£
     * VER=85 ¸Ä³ÉÇ¯ĞÂÏ¢ + ÓÃ"×îÓÅ K"µÄ¹«Ê½¸üĞÂ P ÊÇ¸ù±¾´íÎó£º
     * Êµ¼ÊÖ»ÌáÈ¡ÁË¼«Ğ¡Ò»²¿·ÖĞÅÏ¢£¬P È´°´È«²¿ĞÅÏ¢ÊÕËõ -> ¹ı¶È×ÔĞÅ¡£
     * Êµ²â£ºsigma_yaw ¶¤ÔÚ 2.500 ¶ÈÏÂ½ç¡¢sigma_tilt 0.21 ¶È£¬
     *       ¶ø |ĞÂÏ¢| p90 27.6 / max 33.8 ¶È -> ÔöÒæËúÏİ¡¢×ËÌ¬×ÔÓÉÆ¯¡£
     * ÕıÈ·²»±äÁ¿£ºP ±ØĞë¶ÔÓ¦"Êµ¼ÊÓÃµôµÄÔöÒæ"¡£ */
    if (k_cap > 0.0f) {
        for (i = 0u; i < EKF_N; i++) {
            for (j = 0u; j < m; j++) {
                if (s_K[i][j] >  k_cap) s_K[i][j] =  k_cap;
                if (s_K[i][j] < -k_cap) s_K[i][j] = -k_cap;
            }
        }
    }
    /* dx = K r£¨r ²»Ç¯£ºĞÂÏ¢ÊÇ"ÎÒ´í¶àÉÙ"µÄÎ¨Ò»ĞÅÏ¢£¬Ç¯ÁË¾Í¿´²»¼ûÎó²î£© */
    for (i = 0u; i < EKF_N; i++) {
        s = 0.0f;
        for (k = 0u; k < m; k++) s += s_K[i][k] * r[k];
        s_dx[i] = s;
    }
    /* s_KS = K * S_eff£¨S_eff = soft*S£¬chi2 Èí¼ÓÈ¨Ê±±£³Ö¾«È·£© */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < m; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += s_K[i][k] * S[k][j];
            s_KS[i][j] = s * s_soft;
        }
    }
    /* s_KHP = K (H P) = K * PHt' */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += s_K[i][k] * s_PHt[j][k];
            s_KHP[i][j] = s;
        }
    }
    /* Joseph: P <- P - KHP - KHP' + K S_eff K'
     * K È¡×îÓÅÊ±Ç¡ºÃÍË»¯Îª P - K S K'£¨=Ô­¹«Ê½£©£¬
     * K ±»Ç¯Ê±ÔòÊÇ¶Ô¸Ã K ¾«È·µÄºóÑéĞ­·½²î -> ²»»á¹ı¶È×ÔĞÅ¡£ */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) {
            s = 0.0f;
            for (k = 0u; k < m; k++) s += s_KS[i][k] * s_K[j][k];
            s_Pn[i][j] += s - s_KHP[i][j] - s_KHP[j][i];
        }
    }
    ekf_inject(s_dx);
    return 0u;
}

/* ===========================================================================
 * ¸÷µÀ¹Û²â£¨Ò»µÀÒ»º¯Êı£¬¸÷×ÔÖ»Õ¼½×¶Î»úµÄÒ»Ö¡£©
 * ========================================================================= */

/* M6 ÖØÁ¦/ÇãĞ±£¨3 Î¬£¬ÖÈ 2£© */
static void ekf_m6_tilt(const volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float R[9], r[3], f[3], Rt[3][3], pr[3], fb[3], up[3], ex[3], M[3][3], Sx[3][3];
    float e2, tang;
    uint8_t st;
    uint32_t i, j, k;

    if (!V5F_EKF_TILT_EN || !gate->ekf_tilt || !h->imu.acc_valid) return;
    q_to_R(&s_x[IX_Q], Rt);
    raw_f_mps2(h, f);
    for (i = 0u; i < 3u; i++) f[i] -= s_x[IX_BA + i];   /* ¹Û²âÄ£ĞÍµÄ±ÈÁ¦ÒªÈ¥µôÁãÆ«²Ğ²î */
    e2 = sqrtf(f[0]*f[0] + f[1]*f[1] + f[2]*f[2]);
    if (e2 <= 1e-6f) return;
    fb[0] = f[0]/e2; fb[1] = f[1]/e2; fb[2] = f[2]/e2;
    up[0] = 0.0f; up[1] = 0.0f; up[2] = 1.0f;
    rot_nb(Rt, up, pr);                        /* Ô¤²â£º¾²Ö¹Ê±"ÉÏ"ÔÚ»úÌåÏµµÄ±íÊ¾ */
    /* ÇĞÆ½ÃæÍ¶Ó°£ºr = (I - pr pr^T)(fb - pr)¡£¾¶Ïò·ÖÁ¿¶ÔÇã½ÇÃ»ÓĞĞÅÏ¢£¬²»Í¶Ó°¾ÍµÈÓÚ
     * °Ñ"±ÈÁ¦Ä£³¤²Ğ²î"µ±Çã½ÇÎó²î¹à½øÂË²¨Æ÷¡£ */
    ex[0] = fb[0] - pr[0]; ex[1] = fb[1] - pr[1]; ex[2] = fb[2] - pr[2];
    tang = ex[0]*pr[0] + ex[1]*pr[1] + ex[2]*pr[2];
    for (i = 0u; i < 3u; i++) r[i] = ex[i] - tang*pr[i];
    /* H = (I - pr pr^T) R^T [up]x £»d(pred)/d(dth) = R^T [up]x */
    Sx[0][0] = 0.0f;   Sx[0][1] = -up[2]; Sx[0][2] =  up[1];
    Sx[1][0] = up[2];  Sx[1][1] = 0.0f;   Sx[1][2] = -up[0];
    Sx[2][0] = -up[1]; Sx[2][1] = up[0];  Sx[2][2] = 0.0f;
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) {
            float s2 = 0.0f;
            for (k = 0u; k < 3u; k++) s2 += Rt[k][i] * Sx[k][j];
            M[i][j] = s2;
        }
    }
    H_zero(3u);
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) {
            s_H[i][6u + j] = M[i][j]
                - pr[i]*(pr[0]*M[0][j] + pr[1]*M[1][j] + pr[2]*M[2][j]);
        }
    }
    for (i = 0u; i < 9u; i++) R[i] = 0.0f;
    /* ¡ïVER=89 ³ÏÊµ R£º°ÑÀëĞÄÏî a_c = w^2*ARM Ôì³ÉµÄ±ÈÁ¦·½ÏòÆ«²îĞ´½ø R£¬¶ø²»ÊÇ¿¿°Ñ
     *   ÃÅÊÕµ½ 2 dps È¥»Ø±ÜËü(ÄÇÑùÊµ²â grav_ok Ö»¿ª 33%¡¢´ÅÔİÍ£ 54%)¡£Ğ¡½Ç¶ÈÏÂ
     *   atan(x)=x£¬¹Ê eac(rad) = level_dps^2*DEG2RAD^2*ARM/g£¬Ç¯ 0.2 rad ·À´ô¡£
     *   level_dps ÊÇ 128 Ö¡(16 ms)´°¾ùÖµ£¬Ë²Ê± w ¿ÉÄÜ¸ü¸ß£¬ËùÒÔÕâÊÇ**ÏÂ½ç**¹À¼Æ¡£ */
    {
        float wr  = h->stat.level_dps * DEG2RAD;
        float eac = wr * wr * V5F_EKF_TILT_AC_ARM_M / V5F_EKF_G_MPS2;
        float sg;
        if (eac > 0.2f) eac = 0.2f;
        sg = V5F_EKF_TILT_SIG_RAD + eac;
        R[0] = R[4] = R[8] = sg * sg;
    }
    {
        /* ¡ï µ¥ÖÜÆÚ×ËÌ¬ĞŞÕıÉÏÏŞ£¨= ÖØÁ¦»·µÄ tau ÏÂÏŞ£¬Ô¼ 8 s£©¡£
         *   Ã»ÓĞËü£¬R=(0.5 ¶È)^2 Åä 349 Hz ÂúÔöÒæ¸üĞÂ£¬±Õ»·´ø¿íÔ¼ 100 Hz£¬
         *   ¼Ó¼ÆµÄ·½ÏòÔëÉù£¨0.127 ¶È£©¼¸ºõÔ­Ñù½ø×ËÌ¬ ¡ª¡ª Êµ²â ekf_q È«³Ì¶¶£¬
         *   ¶ø¾ÉÁ´ Mahony£¨tau=5 s£¬´ø¿í 0.03 Hz£©ÎÈ¡£¼Ó¼Æ/´ÅµÄ·½ÏòÎó²îÊÇ
         *   **Ïà¹Ø**µÄ£¨DC Æ«ÖÃ¡¢°²×°²Ğ²î£©£¬²»ÊÇ°×ÔëÉù£¬±ØĞëÏÈÏŞ´ø¿í¡£ */
        float q_before[4];
        uint32_t n;
        for (n = 0u; n < 4u; n++) q_before[n] = s_x[IX_Q + n];
        st = ekf_update(R, 3u, r, V5F_EKF_NIS_MAX_3, &s_nis[3], &s_rej[0], 0x7FC0u, V5F_EKF_TILT_K_MAX);
        {
            float qc[4], dq[4], ang, cap = V5F_EKF_TILT_STEP_MAX_DEG * DEG2RAD;
            qc[0] = q_before[0]; qc[1] = -q_before[1];
            qc[2] = -q_before[2]; qc[3] = -q_before[3];
            q_mul(&s_x[IX_Q], qc, dq);        /* Ïà¶ÔĞı×ª£¬Ğ¡½Ç¶È */
            ang = 2.0f * sqrtf(dq[1]*dq[1] + dq[2]*dq[2] + dq[3]*dq[3]);
            if (ang > cap && ang > 1e-9f) {
                float sc = cap / ang;          /* ÏßĞÔ»ØËõ£¨Ğ¡½Ç¶ÈµÈ¼ÛÓÚ slerp£© */
                float qn[4];
                for (n = 0u; n < 4u; n++) {
                    qn[n] = q_before[n] + (s_x[IX_Q + n] - q_before[n]) * sc;
                }
                for (n = 0u; n < 4u; n++) s_x[IX_Q + n] = qn[n];
                q_norm(&s_x[IX_Q]);
            }
        }
    }
    s_tilt_prx = pr[0]; s_tilt_pry = pr[1]; s_tilt_prz = pr[2];   /* ¡ïVER=50 */
    if (st == 0u) {
        s_gate_bits |= V5F_EKF_GB_TILT;
        s_tilt_dqx = s_dx[IX_Q + 0] * RAD2DEG;
        s_tilt_dqy = s_dx[IX_Q + 1] * RAD2DEG;
        s_tilt_dqz = s_dx[IX_Q + 2] * RAD2DEG;
    }
}

/* M5 Èí ZUPT£¨3 Î¬£© */
static void ekf_m5_zupt(const volatile v5f_proc_gate_t *gate)
{
    float R[9], r[3], lam, sg;
    uint8_t st;
    uint32_t i;

    if (!gate->ekf_zupt) return;
    lam = (float)gate->vel_soft * (1.0f/255.0f);
    if (lam < 0.05f) lam = 0.05f;
    sg = V5F_EKF_ZUPT_SIG_MPS / lam;
    H_zero(3u);
    s_H[0][3] = 1.0f; s_H[1][4] = 1.0f; s_H[2][5] = 1.0f;
    for (i = 0u; i < 9u; i++) R[i] = 0.0f;
    R[0] = R[4] = R[8] = sg * sg;
    for (i = 0u; i < 3u; i++) r[i] = -s_x[IX_V + i];
    st = ekf_update(R, 3u, r, V5F_EKF_NIS_MAX_3, &s_nis[1], &s_rej[1], 0x0E38u, 0.05f);
    if (st == 0u) s_gate_bits |= V5F_EKF_GB_ZUPT;
}

/* M3 ÆøÑ¹¸ß¶È£¨1 Î¬£¬Í¬Ê±¹Û²â p_z Óë b_baro£© */
static void ekf_m3_baro(const volatile v5f_proc_gate_t *gate)
{
    float R[1], r[1], bnow, pnow, bold, pold;
    uint8_t st;

    if (!gate->ekf_baro || !s_baro_new) return;
    bnow = s_baro_h;
    pnow = s_x[IX_P + 2];
    if (s_bh_fill >= (uint8_t)V5F_EKF_BARO_HP_N) {
        /* ²îÖµ¹Û²â£ºz = ÆøÑ¹¸ß¶ÈÔÚ´°¿ÚÄÚµÄ±ä»¯£¬Ô¤²â = p_z ÔÚ´°¿ÚÄÚµÄ±ä»¯¡£
         * ÂıÆ¯ÔÚ²îÖµÀïµÖÏû£»H Ö»¹Ò dp_z£¨**²»º¬ b_baro**£©£¬ËùÒÔ¾ø¶Ô»ù×¼Ö»ÓÉ
         * GPS ¸ß¶È M2 Ìá¹© ¡ª¡ª ÕâÕıÊÇ"ÆøÑ¹Ö»²¹Ë²Ì¬"µÄÒâË¼¡£ */
        bold = s_bh_ring[s_bh_idx];
        pold = s_bp_ring[s_bh_idx];
        H_zero(1u);
        s_H[0][2] = 1.0f;
        R[0] = 2.0f * V5F_EKF_BARO_SIG_M * V5F_EKF_BARO_SIG_M
             + V5F_EKF_BARO_OLD_VAR_M2;
        r[0] = (bnow - bold) - (pnow - pold);
        {
            float bb_save = s_x[IX_BB];       /* ¸üĞÂÇ°ÏÈ´æ b_baro */
            uint32_t k2;
            /* ¡ï ÑÚÂë = 0x0024£ºdp_z + dv_z£¬**²»º¬ b_baro**¡£ÕıÈ·±ß½çÊÇ£º
         *   ¡¤ dv_z ºÏ·¨£ºÆøÑ¹ÊÇÎ»ÖÃÁ¿£¬Î»ÖÃ-ËÙ¶ÈµÄñîºÏÀ´×Ô¶¯Á¦Ñ§Ä£ĞÍ
         *     £¨P[p_z][v_z] ÓÉ F ½¨Á¢£©£¬Î»ÖÃ¹Û²â¾İ´ËĞŞ´¹Ö±ËÙ¶ÈÊÇ±ê×¼ Kalman ĞĞÎª£¬
         *     ²»ÊÇÆ¾¿ÕÔìĞÅÏ¢¡£±ØĞë·Å¿ª£¬·ñÔò´¹Ö±ËÙ¶ÈÖ»ÄÜ¿¿»ı·ÖÒ»Â·Æ¯¡£
         *   ¡¤ b_baro ²»ºÏ·¨£ºËüÊÇ**¾ø¶Ô**»ù×¼£¬Ö»ÓĞ GPS ¸ß¶È M2 ÓĞ×Ê¸ñ¶¨Ëü£»
         *     Ã»ÓĞ M2 Ê±ËüÃ»ÓĞ¹Û²âÕß£¨Ã¿ÖÜÆÚ¹éÁãÒÑÇ¿ÖÆËü±£³Ö¶èĞÔ£©¡£
         *   ¡¤ ×ËÌ¬/ÁãÆ«Ò»ÂÉ²»Ğí£ºÆøÑ¹¶Ô×ËÌ¬Ã»ÓĞÈÎºÎĞÅÏ¢¡£
         *   ×¢£ºVER=30 µÄËÙ¶È·¢É¢ÕæĞ×ÊÇ±»ÇĞµôµÄ ba£¨Ğ¹Â©ÎŞ´¦¿ÉÈ¥£©£¬²»ÊÇÕâÒ»Ïî¡£ */
        st = ekf_update(R, 1u, r, V5F_EKF_NIS_MAX_1, &s_nis[2], &s_rej[2], 0x0024u, 0.02f);
            /* ¡ï Ã»ÓĞ GPS ¸ß¶ÈÊ± b_baro ±ØĞë**ÍêÈ«¶èĞÔ**¡£
             *   ²î·Ö¹Û²âµÄ H ²»º¬ b_baro£¬µ« ekf_update Àï K[15] = Pn[15][2]*Si£º
             *   Ö»Òª P[15][2] ±»´«²¥/¸üĞÂÅª³É·ÇÁã£¬b_baro ¾Í»á±»ÍÏ×ß£¬¶ø P µÄ¸üĞÂ
             *   ÓÖ¼ÓÉîÕâ¸öÏà¹Ø -> Õı·´À¡¡£Êµ²â VER=27 Æ¯µ½ -116.2 m£¬pbb ±»Ñ¹µ½ 0£¬
             *   Ğ­·½²î±»´ø»µºóÆ«º½»·Ò»ÆğÊ§Ğ§£¨×Ü×ª½Ç -156.9 vs ¾ÉÁ´ +0.88£©¡£
             *   "ÆøÑ¹Ö»²¹Ë²Ì¬"¾ÍÒâÎ¶×Å£ºÃ»ÓĞ¾ø¶Ô»ù×¼Ê±Ëü¼È²»±»¶¯¡¢Ò²²»¶¯ÈË¡£ */
            s_x[IX_BB] = bb_save;
            for (k2 = 0u; k2 < EKF_N; k2++) {
                s_Pn[15][k2] = 0.0f;
                s_Pn[k2][15] = 0.0f;
            }
            s_Pn[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
            s_P[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
            for (k2 = 0u; k2 < EKF_N; k2++) {
                s_P[15][k2] = 0.0f;
                s_P[k2][15] = 0.0f;
            }
            s_P[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
        }
        if (st == 0u) s_gate_bits |= V5F_EKF_GB_BARO;
    }
    /* Èë»·£¨ÎŞÂÛ±¾´ÎÊÇ·ñ¸üĞÂ¶¼Òª×ß£¬±£Ö¤´°¿Ú³¤¶Èºã¶¨£© */
    s_bh_ring[s_bh_idx] = bnow;
    s_bp_ring[s_bh_idx] = pnow;
    s_bh_idx = (uint8_t)((s_bh_idx + 1u) % (uint8_t)V5F_EKF_BARO_HP_N);
    if (s_bh_fill < (uint8_t)V5F_EKF_BARO_HP_N) s_bh_fill++;
}

/* M7 ´ÅÆ«º½£¨1 Î¬£¬Ö»¹ÒµÚ 8 Ïî£© */
static void ekf_m7_mag(const volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float rg[2], Rt[3][3], Bn[3], mf[3], ab[3], mh[3], xv[3], crs3[3];
    float fp[3], mh2[3], crs4[3], b0v[3], up_nav[3];
    float bb[3], e1[3], e2[3], r2v[2], RRv[4];   /* VER=103 ÕæÇ£ÒıÓÃ */
    float fhb2, ci, b0x, b0y, b0z;
    float dpar, mhn, xvn, thm, thp, psih, dp2, mh2n, an2, cc;
    uint8_t st;
    uint32_t i;

    /* ¡ïVER=89 ÏÈÇåÁã£º±¾º¯ÊıÓĞ 8 ÌõÌáÇ°·µ»ØÂ·¾¶(Á¿¸ÙÊØÎÀ/¼¸ºÎËÀµã/mh2 ÊØÎÀ/Î»ÒÆËÀÇø/
     *   Çã½Ç²Î¿¼ÔİÍ£/Ñù±¾Î´¸üĞÂ¡­)£¬¾É°æÖ»ÔÚÆäÖĞ 2 ÌõÀïÇåÁã£¬ÆäÓà°ÑÉÏÒ»ÖÜÆÚµÄÖµÁô½ø
     *   Ò£²â ¡ª¡ª Êµ²â mag_dqz Òò´Ë³¤ÆÚÏÔÊ¾Ò»¸ö²¢²»´æÔÚµÄ³£Á¿×¢Èë(Ô¼ 0.1745 ¶È/ÖÜÆÚ£¬
     *   0.5 s ÀÛ»ı 60.9 ¶È)£¬¾İ´ËÔøÎóÅĞ"´ÅÔÚ¾çÁÒ¶Î×¢Èë 143 ¶È/s"¡£
     *   ÇåÁã·ÅÔÚÈë¿ÚÃÅÖ®Ç°£ºÃÅ¹ØÊ±"±¾ÖÜÆÚ´ÅĞŞÕıÁ¿"±¾À´¾ÍÊÇ 0£¬ÕâÊÇÊÂÊµ²»ÊÇ²¹¶¡¡£ */
    s_mag_dqx = 0.0f; s_mag_dqy = 0.0f; s_mag_dqz = 0.0f;
    if (!V5F_EKF_YAW_OBS_EN || !gate->ekf_mag_yaw) return;
    s_mag_hold = 0u;                    /* ¡ïVER=84 */
    for (i = 0u; i < 3u; i++) mf[i] = h->mag.f[i];
    /* ¡ïVER=72 Á¿¸ÙÊØÎÀ */
    {
        float f2 = mf[0]*mf[0] + mf[1]*mf[1] + mf[2]*mf[2];
        if (f2 < 0.25f || f2 > 2.25f) {
            if (s_rej[3] < 250u) s_rej[3]++;
            s_gate_bits |= V5F_EKF_GB_CHI2;
            return;
        }
    }
    fhb2 = h->mag.f[0]*h->mag.f[0] + h->mag.f[1]*h->mag.f[1];
    s_mag_fhb = sqrtf(fhb2);
    /* ¡ïVER=45 ²¹Ñù±¾³Â¾É */
    {
        float am = sqrtf(s_mag_dth[0]*s_mag_dth[0] + s_mag_dth[1]*s_mag_dth[1]
                       + s_mag_dth[2]*s_mag_dth[2]);
        if (am > 1e-4f) {
            float half = 0.5f * am;
            float sc = sinf(half) / am;
            float dq[4];
            float tmp[3];
            dq[0] = cosf(half);
            dq[1] = -sc * s_mag_dth[0];
            dq[2] = -sc * s_mag_dth[1];
            dq[3] = -sc * s_mag_dth[2];
            q_rot_vec(dq, mf, tmp);
            mf[0] = tmp[0]; mf[1] = tmp[1]; mf[2] = tmp[2];
        }
    }
    ci  = 1.0f / sqrtf(1.0f + V5F_EKF_DIP_TAN * V5F_EKF_DIP_TAN);
    b0x = ci * sinf(V5F_MAG_DECL_RAD);
    b0y = ci * cosf(V5F_MAG_DECL_RAD);
    b0z = -V5F_EKF_DIP_TAN * ci;
    /* ¡ïVER=84 R º¬Çã½Ç²»È·¶¨¶ÈÏî£º´ÅĞÂÏ¢¶ÔÇã½ÇÎó²îµÄÁéÃô¶È =
     * tan(dip) = V5F_EKF_DIP_TAN = 2.08£¬ËùÒÔ sigma_tilt »áÒÔ 2.08 ±¶»ì½øÆ«º½ĞÂÏ¢¡£ */

    /* ---- ¼¸ºÎÕï¶Ï£¨µ¼º½ÏµË®Æ½¶şÎ¬²Ğ²î£»¶¨Òå²»±ä£¬¹©ÈÕÖ¾ÓëÕû½Ç¶ÔÆëÓÃ£© ---- */
    q_to_R(&s_x[IX_Q], Rt);
    rot_bn(Rt, mf, Bn);
    s_mag_bh = sqrtf(Bn[0]*Bn[0] + Bn[1]*Bn[1]);
    s_mag_vx = Bn[0]; s_mag_vy = Bn[1];
    s_mag_v0x = b0x; s_mag_v0y = b0y;
    rg[0] = Bn[0] - b0x;
    rg[1] = Bn[1] - b0y;
    s_mag_rx = rg[0];
    s_mag_ry = rg[1];
    /* ¡ïVER=81 ÒÑÉ¾³ı¼¸ºÎËÀµã BH_MIN£ºËüµÄ´¥·¢Ìõ¼şÊÇ"ÖØÁ¦·¨ÏòÓë´Å±±ÖØºÏ"
     * £¨¼´µ½ÁËÕæ´Å¼«£©£¬±¾Î³¶È´ÅÇã 64.3 ¶È¡¢Ë®Æ½·ÖÁ¿ºã 0.4333£¬²»¿ÉÄÜ·¢Éú¡£ */

    /* ---- ¡ïVER=80 ÖØÁ¦·¨ÏòÖ±½ÓÓÉ**ÒÑÖª×ËÌ¬**½â³ö ----
     * a_up = R(q_hat)^T . z_nav = »úÌåÏµÀïµÄ"ÉÏ"¡£
     * ²»ÔÙÓÃ¼Ó¼Æ£¨ÔË¶¯Ê±Ëü±¥ºÍ£¬Êµ²â |a| µ½ 16.8 g£¬·½ÏòÊÇÀ¬»ø£©£¬
     * Ò²²»ÔÙ×Ô¼º¹¹Ôì R_tilt¡£²âÁ¿ÓëÔ¤²â¶¼½¨Á¢ÔÚÕâÍ¬Ò»¸ù a_up ÉÏ£¬
     * ÓÚÊÇÇã½ÇÎó²îÔÚÁ½±ßÒ»ÖÂµØ³öÏÖ£¬Ã»ÓĞ"²âÁ¿ÓÃ¼Ó¼Æ/Ô¤²âÓÃ×ËÌ¬"µÄ²»¶Ô³Æ¡£ */
    up_nav[0] = 0.0f; up_nav[1] = 0.0f; up_nav[2] = 1.0f;
    rot_nb(Rt, up_nav, ab);
    /* ¡ïVER=81 ²»ÔÙÉè"Çã½Ç¿ÉĞÅ"ÃÅ£ºÍ¶Ó°ÖáÈ¡µÄÊÇ**×ËÌ¬×Ô¼º**µÄÖØÁ¦·¨Ïò
     * a_up = R(q_hat)^T z_nav£¨¶àÂ·¾¶ÈÚºÏµÄ×îÓÅÖµ£©£¬²âÁ¿ÓëÔ¤²â¶¼ÒÑÍ¶µ½¸ÃÆ½ÃæÄÚ£¬
     * Á½ÏòÁ¿Í¬´¦Ò»¸öÆ½Ãæ£¬Ê§ÅäÖ»ÄÜÊÇÈÆ a_up µÄĞı×ª = Æ«º½´í¡£Çã½Ç´íÔÚÕâÒ»²½
     * ÒÑ¾­±»Í¶Ó°ÏûµôÁË£¬²»ĞèÒªÔÙÀ´Ò»µÀÃÅ¡£ */
    /* Õï¶Ï£º×ËÌ¬µÄ"ÉÏ"Óë¼Ó¼Æ·½Ïò¼Ğ½Ç£¨¶ÈÊı£©¡ª¡ª ¹Û²â¿É²»¿ÉĞÅµÄÖ±½Ó¶ÁÊı */
    an2 = sqrtf(h->imu.accel_g[0]*h->imu.accel_g[0]
              + h->imu.accel_g[1]*h->imu.accel_g[1]
              + h->imu.accel_g[2]*h->imu.accel_g[2]);
    if (an2 > 1e-6f) {
        cc = (ab[0]*h->imu.accel_g[0] + ab[1]*h->imu.accel_g[1]
            + ab[2]*h->imu.accel_g[2]) / an2;
        if (cc >  1.0f) cc =  1.0f;
        if (cc < -1.0f) cc = -1.0f;
        s_mag_cmp_amn = acosf(cc) * RAD2DEG;
    }

    /* ²âÁ¿´Å³¡ÔÚ·¨Æ½ÃæÄÚµÄ·ÖÁ¿ */
    dpar = mf[0]*ab[0] + mf[1]*ab[1] + mf[2]*ab[2];
    mh[0] = mf[0] - dpar*ab[0];
    mh[1] = mf[1] - dpar*ab[1];
    mh[2] = mf[2] - dpar*ab[2];
    mhn = sqrtf(mh[0]*mh[0] + mh[1]*mh[1] + mh[2]*mh[2]);
    s_mag_cmp_mhn = mhn;
    /* ²Î¿¼£º»úÌå x ÖáÔÚÍ¬Ò»Æ½ÃæÄÚµÄÍ¶Ó° */
    xv[0] = 1.0f - ab[0]*ab[0];
    xv[1] =      - ab[0]*ab[1];
    xv[2] =      - ab[0]*ab[2];
    xvn = sqrtf(xv[0]*xv[0] + xv[1]*xv[1] + xv[2]*xv[2]);
    if (mhn < 1e-3f || xvn < 1e-3f) {
        if (s_rej[3] < 250u) s_rej[3]++;
        s_gate_bits |= V5F_EKF_GB_CHI2;
        return;
    }
    crs3[0] = ab[1]*mh[2] - ab[2]*mh[1];
    crs3[1] = ab[2]*mh[0] - ab[0]*mh[2];
    crs3[2] = ab[0]*mh[1] - ab[1]*mh[0];
    thm = atan2f((crs3[0]*xv[0] + crs3[1]*xv[1] + crs3[2]*xv[2]) / (mhn*xvn),
                 (mh[0]*xv[0] + mh[1]*xv[1] + mh[2]*xv[2]) / (mhn*xvn));

    /* Ô¤²â´Å³¡£ºÍ¬Ò»×ËÌ¬¡¢Í¬Ò»¸ù a_up */
    b0v[0] = b0x; b0v[1] = b0y; b0v[2] = b0z;
    rot_nb(Rt, b0v, fp);
    dp2 = fp[0]*ab[0] + fp[1]*ab[1] + fp[2]*ab[2];
    mh2[0] = fp[0] - dp2*ab[0];
    mh2[1] = fp[1] - dp2*ab[1];
    mh2[2] = fp[2] - dp2*ab[2];
    mh2n = sqrtf(mh2[0]*mh2[0] + mh2[1]*mh2[1] + mh2[2]*mh2[2]);
    if (mh2n < 1e-3f) {
        if (s_rej[3] < 250u) s_rej[3]++;
        s_gate_bits |= V5F_EKF_GB_CHI2;
        return;
    }
    crs4[0] = ab[1]*mh2[2] - ab[2]*mh2[1];
    crs4[1] = ab[2]*mh2[0] - ab[0]*mh2[2];
    crs4[2] = ab[0]*mh2[1] - ab[1]*mh2[0];
    thp = atan2f((crs4[0]*xv[0] + crs4[1]*xv[1] + crs4[2]*xv[2]) / (mh2n*xvn),
                 (mh2[0]*xv[0] + mh2[1]*xv[1] + mh2[2]*xv[2]) / (mh2n*xvn));
    s_mag_cmp_thm = thm * RAD2DEG;
    s_mag_cmp_thp = thp * RAD2DEG;
    {
        float qw = s_x[IX_Q], qx = s_x[IX_Q+1], qy = s_x[IX_Q+2], qz = s_x[IX_Q+3];
        psih = atan2f(2.0f*(qw*qz + qx*qy), 1.0f - 2.0f*(qy*qy + qz*qz));
        s_mag_yawpre = psih * RAD2DEG;
    }

    /* H Ö»ÓĞÆ«º½Ïî */
    H_zero(1u);
    s_H[0][8] = 1.0f;

    /* ¡ïVER=62 ¿ª»ú´°ÄÚÒ»´Î¾«È·½ÇÕû½ÇĞŞÕı£¨ÓÃ¼¸ºÎ²Ğ²î rg£© */
    if (s_boot_t < V5F_EKF_MAG_ANCHOR_TS) {
        float n2 = b0x * b0x + b0y * b0y;
        float dpsi = 0.0f, e0, e1, h2;
        float qb[4], dq[4], qt[4];
        uint32_t i2;
        e0 = sqrtf(rg[0] * rg[0] + rg[1] * rg[1]);
        if (n2 > 1e-6f) {
            float crs = b0x * rg[1] - b0y * rg[0];
            float dt2 = b0x * rg[0] + b0y * rg[1] + n2;
            dpsi = atan2f(crs, dt2);
        }
        if (dpsi >  3.14159265f) dpsi =  3.14159265f;
        if (dpsi < -3.14159265f) dpsi = -3.14159265f;
        for (i2 = 0u; i2 < 4u; i2++) qb[i2] = s_x[IX_Q + i2];
        h2 = 0.5f * dpsi;
        dq[0] = cosf(h2); dq[1] = 0.0f; dq[2] = 0.0f; dq[3] = sinf(h2);
        q_mul(dq, &s_x[IX_Q], qt);
        for (i2 = 0u; i2 < 4u; i2++) s_x[IX_Q + i2] = qt[i2];
        q_norm(&s_x[IX_Q]);
        q_to_R(&s_x[IX_Q], Rt);
        rot_bn(Rt, mf, Bn);
        {
            float rx2 = Bn[0] - b0x, ry2 = Bn[1] - b0y;
            e1 = sqrtf(rx2 * rx2 + ry2 * ry2);
        }
        if (e1 > e0) {
            for (i2 = 0u; i2 < 4u; i2++) s_x[IX_Q + i2] = qb[i2];
            h2 = -0.5f * dpsi;
            dq[0] = cosf(h2); dq[1] = 0.0f; dq[2] = 0.0f; dq[3] = sinf(h2);
            q_mul(dq, &s_x[IX_Q], qt);
            for (i2 = 0u; i2 < 4u; i2++) s_x[IX_Q + i2] = qt[i2];
            q_norm(&s_x[IX_Q]);
            dpsi = -dpsi;
        }
        s_mag_anchor = 1u;
        s_mag_used = 1u;
        s_mag_dqx = 0.0f; s_mag_dqy = 0.0f; s_mag_dqz = dpsi * RAD2DEG;
        s_gate_bits |= V5F_EKF_GB_MAG;
        rg[0] = 0.0f; rg[1] = 0.0f;
        s_mag_rx = 0.0f; s_mag_ry = 0.0f;
        s_mag_r = 0.0f;
        return;
    }

    /* ---- VER=103 ÕæÇ£Òı£º»úÌåÏµ²Ğ²î£¨²»×öÈÎºÎ×ËÌ¬Í¶Ó°£©-------------------- */
    {
        float n1, c1, sg2, ddip, conf, Sx[3][3];
        float gn_b[3];
        uint32_t ax2;
        bb[0] = Rt[0][0]*b0x + Rt[1][0]*b0y + Rt[2][0]*b0z;
        bb[1] = Rt[0][1]*b0x + Rt[1][1]*b0y + Rt[2][1]*b0z;
        bb[2] = Rt[0][2]*b0x + Rt[1][2]*b0y + Rt[2][2]*b0z;
        n1 = sqrtf(bb[0]*bb[0] + bb[1]*bb[1] + bb[2]*bb[2]);
        if (n1 < 1e-6f) return;
        bb[0] /= n1; bb[1] /= n1; bb[2] /= n1;
        c1 = mf[0]*bb[0] + mf[1]*bb[1] + mf[2]*bb[2];
        /* r = P_¡Í m^ = m^ - (m^¡¤b^)b^  £¨µÈÓÚ (I - b^b^T)(m^ - b^)£©
         * ×¢Òâ²»ÄÜĞ´³É (m^ - b^) - (m^¡¤b^)b^£ºÄÇ¶à¼õÁËÒ»¸ö b^£¬
         * ËäÈ»ÔÙÍ¶Ó°µ½ ¡Íb^ ºóÊıÖµ±»Ïûµô£¬µ« H ¾Í²»ÔÙÊÇËüµÄ Jacobian£¨²»×ÔÇ¢£©¡£ */
        /* ¡Íb^ Æ½ÃæÕı½»»ù£ºe1 = normalize(z^ x b^)£¬e2 = b^ x e1 */
        /* ---- VER=107 ÃæÄÚ»ù£ºÊúÖ±»ù×¼ = **ÖØÁ¦Ê¸Á¿**£¨²»¼ÙÉè¼Ğ¾ßË®Æ½£©----
         * e1 = normalize(gn ¡Á b^_b)£ºÈÆÖØÁ¦Ğı×ª = º½Ïò±ä»¯£¬ËüÔÚ ¡Íb^ ÃæÄÚµÄÔË¶¯·½Ïò¡£
         *   Æä**·½Ïò**Ö»È¡¾öÓÚ (gn, b^_b) ËùÔÚÆ½ÃæµÄ·¨Ïò => Óë´ÅÇã½ÇÄ£ĞÍÎó²îÎŞ¹Ø
         *   £¨Êµ²â±í¹Û dip Ëæ»·¾³/Î»ÖÃ±ä 2~3 ¶È£¬ËùÒÔÆ«º½Í¨µÀ±ØĞëÓë dip ½âñî£©¡£
         * e2 = b^_b ¡Á e1£ºÁíÒ»¸öÃæÄÚ·½Ïò£¬Ğ¯´ø**ÇãĞ±**ĞÅÏ¢¡£ */
        {
            float ag = sqrtf(h->imu.accel_g[0]*h->imu.accel_g[0]
                           + h->imu.accel_g[1]*h->imu.accel_g[1]
                           + h->imu.accel_g[2]*h->imu.accel_g[2]);
            if (ag < 1e-3f) return;
            gn_b[0] = h->imu.accel_g[0] / ag;
            gn_b[1] = h->imu.accel_g[1] / ag;
            gn_b[2] = h->imu.accel_g[2] / ag;
        }
        e1[0] = gn_b[1]*bb[2] - gn_b[2]*bb[1];
        e1[1] = gn_b[2]*bb[0] - gn_b[0]*bb[2];
        e1[2] = gn_b[0]*bb[1] - gn_b[1]*bb[0];
        n1 = sqrtf(e1[0]*e1[0] + e1[1]*e1[1] + e1[2]*e1[2]);
        if (n1 < 1e-4f) {                     /* ÖØÁ¦Óë´Å³¡½üÆ½ĞĞ£¨²»¸Ã·¢Éú£©£ºÍË»Ø z^ »ù×¼ */
            e1[0] = -bb[1]; e1[1] = bb[0]; e1[2] = 0.0f;
            n1 = sqrtf(e1[0]*e1[0] + e1[1]*e1[1]);
            if (n1 < 1e-6f) { e1[0] = 1.0f; e1[1] = 0.0f; e1[2] = 0.0f; n1 = 1.0f; }
        }
        e1[0] /= n1; e1[1] /= n1; e1[2] /= n1;
        e2[0] = bb[1]*e1[2] - bb[2]*e1[1];
        e2[1] = bb[2]*e1[0] - bb[0]*e1[2];
        e2[2] = bb[0]*e1[1] - bb[1]*e1[0];
        r2v[0] = e1[0]*mf[0] + e1[1]*mf[1] + e1[2]*mf[2];   /* º½ÏòÃô¸Ğ·ÖÁ¿ */
        r2v[1] = e2[0]*mf[0] + e2[1]*mf[1] + e2[2]*mf[2];   /* ÇãĞ±Ãô¸Ğ·ÖÁ¿ */
        s_mag_r  = atan2f(sqrtf(r2v[0]*r2v[0] + r2v[1]*r2v[1]), c1) * RAD2DEG;
        s_mag_rx = r2v[0] * RAD2DEG;
        s_mag_ry = r2v[1] * RAD2DEG;
        /* H_i = +e_i^T [b^_b]x R^T£¨±ê×¼ĞÎÊ½ H = dh/dx£»»ùÔÚµ±Ç°¹À¼Æ´¦¶³½á£© */
        H_zero(2u);
        Sx[0][0] = 0.0f;   Sx[0][1] = -bb[2]; Sx[0][2] =  bb[1];
        Sx[1][0] = bb[2];  Sx[1][1] = 0.0f;   Sx[1][2] = -bb[0];
        Sx[2][0] = -bb[1]; Sx[2][1] = bb[0];  Sx[2][2] = 0.0f;
        for (ax2 = 0u; ax2 < 3u; ax2++) {
            float w0, w1, w2;
            w0 = Sx[0][0]*Rt[ax2][0] + Sx[0][1]*Rt[ax2][1] + Sx[0][2]*Rt[ax2][2];
            w1 = Sx[1][0]*Rt[ax2][0] + Sx[1][1]*Rt[ax2][1] + Sx[1][2]*Rt[ax2][2];
            w2 = Sx[2][0]*Rt[ax2][0] + Sx[2][1]*Rt[ax2][1] + Sx[2][2]*Rt[ax2][2];
            s_H[0][IX_Q + ax2] = e1[0]*w0 + e1[1]*w1 + e1[2]*w2;
            s_H[1][IX_Q + ax2] = e2[0]*w0 + e2[1]*w1 + e2[2]*w2;
        }
        /* ---- ÇãĞ±È¨µÄÖÃĞÅ¶È£ºÁ½Õß¶¼ÓÃ**ÖØÁ¦**×öÊúÖ±»ù×¼ ----
         * dip_m = 90 - angle(m^, gn)£¨Óë×ËÌ¬ÎŞ¹Ø¡¢Óë¼Ğ¾ßÊÇ·ñË®Æ½ÎŞ¹Ø£©£»
         * ddip = |dip_m - Ä£ĞÍÇã½Ç|£»»·¾³»û±ä/Ä£ĞÍÊ§ÅäÔ½´ó -> c Ô½Ğ¡ -> ÇãĞ±ĞĞ R Ô½´ó¡£
         * ¸É¾»»·¾³ ddip->0 => c->1 => ´ÅµÄÇãĞ±ĞÅÏ¢°´ sigma_yaw Õı³£Ê¹ÓÃ¡£ */
        {
            float cm = mf[0]*gn_b[0] + mf[1]*gn_b[1] + mf[2]*gn_b[2];
            float dip_m, dip_0;
            if (cm >  1.0f) cm =  1.0f;
            if (cm < -1.0f) cm = -1.0f;
            /* ç£åœºæœä¸‹æ—¶ angle(m^,gn) = 90 + Iï¼Œæ‰€ä»¥ dip_m = angle - 90ï¼ˆ= +Iï¼‰ï¼›
             * å†™æˆ 90 - angle ä¼šå¾— -57 åº¦ï¼Œä½¿ä¿¡åº¦æ°¸è¿œå‹åˆ°ä¸‹é™ */
            dip_m = acosf(cm) * RAD2DEG - 90.0f;
            dip_0 = atanf(V5F_EKF_DIP_TAN) * RAD2DEG;
            ddip  = fabsf(dip_m - dip_0);
            conf  = 1.0f / (1.0f + (ddip / V5F_EKF_MAG_TILT_DDIP_REF_DEG)
                                   * (ddip / V5F_EKF_MAG_TILT_DDIP_REF_DEG));
            if (conf < V5F_EKF_MAG_TILT_CONF_MIN) conf = V5F_EKF_MAG_TILT_CONF_MIN;
        }
        sg2 = V5F_EKF_MAG_VEC_SIG_DEG * DEG2RAD;
        RRv[0] = sg2 * sg2;                       /* º½ÏòĞĞ£º¸ßÖÃĞÅ */
        RRv[1] = 0.0f; RRv[2] = 0.0f;
        {
            float st = V5F_EKF_MAG_VEC_SIG_TILT_DEG / conf;
            if (st < V5F_EKF_MAG_VEC_SIG_DEG) st = V5F_EKF_MAG_VEC_SIG_DEG;
            if (st > V5F_EKF_MAG_VEC_TILT_SIG_MAX_DEG) st = V5F_EKF_MAG_VEC_TILT_SIG_MAX_DEG;    /* ÇãĞ±ĞĞ£º°´ÖÃĞÅ¶È½µÈ¨ */
            RRv[3] = (st * DEG2RAD) * (st * DEG2RAD);
            s_mag_rs = (1.0f / conf) * (1.0f / conf);
        }
    }

    /* ---- VER=103 ¹²ÓÃÃÅ£º²Ğ²îÉÏÏŞ + Í¬Ò»´ÅÑù±¾²»ÖØ¸´¸üĞÂ -------------------
     * **²»ÔÙÓĞ"ÔË¶¯ÖĞ½û´Å"**£ººÏ·¨ĞÔÓÉÍâÃÅ¸ø£¨gate->ekf_mag_yaw = |mag_norm-1| < MAG_ERR_LIM£¬Ö»¿´Ä££©£»
     * ÕâÀïÖ»Ê£²Ğ²îÌ«´ó(>R_MAX)¾ÜÒ»´Î¡¢ÒÔ¼°Í¬Ò»¸ö´ÅÑù±¾²»ÖØ¸´¸üĞÂ£¨´Å ~190Hz vs Ö¡ 335Hz£©¡£ */
    if (s_mag_r > V5F_EKF_MAG_R_MAX_DEG) {
        if (s_rej[3] < 250u) s_rej[3]++;
        s_gate_bits |= V5F_EKF_GB_CHI2;
        return;
    }
    {
        uint32_t icm = g_shm ? g_shm->ist.hdr.cnt : 0u;
        if (icm == s_mag_cnt_upd) {
            s_mag_dqx = 0.0f; s_mag_dqy = 0.0f; s_mag_dqz = 0.0f;
            return;
        }
        s_mag_cnt_upd = icm;
    }

    /* ---------------- Ä£Ê½ 1£ºÕæÇ£Òı£¨2 Î¬ÏòÁ¿Á¿²â£© ---------------- */
    st = ekf_update(RRv, 2u, r2v, V5F_EKF_NIS_MAX_MAG, &s_nis[4], &s_rej[3],
                    0x01C0u, V5F_EKF_MAG_VEC_K_MAX);
    if (st == 0u) {
        s_gate_bits |= V5F_EKF_GB_MAG;
        s_mag_used = 1u;
        s_mag_dqx = s_dx[IX_Q + 0] * RAD2DEG;
        s_mag_dqy = s_dx[IX_Q + 1] * RAD2DEG;
        s_mag_dqz = s_dx[IX_Q + 2] * RAD2DEG;
    } else {
        s_mag_dqx = 0.0f; s_mag_dqy = 0.0f; s_mag_dqz = 0.0f;
    }

}

/* M1 Ë®Æ½Î»ÖÃ£¨2 Î¬£¬°´ V5F_EKF_POS_PERIOD_S ½µÆµ£©+ M2 ¸ß¶È£¨1 Î¬£© */
static void ekf_m1m2_gps(const volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float R[4], r[2], rb[2], rw;
    uint8_t st;
    int32_t dla, dlo;

    if (!s_gps_new) return;

    if (gate->ekf_gps_pos && s_origin_ok && s_pos_wait >= V5F_EKF_POS_PERIOD_S) {
        dla = h->gps_rmc.lat_e7 - s_lat0_e7;
        dlo = h->gps_rmc.lon_e7 - s_lon0_e7;
        rb[0] = (float)dlo * 1e-7f * s_m_per_deg_lon;      /* ¶« */
        rb[1] = (float)dla * 1e-7f * s_m_per_deg_lat;      /* ±± */
        H_zero(2u);
        s_H[0][0] = 1.0f; s_H[1][1] = 1.0f;
        rw = 1.0f;
        if (h->gps_gsv.snr_n > 0u && h->gps_gsv.snr_avg_dbhz > 1.0f) {
            float ratio = V5F_EKF_C_N0_REF_DBHZ / h->gps_gsv.snr_avg_dbhz;
            rw = ratio * ratio;
            if (rw < 1.0f) rw = 1.0f;
            if (rw > 9.0f) rw = 9.0f;
        }
        R[0] = V5F_GPS_POS_R_H_M * V5F_GPS_POS_R_H_M * rw;
        R[1] = 0.0f; R[2] = 0.0f; R[3] = R[0];
        r[0] = rb[0] - s_x[IX_P + 0u];
        r[1] = rb[1] - s_x[IX_P + 1u];
        st = ekf_update(R, 2u, r, V5F_EKF_NIS_MAX_2, &s_nis[0], &s_rej[4], 0x0E3Fu, 0.05f);
        if (st == 0u) { s_gate_bits |= V5F_EKF_GB_GPS_POS; s_pos_wait = 0.0f; }
    }

    /* GPS ¸ß¶È±ØĞëÓëÎ»ÖÃÒ»Æğ½µÆµ£ºËüºÍË®Æ½Î»ÖÃÊÇ**Í¬Ò»Ìõ½ÓÊÕ»ú½âËã**³öÀ´µÄ£¬
     * Îó²îÍ¬ÑùÊÇ 5 s ÒÔÉÏÏà¹ØÊ±¼äµÄÂıËæ»úÓÎ×ß£¨Ë®Æ½Êµ²â lag1 ×ÔÏà¹Ø 0.999£©£¬
     * °´Ã¿¸öÀúÔªÎ¹¾ÍÊÇÈÃ R=(5.5 m)^2 Ãû²»¸±Êµ¡¢ÍµÍµ¸ø´¹Ö±Í¨µÀ³¬ÅäÈ¨ÖØ ¡ª¡ª
     * ÓëÆøÑ¹Ô­À´ÄÇ¸ö´íÍêÈ«Í¬Àà¡£ */
    if (gate->ekf_gps_alt && s_alt_wait >= V5F_EKF_POS_PERIOD_S) {
        H_zero(1u);
        s_H[0][2] = 1.0f;
        R[0] = V5F_GPS_ALT_R_M * V5F_GPS_ALT_R_M;
        r[0] = h->gps_gga.alt_m - s_x[IX_P + 2];
        st = ekf_update(R, 1u, r, V5F_EKF_NIS_MAX_1, NULL, &s_rej[4], 0x8024u, 0.05f);
        if (st == 0u) { s_gate_bits |= V5F_EKF_GB_GPS_ALT; s_alt_wait = 0.0f; }
    }
}

/* M4 ¶àÆÕÀÕËÙ¶È£¨2 Î¬£ºspeed Óë course Í¬Ô´£¬²»Ğí²ğ³ÉÁ½¸ö¹Û²â£© */
static void ekf_m4_vel(const volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float R[4], r[2], cr, sp;
    uint8_t st;

    if (!gate->ekf_gps_vel || !s_gps_new) return;
    cr = h->gps_rmc.course_deg * DEG2RAD;
    sp = h->gps_rmc.speed_mps;
    H_zero(2u);
    s_H[0][3] = 1.0f; s_H[1][4] = 1.0f;
    R[0] = V5F_GPS_VEL_R_MPS * V5F_GPS_VEL_R_MPS;
    R[1] = 0.0f; R[2] = 0.0f; R[3] = R[0];
    r[0] = sp * sinf(cr) - s_b_dop - s_x[IX_V + 0u];
    r[1] = sp * cosf(cr) - s_b_dop - s_x[IX_V + 1u];
    st = ekf_update(R, 2u, r, V5F_EKF_NIS_MAX_2, &s_nis[1], &s_rej[1], 0x0E18u, 0.05f);
    if (st == 0u) s_gate_bits |= V5F_EKF_GB_GPS_VEL;
}

/* ---------------------------------------------------------------------------
 * ±ê³ÆÍÆ½ø + ½¨ F
 * ------------------------------------------------------------------------- */
static void ekf_step_nominal(void)
{
    float R[3][3], dvn[3], an[3], dv[3];
    float qn[4];
    uint32_t i, j;

    q_to_R(&s_x[IX_Q], R);
    for (i = 0u; i < 3u; i++) dv[i] = s_dvb[i] - s_x[IX_BA + i] * s_dt_e;
    rot_bn(R, dv, dvn);
    for (i = 0u; i < 3u; i++) {
        dv[i] = dvn[i] + ((i == 2u) ? (-V5F_EKF_G_MPS2 * s_dt_e) : 0.0f);
    }
    /* ---- Ë®Æ½ËÙ¶ÈËÀÇø£¨µ²"ÖØÁ¦¾­Çã½ÇÎó²îÂ©½øË®Æ½¼ÓËÙ¶È"µÄ³£ÖµÆ«ÖÃ£©----
     * Õâ¸öÆ«ÖÃ g*dtheta_h ÓëÕæÊµ³£Öµ¼ÓËÙ¶ÈÔÚ¹Û²âÉÏ²»¿É·Ö£¬ËùÒÔÖ»ÄÜ°´Á¿¼¶È¡Éá£º
     * Ğ¹Â©Ôì³É**ÎŞ½çÔö³¤**µÄËÙ¶ÈÎó²î£¬¶ø±»³ÔµôµÄÕæÊµĞ¡¼ÓËÙ¶ÈÊÇ**Ë²Ì¬**µÄ
     * £¨ĞüÍ£Ê±Ë®Æ½¼ÓËÙ¶È±¾¾Í½ü 0£©¡£ËÀÇøËæÂË²¨Æ÷×Ô¼ºµÄÇã½Ç²»È·¶¨¶ÈÕı±ÈÀıËõ·Å£¬
     * ÓÚÊÇ"Çã½ÇÔ½²»¿ÉĞÅ -> ËÙ¶ÈÍ¨µÀÔ½²»Ãô¸Ğ"£¬×ÔÇ¢¡£
     * ¡ï Ö»¸Ä¹À¼Æ£¬²»¸ÄĞ­·½²î£ºQ_vv ÀïÄÇÒ»Ïî¼ÌĞøÈÃ sigma_v ³ÏÊµÔö³¤¡£ */
    if (V5F_EKF_VDEAD_K > 0.0f) {
        float td = V5F_EKF_VDEAD_K * V5F_EKF_G_MPS2
                 * sqrtf(s_Pn[6][6] + s_Pn[7][7]) * s_dt_e;   /* ±¾ÖÜÆÚ¶ÔÓ¦µÄ dv ÃÅÏŞ */
        for (i = 0u; i < 2u; i++) {
            if (dv[i] < td && dv[i] > -td) dv[i] = 0.0f;
        }
    }
    /* ---- Â·¾¶ B£ºËÙ¶ÈĞ¹Â©£¨Ö»×÷ÓÃÓÚË®Æ½Á½Öá£©----
     * lambda = K*sigma_tilt£¬¼´ tau = 1/(K*sigma_tilt)¡£×ËÌ¬¿ÉĞÅÊ± tau ºÜ´ó
     * £¨¼¸ºõ²»¸ÉÔ¤£¬±£×¡ÂıËÙÆ½ÒÆ¾«¶È£©£»×ËÌ¬²»¿ÉĞÅÊ± tau ±äĞ¡£¬°Ñ"ÖØÁ¦¾­Çã½Ç
     * Îó²îÂ©½ø¼ÓËÙ¶È"Ôì³ÉµÄ**ÎŞ½ç**Æ¯ÒÆÏŞ³ÉÓĞ½ç£¨ÎÈÌ¬Îó²î = b*tau£©¡£
     * ÓëËÀÇøµÄ±¾ÖÊÇø±ğ£ºÕâÀï²»¿³ÈÎºÎµ¥Ö¡ĞÅÏ¢£¬Ö»¸øËÙ¶ÈÒ»¸öÓë²»È·¶¨¶ÈÆ¥ÅäµÄÂ©¡£ */
    if (V5F_EKF_VLEAK_K > 0.0f) {
        float stg = sqrtf(s_Pn[6][6] + s_Pn[7][7]);      /* Çã½Ç 1sigma£¬rad */
        float lam = V5F_EKF_VLEAK_K * stg;
        float lam_min = 1.0f / V5F_EKF_VLEAK_TAU_MAX_S;
        if (lam < lam_min) lam = lam_min;
        for (i = 0u; i < 2u; i++) {
            dv[i] -= s_x[IX_V + i] * lam * s_dt_e;
        }
    }
    for (i = 0u; i < 3u; i++) an[i] = dv[i] / s_dt_e;
    for (i = 0u; i < 3u; i++) {
        s_x[IX_P + i] += s_x[IX_V + i] * s_dt_e + 0.5f * an[i] * s_dt_e * s_dt_e;
    }
    for (i = 0u; i < 3u; i++) s_x[IX_V + i] += dv[i];
    for (i = 0u; i < 3u; i++) s_a_nav[i] = an[i];

    /* ×ËÌ¬£ºq <- q (x) s_dq¡£s_dq ÊÇÕâ 16 Ö¡**ÖğÖ¡¸´ºÏ**³öÀ´µÄËÄÔªÊıÔöÁ¿£¬
     * ²»ÊÇ°ÑÖá½ÇÊ¸Á¿Ïà¼Ó£¨ÄÇÑùÈıÖáÍ¬Ê±×ª¶¯»á²úÉúÔ²×¶Îó²î -> Æ«º½´óÎó²î£©¡£ */
    q_mul(&s_x[IX_Q], s_dq, qn);
    for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = qn[i];
    q_norm(&s_x[IX_Q]);

    /* F = I + A dt */
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) s_F[i][j] = 0.0f;
        s_F[i][i] = 1.0f;
    }
    for (i = 0u; i < 3u; i++) s_F[IX_P + i][IX_V + i] = s_dt_e;   /* dp' = dv */

    q_to_R(&s_x[IX_Q], R);
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) s_Rn[i][j] = R[i][j];
    }
    {
        float fb[3], fnv[3];
        for (i = 0u; i < 3u; i++) fb[i] = s_dvb[i]/s_dt_e - s_x[IX_BA + i];
        /* |a_lin|£¨g£©£ºÕûÁ÷Îó²î ~ k_rect*|a_lin|£¬×÷Îª×ËÌ¬¹ı³ÌÔëÉùµÄÀ´Ô´ */
        s_alin_g = sqrtf(fb[0]*fb[0] + fb[1]*fb[1] + fb[2]*fb[2]) / V5F_EKF_G_MPS2;
        rot_bn(R, fb, fnv);
        s_Rf[0][0] = 0.0f;    s_Rf[0][1] = -fnv[2]; s_Rf[0][2] =  fnv[1];
        s_Rf[1][0] = fnv[2];  s_Rf[1][1] = 0.0f;    s_Rf[1][2] = -fnv[0];
        s_Rf[2][0] = -fnv[1]; s_Rf[2][1] = fnv[0];  s_Rf[2][2] = 0.0f;
    }
    for (i = 0u; i < 3u; i++) {
        for (j = 0u; j < 3u; j++) {
            s_F[IX_V + i][IX_Q  + j] = -s_Rf[i][j] * s_dt_e;
            s_F[IX_V + i][IX_BA + j] = -s_Rn[i][j] * s_dt_e;
            s_F[IX_Q + i][IX_BG + j] = -s_Rn[i][j] * s_dt_e;
        }
    }
    s_dt_prev = s_dt_e;
    s_F_ok = 1u;
}

/* Ğ­·½²î´«²¥µÄµÚ s_prop_row ĞĞ£¨ÓÃÉÏ¸öÖÜÆÚ½¨ºÃµÄ F Óë±¾ÖÜÆÚÊ±³¤£© */
static void ekf_prop_row(void)
{
    uint32_t j, k, row = s_prop_row;
    float sa2, sg2, qd, dtq = s_dt_prev;

    for (j = 0u; j < EKF_N; j++) {
        float s = 0.0f;
        for (k = 0u; k < EKF_N; k++) s += s_F[row][k] * s_P[k][j];
        s_G[row][j] = s;
    }
    sa2 = V5F_EKF_SIG_A_MPS2 * V5F_EKF_SIG_A_MPS2;
    /* ËÙ¶È¹ı³ÌÔëÉùÒ²Òª¼ÓÉÏ**ÖØÁ¦¾­Çã½Ç²»È·¶¨¶ÈµÄĞ¹Â©**£º
     * a_nav = R(q)¡¤(f-ba) + g£¬×ËÌ¬Çã½Ç²»È·¶¨¶È sigma_tilt »áÈÃÖØÁ¦µÄÒ»²¿·ÖÂ©½ø
     * Ë®Æ½¼ÓËÙ¶È£¬a_h,err ¡Ö g¡¤sigma_tilt¡£Êµ²â sigma_tilt p50 0.63 ¶È -> 0.108 m/s^2¡£
     * ²»¼ÓÕâÒ»Ïî£¬Æ½ÒÆÊ± sigma_vel_h Ö»³¤µ½ 0.07 m/s ¶øÕæÊµËÙ¶ÈÔ¼ 1 m/s ¡ª¡ª ²î 14 ±¶£¬
     * ÏÂÓÎ»áÈ¥ĞÅÒ»¸ö´íÁË 1 m/s µÄËÙ¶È¡££¨ÓÃ s_P ÀïµÄÇã½Ç·½²î£¬¼´°ÑñîºÏÏîËã½øĞ­·½²î¡££© */
    {
        float st2 = s_P[6][6] + s_P[7][7];
        float gst = V5F_EKF_G_MPS2 * sqrtf(st2);
        sa2 += gst * gst;
    }
    /* ×ËÌ¬¹ı³ÌÔëÉù = °×ÔëÉù + **¼ÓËÙ¶ÈÕûÁ÷**¡£
     * ºóÕßÊÇÔË¶¯Ïà¹ØµÄÏµÍ³Ïî£¨a_c = w^2*r ºã >= 0£¬ÕûÁ÷²»µÖÏû¡¢µ¥ÏòÀÛ»ı£©£¬
     * Ö»¿¿ sigma_g ½¨Ä£»áÈÃ sigma_yaw ÔÚ¾çÁÒÔË¶¯ÀïÑÏÖØÆ«Ğ¡£¨Êµ²â²î 35 ±¶£©¡£
     * ²»²¹³¥Ëü£¨±êÁ¿Ä£ĞÍ²»³ÉÁ¢£©£¬µ«±ØĞë³ĞÈÏËü¡£ */
    {
        float sr = V5F_EKF_RECT_DPS_PER_G * s_alin_g * DEG2RAD;
        float sq = V5F_EKF_SIG_G_RADS * V5F_EKF_SIG_G_RADS + sr * sr;
        sg2 = sq;
    }
    for (j = 0u; j < EKF_N; j++) {
        float s = 0.0f;
        for (k = 0u; k < EKF_N; k++) s += s_G[row][k] * s_F[j][k];
        if (j == row) {
            qd = V5F_EKF_Q_FLOOR;
            if      (row >= 3u  && row <= 5u)  qd += sa2 * dtq;
            else if (row >= 6u  && row <= 8u)  qd += sg2 * dtq;
            else if (row >= 9u  && row <= 11u) qd += V5F_EKF_SIG_BA_RW * V5F_EKF_SIG_BA_RW * dtq;
            else if (row >= 12u && row <= 14u) qd += V5F_EKF_SIG_BG_RW * V5F_EKF_SIG_BG_RW * dtq;
            else if (row == 15u)               qd += V5F_EKF_SIG_BARO_RW * V5F_EKF_SIG_BARO_RW * dtq;
            /* ¡ïVER=73 Æ«º½·½²îÏÂÏŞ£º²»¼ÓÕâÒ»Ïî£¬M7 µÄ k_cap ÏŞ·ù¸üĞÂ»á°Ñ
             * P[8][8] Ö¸Êı³é¸É£¨Ï÷¼õ ¡Ø P£©-> Æ«º½ÔöÒæ¶öËÀ -> »·Â·Ê§Ğ§¡£
             * ¼û v5f_tune.h V5F_EKF_Q_YAW_MIN µÄÊµ²âÊı¾İÓëÈ¡ÖµÒÀ¾İ¡£ */
            if (row == 8u) qd += V5F_EKF_Q_YAW_MIN;
            s += qd;
        }
        s_Pn[row][j] = s;
    }
    s_prop_row++;
}

/* ÖÜÆÚÄ©£º¶Ô³Æ»¯ + ¶Ô½ÇÏÂÏŞ + ÅÉÉú 1sigma + °Ñ s_Pn ±ä³É±¾ÖÜÆÚµÄĞÂ s_P */
static void ekf_finalize(void)
{
    uint32_t i, j;
    for (i = 0u; i < EKF_N; i++) {
        for (j = i; j < EKF_N; j++) {
            float a = 0.5f * (s_Pn[i][j] + s_Pn[j][i]);
            if (i == j && a < V5F_EKF_P_FLOOR) a = V5F_EKF_P_FLOOR;
            /* ¡ïVER=75 Æ«º½·½²îÏÂÏŞ£ºM7 µÄ k_cap ÏŞ·ù¸üĞÂ¶Ô P[8][8] µÄÏ÷¼õ ¡Ø P£¬
             * ÊÇÖ¸ÊıËúÏİ£¬Êµ²â»á±»Ï÷µ½ 1e-12 Ê¹Æ«º½ÔöÒæ¹éÁã¡¢»·Â·³¹µ×Ê§È¥Á¦Æø
             * £¨VER=74 Â¼ÖÆ£º¾²ÖÃÖĞ²Ğ²î´Ó 21 ¶ÈÕÇµ½ 49 ¶È£¬P Ñø»ØÀ´²ÅÀ­»Ø£©¡£
             * ÏÂÏŞÈ¡´ÅÁ¦¼Æ×ÔÉí²âÁ¿ÔëÉùµÄÆ½·½£¬±£Ö¤ K ºãÔÚ k_cap ÉÏÏŞ¡£ */
            if (i == 8u && j == 8u && a < V5F_EKF_YAW_P_MIN) a = V5F_EKF_YAW_P_MIN;
            s_Pn[i][j] = a;
            s_Pn[j][i] = a;
        }
    }
    for (i = 0u; i < EKF_N; i++) {
        for (j = 0u; j < EKF_N; j++) s_P[i][j] = s_Pn[i][j];
    }
    s_sig[0] = sqrtf(s_Pn[8][8]) * RAD2DEG;
    s_sig[1] = sqrtf(s_Pn[0][0] + s_Pn[1][1]);
    s_sig[2] = sqrtf(s_Pn[3][3] + s_Pn[4][4]);
    s_sig[3] = sqrtf(s_Pn[6][6] + s_Pn[7][7]) * RAD2DEG;   /* Çã½Ç£¨Ë®Æ½Á½ÖáºÏ³É£© */
}

static void ekf_publish(volatile v5f_hold_t *h)
{
    uint32_t i;
    for (i = 0u; i < 3u; i++) h->ekf.p[i] = s_x[IX_P + i];
    for (i = 0u; i < 3u; i++) h->ekf.v[i] = s_x[IX_V + i];
    for (i = 0u; i < 4u; i++) h->ekf.q[i] = s_x[IX_Q + i];
    for (i = 0u; i < 3u; i++) h->ekf.ba[i] = s_x[IX_BA + i];
    for (i = 0u; i < 3u; i++) h->ekf.bg[i] = s_x[IX_BG + i] * RAD2DEG;   /* rad/s -> dps */
    h->ekf.b_baro = s_x[IX_BB];
    /* Õï¶ÏËÄ¼şÌ×£ºs_Pn ÊÇ"´«²¥/¸üĞÂºóµÄ¹¤×÷Ğ­·½²î"£¬s_P ÊÇ"ÉÏÖÜÆÚÄ©µÄ"¡£¶ÔÆëÄÇÒ»²½
     * Ö»Ğ´ÁË s_P£¨s_Pn »¹ÊÇ bss µÄ 0£©£¬ËùÒÔÁ½ÕßÒ»Æğ±¨¾ÍÄÜÅĞ¶¨ P0 ÓĞÃ»ÓĞÂäµØ¡¢
     * ´«²¥ÓĞÃ»ÓĞ°ÑËü°á¹ıÈ¥¡£ */
    h->ekf.pzz    = s_Pn[2][2];
    h->ekf.pbb    = s_Pn[15][15];
    h->ekf.p_p_zz = s_P[2][2];
    h->ekf.p_p_bb = s_P[15][15];
    h->ekf.mag_gate   = s_mag_gate;
    h->ekf.mag_used   = s_mag_used;
    h->ekf.mag_bh     = s_mag_bh;
    h->ekf.mag_r_deg  = s_mag_r;
    h->ekf.p_yy       = s_Pn[8][8];
     h->ekf.prop_ok = (uint8_t)s_prop_ok;
     h->ekf.f_ok = (uint8_t)s_F_ok;
      h->ekf.prop_row = s_pub_row;
      h->ekf.stage = s_pub_stage;
     h->ekf.mag_rej = s_rej[3];
      h->ekf.mag_fhb = s_mag_fhb;
       h->ekf.mag_rx = s_mag_rx;
       h->ekf.mag_ry = s_mag_ry;
        h->ekf.mag_vx = s_mag_vx;
        h->ekf.mag_vy = s_mag_vy;
        h->ekf.mag_v0x = s_mag_v0x;
        h->ekf.mag_v0y = s_mag_v0y;
        h->ekf.mag_yawpre = s_mag_yawpre;
       h->ekf.mag_dqx = s_mag_dqx;
       h->ekf.mag_dqy = s_mag_dqy;
       h->ekf.mag_dqz = s_mag_dqz;
       h->ekf.mag_cmp_thm = s_mag_cmp_thm;
       h->ekf.mag_cmp_thp = s_mag_cmp_thp;
       h->ekf.mag_cmp_amn = s_mag_cmp_amn;
       h->ekf.mag_cmp_mhn = s_mag_cmp_mhn;
       h->ekf.mag_age_ms = s_mag_age_ms;
       h->ekf.mag_rs = s_mag_rs;
       h->ekf.tilt_inv_ms = s_tilt_inv_ms;
       h->ekf.mag_hold = s_mag_hold;
       h->ekf.grav_ok = s_grav_ok;
       h->ekf.grav_nis = s_nis[3];
        h->ekf.tilt_dqx = s_tilt_dqx;
        h->ekf.tilt_dqy = s_tilt_dqy;
        h->ekf.tilt_dqz = s_tilt_dqz;
        h->ekf.tilt_prx = s_tilt_prx;
        h->ekf.tilt_pry = s_tilt_pry;
        h->ekf.tilt_prz = s_tilt_prz;
    for (i = 0u; i < 3u; i++) h->ekf.a_nav[i] = s_a_nav[i];
    h->ekf.gate_bits     = s_gate_bits;
    h->ekf.sigma_yaw_deg = s_sig[0];
    h->ekf.sigma_pos_h   = s_sig[1];
    h->ekf.sigma_vel_h   = s_sig[2];
    h->ekf.sigma_tilt_deg = s_sig[3];
    for (i = 0u; i < 5u; i++) h->ekf.nis[i] = s_nis[i];
    h->ekf.aligned   = s_aligned;
    h->ekf.valid     = s_aligned;
    h->ekf.origin_ok = s_origin_ok;
}

/* ===========================================================================
 * µÚ 7 ²½£ºEKF ±¾Ìå£¨ÉÏÓÎ¶ÁÃÅ£©
 * ========================================================================= */
uint8_t v5f_proc_ekf(volatile v5f_hold_t *h, const volatile v5f_proc_gate_t *gate)
{
    float dt, w[3], f[3];
    uint64_t tk;
    uint32_t i, j;

    if (!V5F_EKF_EN) return V5F_PROC_OK;

    tk = h->imu.fresh.drdy_tick;
    if (tk == 0ULL) return V5F_PROC_OK;
    if (s_last_tick == 0ULL) { s_last_tick = tk; return V5F_PROC_OK; }
    if (tk <= s_last_tick) { s_last_tick = tk; return V5F_PROC_OK; }
    dt = (float)(tk - s_last_tick) * 1e-8f;
    s_last_tick = tk;
    if (dt <= 0.0f || dt > V5F_EKF_DT_MAX_S) return V5F_PROC_OK;

    s_t_run += dt;

    /* ---------------- Ò»´ÎĞÔ¶ÔÆë£¨ËÄ¼¶¶µµ×£¬±£Ö¤Ò»¶¨Æô¶¯£© ----------------
     * ¡ï ½ÌÑµ£¨VER=26 Êµ²â£©£ºÔ­Ìõ¼ş¹ÒÁË mag.trust Óë is_static¡£Á½ÕßµÄÅĞ¾İ¶¼Ñ¹ÔÚ
     *   ãĞÖµÉÏ»á¶¶£¨mag.trust ÀïµÄ |a_lin|<0.05g Êµ²â p50=0.0487g£»is_static ±¾´Î
     *   Ö»ÓĞ 37.4%£©£¬Ã»Í¬Ê±ÂäÉÏÊ± EKF **Õû¸öÍ£°Ú**£¨gate_bits ºã 0¡¢|ekf_q| ºã 0£©¡£
     *   Ò»´ÎĞÔ¶ÔÆë¾ø²»ÄÜ¹ÒÔÚÒ»¸ö»á¶¶µÄÃÅÉÏ¡£ */
    if (!s_aligned) {
        float am = h->imu.accel_g[0]*h->imu.accel_g[0]
                 + h->imu.accel_g[1]*h->imu.accel_g[1]
                 + h->imu.accel_g[2]*h->imu.accel_g[2];
        uint8_t amag_ok, force = 0u, can_align = 0u, self_init = 0u;
        float q0[4];

        amag_ok = (uint8_t)(h->imu.acc_valid
                            && (fabsf(am - 1.0f) < V5F_EKF_ALIGN_AMAG_TOL));
        /* D£ºÁ¬ up_ref_ok ¶¼Ã»À´£¨¾ÉÁ´×Ô¼ºÒ²Òª"¾²Ö¹ + 1g"²Å½¨Ïµ£©-> EKF ×Ô¼º½¨Çã½Ç¡£
         *    ÓÃÓë proc_attitude ÍêÈ«Í¬Ò»Ì××îĞ¡Ğı×ª£ºaxis = u x e_z = (u_y, -u_x, 0)£¬
         *    q = [1 + u_z, axis] ¹éÒ»»¯£»u ³¯ÏÂÊ±ÍË»¯³ÉÈÆ»úÌå x ×ª 180 ¶È¡£ */
        if (h->att.up_ref_ok) {
            for (i = 0u; i < 4u; i++) q0[i] = h->att.q[i];
            can_align = amag_ok;
        } else if (h->imu.acc_valid) {
            float ux = h->imu.accel_g[0], uy = h->imu.accel_g[1], uz = h->imu.accel_g[2];
            float n2 = ux*ux + uy*uy + uz*uz, w, nx, ny, s;
            if (n2 > 1e-6f) {
                s = 1.0f / sqrtf(n2);
                ux *= s; uy *= s; uz *= s;
                if (uz > -0.999999f) { w = 1.0f + uz; nx = uy; ny = -ux; }
                else                 { w = 0.0f; nx = 1.0f; ny = 0.0f; }
                s = 1.0f / sqrtf(w*w + nx*nx + ny*ny);
                q0[0] = w*s; q0[1] = nx*s; q0[2] = ny*s; q0[3] = 0.0f;
                can_align = amag_ok;
                self_init = 1u;
            }
        }
        /* A/B/C£ºÅĞ¾²ÒªÇóÖğ¼¶·Å¿í */
        if (can_align && !(h->stat.valid && (h->stat.is_static || h->stat.ac_bypass))) {
            if (s_t_run >= V5F_EKF_ALIGN_TIMEOUT_S) {
                can_align = (uint8_t)(fabsf(am - 1.0f) < V5F_EKF_ALIGN_AMAG_LOOSE);
                force = 1u;
            }
        }
        if (!can_align && h->imu.acc_valid && h->att.up_ref_ok
            && s_t_run >= V5F_EKF_ALIGN_FORCE_S) {
            for (i = 0u; i < 4u; i++) q0[i] = h->att.q[i];
            can_align = 1u; force = 1u;
        }

        if (can_align) {
            float Ri[3][3], mf[3], Bn[3], azi, dpsi, hq[4], qz[4];
            for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = q0[i];
            q_norm(&s_x[IX_Q]);
            /* ´ÅÆ«º½Ò»´ÎĞÔ¶ÔÆë£ºÖ»ÔÚ**ÎÈ½¡Ä£³¤ÃÅ**£¨Óë M7 Í¬Ò»ÅĞ¾İ£©Í¨¹ıÊ±²Å×ö¡£
             * ²»×öÒ²ÍêÈ«¿ÉÒÔ ¡ª¡ª M7 µÄ H Ö»¹ÒÆ«º½Ïî£¬Ëü×Ô¼º»á°ÑÆ«º½À­µ½Î»¡£ */
            if (s_mn_ok) {
                q_to_R(&s_x[IX_Q], Ri);
                for (i = 0u; i < 3u; i++) mf[i] = h->mag.f[i];
                rot_bn(Ri, mf, Bn);
                azi  = atan2f(Bn[0], Bn[1]);
                /* ·ûºÅ£ºh = atan2(Bx,By)£¬¶ø q <- Exp(phi z)(x)q Ê¹ h_new = h - phi
                 * £¨R_z(phi)¡¤(0,1,0) = (-sin phi, cos phi, 0)£©£»ËùÒÔ phi = azi - D¡£ */
                dpsi = wrap_pi(azi - V5F_MAG_DECL_RAD);
                hq[0] = cosf(0.5f*dpsi); hq[1] = 0.0f; hq[2] = 0.0f; hq[3] = sinf(0.5f*dpsi);
                q_mul(hq, &s_x[IX_Q], qz);
                for (i = 0u; i < 4u; i++) s_x[IX_Q + i] = qz[i];
                q_norm(&s_x[IX_Q]);
            }

            for (i = 0u; i < 3u; i++) s_x[IX_P  + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_V  + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_BA + i] = 0.0f;
            for (i = 0u; i < 3u; i++) s_x[IX_BG + i] = 0.0f;
            s_x[IX_BB] = 0.0f;

            for (i = 0u; i < EKF_N; i++) {
                for (j = 0u; j < EKF_N; j++) s_P[i][j] = 0.0f;
            }
            s_P[0][0] = s_P[1][1] = s_P[2][2] = V5F_EKF_P0_POS_M * V5F_EKF_P0_POS_M;
            s_P[3][3] = s_P[4][4] = s_P[5][5] = V5F_EKF_P0_VEL_MPS * V5F_EKF_P0_VEL_MPS;
            s_P[6][6] = s_P[7][7] = V5F_EKF_P0_TILT_RAD * V5F_EKF_P0_TILT_RAD;
            s_P[8][8] = V5F_EKF_P0_YAW_RAD * V5F_EKF_P0_YAW_RAD;
            s_P[9][9] = s_P[10][10] = s_P[11][11] = V5F_EKF_P0_BA_MPS2 * V5F_EKF_P0_BA_MPS2;
            s_P[12][12] = s_P[13][13] = s_P[14][14] = V5F_EKF_P0_BG_RADS * V5F_EKF_P0_BG_RADS;
            s_P[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
            /* s_Pn »¹ÊÇ bss µÄ 0£»Í¬²½³É P0£¬ÃâµÃÊ×Ö¡ÉÏ±¨¼ÙµÄ 0 */
            for (i = 0u; i < EKF_N; i++) {
                for (j = 0u; j < EKF_N; j++) s_Pn[i][j] = s_P[i][j];
            }
            /* ×Ô¼º½¨µÄÇã½ÇÓĞÎó²î -> °ÑÇã½Ç·½²î¿ª´óÒ»µã£¬ÈÃ M6 ºóÃæÊÕ */
            if (self_init) s_P[6][6] = s_P[7][7] = 0.05f * 0.05f;
            if (self_init) s_Pn[6][6] = s_Pn[7][7] = 0.05f * 0.05f;

            for (i = 0u; i < 3u; i++) { s_dth[i] = 0.0f; s_dvb[i] = 0.0f; }

            s_dq[0] = 1.0f; s_dq[1] = 0.0f; s_dq[2] = 0.0f; s_dq[3] = 0.0f;
            s_dt_e = 0.0f; s_dt_prev = 0.0f;
            s_prop_row = 0u; s_stage = 0u; s_F_ok = 0u;
            s_pos_wait = 0.0f; s_alt_wait = 0.0f; s_baro_wait = 0.0f;
            s_baro_t_last = 0.0f; s_baro_t_seen = 0u;
            s_alin_g = 0.0f; s_sat = 0u;
            s_mag_dth[0] = s_mag_dth[1] = s_mag_dth[2] = 0.0f;
            s_w_int[0] = s_w_int[1] = s_w_int[2] = 0.0f;
            s_w_snap[0] = s_w_snap[1] = s_w_snap[2] = 0.0f;
            s_mag_ts_last = 0ULL;
            s_bh_idx = 0u; s_bh_fill = 0u;
            s_mag_anchor = 0u;   /* ¡ïVER=51 ÖØĞÂ¶ÔÆëºóÔÊĞíÔÙ×öÒ»´Î¿ìËÙÆ«º½¶ÔÆë */
            for (i = 0u; i < 5u; i++) { s_nis[i] = 0.0f; s_rej[i] = 0u; }
            s_gate_bits = 0u;
            s_sig[0] = V5F_EKF_P0_YAW_RAD * RAD2DEG;
            s_sig[1] = V5F_EKF_P0_POS_M;
            s_sig[2] = V5F_EKF_P0_VEL_MPS;
            s_sig[3] = V5F_EKF_P0_TILT_RAD * RAD2DEG;
            s_a_nav[0] = s_a_nav[1] = s_a_nav[2] = 0.0f;
            s_aligned = 1u;
            s_gate_bits |= V5F_EKF_GB_ALIGN;
            if (force)     s_gate_bits |= V5F_EKF_GB_ALIGN_FORCE;
            ekf_publish(h);
            return V5F_PROC_OK;
        }
        return V5F_PROC_OK;
    }

    /* ---------------- ÖÜÆÚ½×¶Î»ú ---------------- */
    /* ---------------- Ô¤»ı·Ö£º**Ã¿Ò»Ö¡**¶¼Òª×ö ----------------
     * ¡ï ±ØĞë·ÅÔÚ½×¶ÎÅĞ¶ÏÖ®Íâ¡£µÚÒ»°æ°ÑËüĞ´ÔÚ `s_stage < DECIM` Àï£¬ÓÚÊÇÄÇ 7 ¸ö
     *   ¹Û²â¸üĞÂÖ¡£¨stage 16..22£©µÄÍÓÂİ/¼Ó¼ÆÊı¾İ±»Õû¸ö¶ªµô ¡ª¡ª Ò»ÖÜÆÚ 23 Ö¡Àï
     *   Ö»»ıÁË 16 Ö¡£¬×ËÌ¬ÉÙ×ª 16/23 = 0.6957¡£Êµ²âÒ»¸ö 92.16 ¶ÈµÄÌ¨½× EKF Ö»¸úÁË
     *   65.57 ¶È£¬±ÈÖµ 0.7115£¬Óë 0.6957 ¶ÔÉÏ¡£ºó¹ûÊÇ´Å»·Ò»Ö±ÔÚºóÃæ×·£¨°å×Ó¾²Ö¹Ê±
     *   EKF Æ«º½»¹±»ÒÔ 9~12 dps ×§»ØÀ´²¹È±¿Ú£©£¬v/p Í¬Ñù°´ 70% Ëõ·Å¡£
     * ±ØĞë¼õ¹À¼ÆµÄÍÓÂİÁãÆ«£ºÎó²î×´Ì¬Àï F Ğ´µÄÊÇ dth' = -R dbg£¬¾ÍÊÇÔÚËµ
     *   "±ê³Æ½ÇËÙ¶È = Á¿²â - bg_hat"¡£¼Ó¼ÆÄÇÒ»Â·±¾À´¾ÍÊÇ¶ÔµÄ£¨ÏÂÃæ dv Àï¼õ ba*dt_e£©¡£ */
    raw_w_rads(h, w);
    raw_f_mps2(h, f);
    /* ¡ïVER=83 ´Å³Â¾É²¹³¥¸ÄÓÃ´Å×Ô¼ºµÄ DRDY Ê±¼ä´Á¡£
     * ¾É×ö·¨ÔÚ ist.hdr.cnt ±ä»¯Ê±°Ñ s_mag_dth ÇåÁã£¬µÈ¼ÛÓÚ°Ñ"ÎÒ·¢ÏÖ¼ÆÊıÆ÷±äÁË"
     * µ±³É²ÉÑùÊ±¿Ì£ºDRDY µ½·¢²¼/·¢ÏÖµÄÁ÷Ë®ÏßÑÓ³Ù±»Ëã³É 0£¬¶øÕâ·İÑÓ³ÙÕıÊÇ
     * "ÄÃ¾É´ÅÊı¾İĞŞĞÂÍÓÂİÒÇ"µÄÁ¿¡£ÏÖ¸ÄÎª£ºs_w_int ÓÀ²»¹éÁãµØ»ı·Ö w*dt£¬
     * ´ÅÊ±¼ä´ÁÒ»±ä¾Í¿ìÕÕ s_w_snap£¬²¹³¥½Ç = s_w_int(now) - s_w_snap
     * = ´Ó t_drdy µ½ÏÖÔÚµÄÕæÊµ×ª½Ç¡£Í¬Ê±ÉÏ±¨´ÅÊı¾İÄêÁäÓÃÓÚÅĞ¶¨ÑÓ³ÙÁ¿¼¶¡£ */
    {
        uint32_t ic = g_shm ? g_shm->ist.hdr.cnt : 0u;
        uint64_t ts = h->mag.fresh.drdy_tick;
        if (ic != s_ist_last || ts != s_mag_ts_last) {
            float ags = 0.0f;
            s_ist_last = ic;
            s_mag_ts_last = ts;
            /* ---- VER=97£º°Ñ¿ìÕÕ»ØËİµ½ÕæÕıµÄ DRDY Ê±¿Ì ----
             * Ô­À´ s_w_snap = s_w_int(±¾Ö¡)£¬µÈ¼ÛÓÚ°Ñ"ÎÒ·½·¢ÏÖĞÂÑù±¾µÄÄÇÒ»Ö¡"µ±³É²ÉÑù
             * Ê±¿Ì£¬DRDY->¶Á³öÕâ¶ÎÑÓ³Ù±»µ±³É 0£¨Ô­×¢ÊÍÒÑÉùÃ÷£©¡£Êµ²â¸ÃÑÓ³ÙÖĞÎ» 0.56 ms
             * / p90 0.61 ms£¨VER=96 µÄ 159-160 Á½ÁĞ£¬10 ns ¼ÆÊı£©£¬2000 dps ÏÂ¾ÍÊÇ 1.1
             * ¶È¹Ì¶¨ÖÍºó²»±»²¹³¥¡£ÕâÀï°Ñ¿ìÕÕ°´ (tk-ts) Íù»ØÍÆ w*age£¬s_mag_dth µÄ»¡³¤
             * ´Ó¶ø¸²¸ÇÍêÕûµÄ DRDY->µ±Ç°Ö¡¡£ */
            if (ts != 0ULL && tk > ts) {
                uint64_t a10 = tk - ts;
                if (a10 > V5F_MAG_RDAGE_MAX_TICK) a10 = V5F_MAG_RDAGE_MAX_TICK;
                ags = (float)a10 * 1e-8f;
            }
            for (i = 0u; i < 3u; i++) s_w_snap[i] = s_w_int[i] - w[i] * ags;
        }
        s_mag_age_ms = (ts != 0ULL && tk > ts) ? (float)(tk - ts) * 1e-5f : 0.0f;
    }
    /* ¡ïVER=84 Çã½Ç²Î¿¼Ê§Ğ§ÀÛ¼Æ£¨Ã¿Ö¡£©£¬Çı¶¯´ÅÔİÍ£ÃÅ¡£
     * ÃÅĞÅºÅÈ¡ÉÏÒ»Ö¡ËãºÃµÄ gate->ekf_tilt£¬0.3s µÄÃÅ²»ÔÚºõÒ»Ö¡ÖÍºó¡£ */
    s_grav_ok = gate->ekf_tilt;
    if (gate->ekf_tilt) s_tilt_bad_s = 0.0f;
    else if (s_tilt_bad_s < 10.0f) s_tilt_bad_s += dt;
    s_tilt_inv_ms = s_tilt_bad_s * 1e3f;
    /* ¡ïVER=95 ½âñî£º´ÅµÄÔİÍ£²»ÔÙÖ±½Ó¸ú gate->ekf_tilt£¨Ëü±»¼Ó¼ÆÎÛÈ¾£©¡£
     *   Ö»ÔÚ"Ô­±¾µÄÇã½Ç¹Û²â**±¾¿ÉÓÃ**£¨acc_valid ÇÒÎ´Ï÷¶¥ ÇÒ |a|^2 ÔÚÈİ²îÄÚ£©¶øÇã½ÇÃÅÈÔ¾Ü"
     *   Ê±ÀÛ¼Æ ¡ª¡ª ÄÇ²ÅÊÇ×ËÌ¬Çã½ÇÕæµÄÓĞÎÊÌâ£»¼Ó¼Æ²»¿ÉÓÃ£¨ÔË¶¯/³å»÷/Ï÷¶¥£©Ê±²»ÀÛ¼Æ£¬
     *   ´ÅµÄ¿ÉÓÃĞÔ½»»Ø³¡ÅĞ¾İ£¨Ä£³¤/ÑØÖØÁ¦·ÖÁ¿/´ÅÇã/Ë®Æ½·ÖÁ¿£©+ Á¬Ğø 1 s ÓĞĞ§²Å¿ªÃÅ¡£
     *   º¬Òå±ä»¯£º´ÅÔÚÔË¶¯ÖĞ¿É¼ÌĞøĞŞÕı£¬¶ø²»ÔÙµÈµ½Í£ÏÂºó²ÅÒ»´ÎĞÔ¹àÈë£¨Êµ²âÍ£ºó 0.5 s
     *   Ôø¹àÈë 59 ¶È¶øÔË¶¯ÆÚÖ»ÓĞ 17 ¶È£©¡£ */
    /* VER=103: Ô­ s_mag_tilt_bad_s ÀÛ¼Æ¿éÒÑÉ¾³ı£¨ËüÖ»·şÎñÓÚ"ÔË¶¯ÖĞ½û´Å"ÄÇÌõ hold£©¡£ */
    for (i = 0u; i < 3u; i++) {
        s_dth[i] += (w[i] - s_x[IX_BG + i]) * dt;
        s_dvb[i] += f[i] * dt;
        s_w_int[i] += w[i] * dt;
        s_mag_dth[i] = s_w_int[i] - s_w_snap[i];
    }
    /* ¡ï ×ËÌ¬ÔöÁ¿**ÖğÖ¡¸´ºÏ³ÉËÄÔªÊı**£¬¶ø²»ÊÇ°ÑÖá½ÇÊ¸Á¿Ïà¼Ó¡£
     *   Ïà¼ÓÖ»ÔÚµ¥Öá×ª¶¯Ê±µÈÓÚ¸´ºÏ£»ÈıÖáÍ¬Ê±×ª¶¯Ê±¶ªµô½»»»×ÓÏî£¬±íÏÖÎªÈÆµÚÈıÖáµÄ
     *   Ğé¼Ù×ª¶¯£¨Æ«º½Îó²î£©£¬¼´Ò»½×Ô²×¶Îó²î ¡ª¡ª Êµ²â"ÈıÖáÍ¬Ê±×ªÆ«º½¼«´óÎó²î"£¬
     *   ¶øµ¥Öá×ª¶¯ÍêÈ«Õı³£¡£¾ÉÁ´ 8 kHz ÏÂÃ¿Ö¡¸´ºÏÒ»´Î£¬ËùÒÔÃ»ÓĞÕâ¸öÎó²î¡£
     *   ÓÃ¾«È·°ë½Ç£¨sin/cos£©£¬²»ÓÃÒ»½×½üËÆ£»Ë³Ğò£º»úÌåÔöÁ¿ÔÚÓÒ²à¡¢°´Ê±¼äÓÒ³Ë¡£ */
    {
        float wx = w[0] - s_x[IX_BG], wy = w[1] - s_x[IX_BG + 1], wz = w[2] - s_x[IX_BG + 2];
        float dqf[4], qt[4], th2 = (wx*wx + wy*wy + wz*wz) * dt * dt;
        if (th2 > 1e-12f) {
            float th = sqrtf(th2), h = 0.5f * th, sc = sinf(h) / th;
            dqf[0] = cosf(h);
            dqf[1] = sc * wx * dt;
            dqf[2] = sc * wy * dt;
            dqf[3] = sc * wz * dt;
        } else {
            dqf[0] = 1.0f;
            dqf[1] = 0.5f * wx * dt;
            dqf[2] = 0.5f * wy * dt;
            dqf[3] = 0.5f * wz * dt;
        }
        q_norm(dqf);
        q_mul(s_dq, dqf, qt);
        for (i = 0u; i < 4u; i++) s_dq[i] = qt[i];
        q_norm(s_dq);
    }
    s_dt_e += dt;

    if (s_stage < V5F_EKF_DECIM) {
        /* Ğ­·½²î£º±¾Ö¡´«²¥Ò»ĞĞ¡£16 ĞĞÕıºÃÌ¯ÔÚ stage 0..15 Õâ 16 Ö¡Àï£¬
         * µ½ stage 16 Ê±ÒÑ¾­´«²¥Íê±Ï£¬Ëæºó 7 Ö¡×ö¹Û²â¸üĞÂÓëÊÕÎ²¡£ */
        /* ¡ïVER=44 ĞŞÕı×ÔËø£ºEKF_N(17) > V5F_EKF_DECIM(16)¡£
         * Ô­À´ 16 Ö¡×î¶àÍÆ 16 ĞĞ -> s_prop_row ÓÀÔ¶µ½²»ÁË EKF_N
         * -> s_prop_ok ºã 0 -> ËùÓĞ¹Û²â(M6/M5/M7/M1M2/M4)Óë ekf_finalize()
         *   È«²¿±»Ìø¹ı£¬EKF ÍË»¯³É´¿ÍÓÂİ»ı·ÖÆ÷
         *   £¨Êµ²â VER=44/47/48£ºmag_r ºã 0¡¢mag_used 0%¡¢chi2 100%¡¢
         *    gate_bits Ö»ÓĞ aligned|step|chi2£©¡£Õâ¾ÍÊÇµØ´Å²»Æô¶¯µÄÕæÒò¡£
         * Ç° 15 Ö¡ÈÔ¸÷ÍÆ 1 ĞĞ£¨ISR ¸ºÔØ¾ùÌ¯£©£¬×îºóÒ»Ö¡°ÑÓàÏÂµÄĞĞ²¹Íê¡£*/
        if (s_F_ok) {
            if (s_stage == V5F_EKF_DECIM - 1u) {
                while (s_prop_row < EKF_N) ekf_prop_row();
            } else if (s_prop_row < EKF_N) {
                ekf_prop_row();
            }
        }
        s_stage++;
    } else {
        switch (s_stage) {
        case 16u:
            /* ÖÜÆÚÄ©£ºÏÈ°Ñ±ê³Æ×´Ì¬ÍÆ½øµ½±¾ÖÜÆÚÄ©¶Ë¡¢²¢½¨ºÃÏÂÒ»ÖÜÆÚµÄ F¡£
             * ¡ï ±ØĞë**ÔÚ¹Û²â¸üĞÂÖ®Ç°**ÍÆ½ø£ºP ÒÑ¾­ÔÚÉÏÃæ 16 Ö¡Àï´«²¥ÍêÁË
             *   £¨P_k|k-1 = F P_k-1|k-1 F' + Q£©£¬×´Ì¬ÈôÁôµ½¸üĞÂÖ®ºóÔÙÍÆ½ø£¬
             *   ×´Ì¬ÓëĞ­·½²î¾Í»á´í¿ªÒ»¸öÖÜÆÚ¡£ */
            s_gate_bits = 0u;                  /* ±¾ÖÜÆÚ¹Û²â¼ÇÕË´ÓÕâÀï¿ªÊ¼ */
            if (s_sat) { s_gate_bits |= V5F_EKF_GB_SAT; s_sat = 0u; }
            s_chi2_soft = 0u;
            s_mag_used = 0u;
            s_prop_ok = (uint8_t)(s_F_ok && s_prop_row >= EKF_N);
            if (s_dt_e > 1e-6f) {
                ekf_step_nominal();
            } else {
                s_F_ok = 0u;
            }
            for (i = 0u; i < 3u; i++) { s_dth[i] = 0.0f; s_dvb[i] = 0.0f; }
            s_dq[0] = 1.0f; s_dq[1] = 0.0f; s_dq[2] = 0.0f; s_dq[3] = 0.0f;
            s_dt_e = 0.0f;
            s_pub_row = (uint8_t)s_prop_row;   /* ¡ïVER=48 ÏÈ¿ìÕÕÔÙÇåÁã */
            s_prop_row = 0u;
            break;
        case 17u:
            if (s_prop_ok) ekf_m6_tilt(h, gate);
            break;
        case 18u:
            if (s_prop_ok) ekf_m5_zupt(gate);
            break;
        case 19u:
            /* ÆøÑ¹°´Éè¼Æ½µµ½ 6.1 Hz£¨press_avg µÄÔëÉùÏà¹ØÊ±¼ä¾ÍÊÇ W=32 ºóµÄ 165 ms£©¡£
             * ¡ï ºÅÖ¾±ØĞë**Ö»ÔÚÕæµÄ³¢ÊÔÁË¹Û²âÊ±**²ÅÇå¡£Ô­À´ÎŞÌõ¼şÔÚÃ¿´Î stage 19 Çå£¬
             *   ¶ø M3 Ö»ÔÚ³éÈ¡ÃÅÔÊĞíÊ±²ÅÖ´ĞĞ -> ¾ø´ó¶àÊıÖÜÆÚ°ÑĞÂÑù±¾°×ÇåÁË£¬
             *   ÕæÕıÂÖµ½ M3 Ê±ºÅÖ¾ÔçÒÑÊÇ 0¡£Êµ²â baro ÃÅÖ»Ê£ 0.34%£¨Ó¦Ô¼ 1.75%£©£¬
             *   ¶ø 40 cm Ì§¸ßÔÚÆøÑ¹ÀïÃ÷È·¿É¼û£¨h_baro 5 s ²î·Ö +0.477 m£©¡¢
             *   p_z È´Ö»¶¯ÁË +0.111 m ¡ª¡ª ¹Û²â±»¶öËÀ£¬²»ÊÇ¹Û²â²»×¼¡£ */
            if (s_prop_ok && s_baro_wait >= V5F_EKF_BARO_PERIOD_S) {
                s_baro_wait = 0.0f;
                /* ¡ï Ë³Ğò²»ÄÜ·´£ºekf_m3_baro µÚÒ»ĞĞ¾ÍÊÇ
                 *   `if (!gate->ekf_baro || !s_baro_new) return;`
                 *   ÏÈÇåºÅÖ¾ÔÙµ÷ÓÃ = Ã¿´Î¶¼ÔÚµÚÒ»ĞĞ return¡£
                 *   VER=26~28 Êµ²â baro ÃÅºã 0.00%¡¢²î·Ö¹Û²â´ÓÎ´ÉúĞ§£¬
                 *   ¾ÍÊÇÕâÁ½ĞĞĞ´·´ÁË¡£ */
                ekf_m3_baro(gate);
                s_baro_new = 0u;               /* µ÷ÓÃÖ®ºóÔÙÏû·Ñ */
            }
            if (s_prop_ok) ekf_m7_mag(h, gate);
            break;
        case 20u:
            if (s_prop_ok) ekf_m1m2_gps(h, gate);
            break;
        case 21u:
            if (s_prop_ok) ekf_m4_vel(h, gate);
            s_gps_new = 0u;
            break;
        default:                               /* 22£ºÊÕÎ² */
            if (s_prop_ok) ekf_finalize();
            /* Ã»ÓĞ ENU Ô­µã£¨= Ã»ÓĞ GPS ¸ß¶È M2£©Ê±£¬b_baro Ã»ÓĞÈÎºÎ¹Û²âÕß¡£
             * ²î·Ö¹Û²âµÄ H ²»º¬Ëü£¬µ«ËüÈÔ¿ÉÄÜ±»Ğ­·½²î½»²æÏî¼ä½ÓÍÏ¶¯¡£¼ÈÈ»Ã»ÈË
             * ¹Û²â£¬¾ÍÃ¿¸öÖÜÆÚ°ÑËüÑ¹»Ø 0 ²¢ÇåµôËüµÄĞ­·½²îĞĞ/ÁĞ£¬¾ø²»ÈÃËüÍµÍµ³¤³É
             * Ò»¸ö¼ÙµÄ¾ø¶Ô»ù×¼£¨VER=27 Êµ²âÔøÆ¯µ½ -116 m£©¡£ */
            if (!s_origin_ok) {
                uint32_t k3;
                s_x[IX_BB] = 0.0f;
                for (k3 = 0u; k3 < EKF_N; k3++) {
                    s_P[k3][15] = 0.0f;
                    s_P[15][k3] = 0.0f;
                    s_Pn[k3][15] = 0.0f;
                    s_Pn[15][k3] = 0.0f;
                }
                s_P[15][15]  = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
                s_Pn[15][15] = V5F_EKF_P0_BARO_M * V5F_EKF_P0_BARO_M;
            }
            if (s_aligned)   s_gate_bits |= V5F_EKF_GB_ALIGN;
            if (s_origin_ok) s_gate_bits |= V5F_EKF_GB_ORIGIN;
            if (s_chi2_soft) s_gate_bits |= V5F_EKF_GB_CHI2;   /* ±¾ÖÜÆÚÓĞ¹Û²â±»Èí¼ÓÈ¨ */
            if (s_gate_bits & ~(V5F_EKF_GB_ALIGN | V5F_EKF_GB_ORIGIN)) {
                s_gate_bits |= V5F_EKF_GB_STEP;
            }
            s_pub_stage = (uint8_t)s_stage;   /* ¡ïVER=48 ÏÈ¿ìÕÕÔÙÇåÁã */
            s_stage = 0u;
            ekf_publish(h);
            break;
        }
        if (s_stage != 0u) s_stage++;
    }

    /* ---------------- Ã¿Ö¡ÊÕÎ² ---------------- */
    s_pos_wait  += dt;
    s_alt_wait  += dt;
    s_baro_wait += dt;
    s_boot_t += dt;      /* ¡ïVER=62 ¿ª»ú¼ÆÊ± */
    /* ¶àÆÕÀÕÖ±Á÷Æ«ÖÃÒ»½×Ç£Òı£ºÃÅ = ÉÏÒ»Ö¡µÄ ZUPT ÃÅ£¨ÍâÉú£©£¬ÓëÍÓÂİÁãÆ«Ç£ÒıÍ¬¹¹ */
    if (gate->ekf_zupt && h->gps_rmc.status == (uint8_t)'A') {
        float a = dt / V5F_EKF_DOP_TAU_S;
        s_b_dop += (h->gps_rmc.speed_mps - s_b_dop) * a;
    }
    return V5F_PROC_OK;
}

/* ===========================================================================
 * µÚ 8 ²½£ºEKF ¸÷¹Û²âµÄ**Íâ²¿ÃÅ¿Ø**£¨ÏÂÓÎĞ´¡¢ÉÏÓÎÏÂÒ»Ö¡¶Á£©
 * ========================================================================= */
uint8_t v5f_proc_ekf_gate(volatile v5f_hold_t *h, volatile v5f_proc_gate_t *gate)
{
    static uint32_t s_gga_cnt_last, s_rmc_cnt_last, s_bmp_cnt_last;
    static float    s_press_last;
    static uint8_t  s_started;
    uint32_t gga_cnt, rmc_cnt, bmp_cnt;
    uint8_t  gq_ok, gn_ok, snr_ok, vd_ok, amag_ok;
    float    spac, am2;

    if (!V5F_EKF_EN) return V5F_PROC_OK;

    gga_cnt = g_shm ? g_shm->gps_gga.hdr.cnt : 0u;
    rmc_cnt = g_shm ? g_shm->gps_rmc.hdr.cnt : 0u;
    bmp_cnt = g_shm ? g_shm->bmp.hdr.cnt     : 0u;
    if (!s_started) {
        s_started = 1u;
        s_gga_cnt_last = gga_cnt;
        s_rmc_cnt_last = rmc_cnt;
        s_bmp_cnt_last = bmp_cnt;
    }
    if (gga_cnt != s_gga_cnt_last) { s_gps_new = 1u; s_gga_cnt_last = gga_cnt; }
    if (rmc_cnt != s_rmc_cnt_last) { s_rmc_cnt_last = rmc_cnt; }
    /* ÆøÑ¹£º¡ï Êµ²â baro.hdr.cnt Óë ist.hdr.cnt **ÊÇÍ¬Ò»¸öÊÂ¼ş¼ÆÊıÆ÷**£¨ºã²î 1£©£¬
     * ËùÒÔËüÊµ¼Ê°´´ÅÁ¦¼ÆµÄ ~187 Hz µİÔö£¬²»´ú±íÆøÑ¹ÓĞĞÂÑù±¾¡£Òò´ËÕâÀïÔÙ¼ÓÒ»µÀ
     * "Ñ¹Á¦ÖµÕæµÄ±äÁË"µÄÅĞ¾İ£¬±ÜÃâ 187 ´Î/ÃëµØÖØ¸´Î¹Í¬Ò»¸ö¾ÉÖµ¡£ */
    if (bmp_cnt != s_bmp_cnt_last) {
        float p = h->baro.press_avg_pascal;
        s_bmp_cnt_last = bmp_cnt;
        if (p != s_press_last) {
            s_press_last = p;
            if (p > V5F_EKF_BARO_PA_LO && p < V5F_EKF_BARO_PA_HI) {
                float hnew = V5F_EKF_BARO_M_PER_PA * (V5F_EKF_BARO_PA0 - p);
                /* ¡ï ÕâÀïÔ­À´ÊÇ**ËÀÅĞ¾İ**£ºs_baro_h_last Ö»ÔÚÌø±äĞ¡Ê±¸üĞÂ£¬¶øÕæÕı±»Ê¹ÓÃµÄ
                 *   s_baro_h ÎŞÌõ¼ş¸³Öµ ¡ª¡ª µÈÓÚ |dh| ÃÅ´ÓÀ´Ã»ÓĞ¾Ü¾ø¹ıÈÎºÎÑù±¾¡£
                 *   ÏÖÔÚÕæµÄ¾Ü¾ø£ºÌø±ä»òÎÂ²î³¬ÏŞ¾ÍÕûÖ¡¶ªÆú£¨²»¸üĞÂ s_baro_h¡¢²»ÖÃºÅÖ¾£©¡£ */
                float dth = fabsf(h->baro.temp_celsius - s_baro_t_last);
                if (s_baro_seen
                    && (fabsf(hnew - s_baro_h_last) >= V5F_EKF_BARO_STEP_MAX_M
                        || (s_baro_t_seen && dth > V5F_EKF_BARO_DT_MAX_C))) {
                    /* Ò°Öµ / ÎÂ¶ÈÌø±ä£º¶ª±¾Ñù±¾ */
                } else {
                    s_baro_h_last = hnew;
                    s_baro_h = hnew;
                    s_baro_seen = 1u;
                    s_baro_new  = 1u;
                }
                s_baro_t_last = h->baro.temp_celsius;
                s_baro_t_seen = 1u;
            }
        }
    }

    /* ¡ï ±¾ÏîÄ¿µÄÌúÂÉ"ÅĞ¿Õ²éÎ»¡¢ÎğÓÃÖµÅĞ¿Õ"£ºÃ¿¸ö¶¨±ê×Ö¶Î¶¼ÒªÏÈ²éËü¶ÔÓ¦µÄ flags Î»
     *   ÔÙĞÅËüµÄÖµ¡£Ô­À´ sat_num / hdop Ö±½ÓÓÃÖµÅĞ ¡ª¡ª ×Ö¶ÎÒ»µ©Ã»½âÎö³öÀ´¾ÍÊÇ 0£¬
     *   ÃÅ»á**ÓÀ¾Ã¹Ø±Õ**£¬GPS ÕûÂ·¾²Ä¬Ê§Ğ§£¨Óë fixq>=2 ÄÇÀà"ÓÀÔ¶´ò²»¿ªµÄÃÅ"Í¬ĞÍ£©¡£
     *   ÏÖÔÚÌõ¼ş¹ÒÔÚ flags ÉÏ£ºÃ»Õâ¸ö×Ö¶Î¾Í²»ÄÃËüµ±ÅĞ¾İ¡£
     * ¡ï fixq >= 1 ÊÇ**ÓĞÒâÆ«ÀëÉè¼Æ**£¨Éè¼ÆĞ´ {2,4}£©£º½ü³¡È«²¿ÊÇµ¥µã¶¨Î» fixq=1£¬
     *   ÕÕÉè¼ÆĞ´¾ÍÓÀÔ¶´ò²»¿ª£»R ÒÑ¾­°´ 4 m£¨Êµ²â 2D RMS 4.24~5.97£©¸ø×ãÁË¡£ */
    gq_ok  = (uint8_t)((h->gps_gga.fix_quality >= 1u)
                    && ((!(h->gps_gga.fresh.flags & SHM_GGA_SV))
                        || (h->gps_gga.sat_num >= V5F_EKF_SV_MIN))
                    && ((!(h->gps_gga.fresh.flags & SHM_GGA_HDOP))
                        || (h->gps_gga.hdop <= V5F_EKF_HDOP_MAX)));
    snr_ok = (uint8_t)((h->gps_gsv.snr_n == 0u)
                    || (h->gps_gsv.snr_avg_dbhz >= V5F_EKF_SNR_MIN_DBHZ));
    gn_ok  = (uint8_t)(h->gps_rmc.status == (uint8_t)'A');
    vd_ok  = (uint8_t)((!(h->gps_gsa.fresh.flags & SHM_GSA_DOP))
                    || (h->gps_gsa.vdop <= V5F_EKF_VDOP_MAX));
    spac   = h->gps_rmc.speed_mps;

    gate->ekf_gps_pos = (uint8_t)(gq_ok && snr_ok && gn_ok
                        && (h->gps_gga.fresh.flags & SHM_GGA_QUALITY)
                        && (h->gps_rmc.fresh.flags & SHM_RMC_POS));
    gate->ekf_gps_alt = (uint8_t)(gate->ekf_gps_pos && vd_ok
                        && (h->gps_gga.fresh.flags & SHM_GGA_ALT));
    /* M4 **²»ĞèÒª**½µÆµ£º¶àÆÕÀÕËÙ¶ÈÊÇÃ¿¸öÀúÔª¶ÀÁ¢½âËãµÄ°×ÔëÉù£¨ÓëÎ»ÖÃÄÇÖÖ
     * 5 s Ïà¹ØµÄÂıÓÎ×ß²»Í¬£©£¬Êµ²â¿ÛµôÖ±Á÷Æ«ÖÃºó std 0.15 m/s£¬R=(0.15 m/s)^2 ³ÉÁ¢¡£
     * ÕâÌõÓë M1/M2/M3 µÄ´¦Àí²»Í¬ÊÇ**ÓĞÒÀ¾İµÄ**£¬±ğÎªÁË"Í³Ò»"È¥¸øËü¼Ó½µÆµ¡£ */
    gate->ekf_gps_vel = (uint8_t)(gq_ok && gn_ok && snr_ok
                        && (h->gps_rmc.fresh.flags & SHM_RMC_SPEED)
                        && (h->gps_rmc.fresh.flags & SHM_RMC_COURSE)
                        && (spac > V5F_EKF_VEL_SPEED_MIN_MPS));
    gate->ekf_baro = (uint8_t)(s_t_run >= V5F_EKF_BARO_WARMUP_S
                    && h->baro.temp_celsius > -40.0f
                    && h->baro.temp_celsius < 85.0f);
    am2 = h->imu.accel_g[0]*h->imu.accel_g[0]
        + h->imu.accel_g[1]*h->imu.accel_g[1]
        + h->imu.accel_g[2]*h->imu.accel_g[2];
    /* ¼Ó¼ÆÏ÷¶¥£º|LSB| µ½ÂúÁ¿³Ì -> ¸ÃÖ¡±ÈÁ¦ÊÇ´íµÄ£¬M6 ²»ĞíÓÃ£¬ÇÒÒªÁôÏÂÖ¤¾İ */
    {
        uint8_t sat = 0u;
        uint32_t k;
        for (k = 0u; k < 3u; k++) {
            int32_t v = (int32_t)h->imu.accel_lsb[k];
            if (v >= 32000 || v <= -32000) sat = 1u;
        }
        if (sat) s_sat = 1u;
        /* ¡ï ÓëÉè¼ÆµÄÒ»´¦**ÓĞÒâÆ«Àë**£ºÉè¼ÆĞ´"³¤´°¾» |w| < 2 dps"£¨256 ms ´°£©£¬
         *   ÕâÀïÓÃµÄÊÇ stat.level_dps£¨128 Ö¡ ¡Ö 16 ms£©¡£¶Ì´°ÆäÊµ¸ü¶Ô ¡ª¡ª ÒªÅÅ³ı×ª¶¯
         *   ÊÇÒòÎªÀëĞÄÏî a_c = w^2*r »áÑÍÃ»ÖØÁ¦·½Ïò£¬¶ø a_c Ö»ÔÚ¸ß w Ê±²ÅÏÔÖø£¬
         *   16 ms ´°×¥µÄÕıÊÇËü£»Âı×ªÊ± a_c ¿ÉºöÂÔ£¬²»¸ÃÒò´Ë¹ØµôÇãĞ±¹Û²â¡£
         *   ¶ÀÁ¢×Ö¶Î£ºÓë gate->att_tilt Í¬Ô´ÅĞ¾İµ«¸÷×Ô³ÉÎ»£¬¸ÄÒ»¸ö²»¶¯ÁíÒ»¸ö¡£
         * ¡ïVER=89£ºÃÅÏŞÓÉ 2 dps ¸ÄÎª V5F_EKF_TILT_WMAX_DPS(61.2 dps£¬ÎïÀíÔ¤Ëã)£¬
         *   Í¬Ê±°Ñ a_c Ïî°´ |w| Ğ´½ø M6 µÄ R£¨¼û ekf_m6_tilt£©¡ª¡ªÃÅÖ»¸ºÔğ´ÖÅĞ£¬
         *   ´ø¿í´Ó**³ÏÊµµÄ R** ³ö£¬²»ÔÙÓÃÊÕ½ôÃÅÏŞÀ´»Ø±ÜÀëĞÄÏî¡£ */
        gate->ekf_tilt = (uint8_t)(!sat && h->imu.acc_valid
                        && (fabsf(am2 - 1.0f) < V5F_EKF_TILT_AMAG_TOL)
                        /* ¡ïVER=91 »ØÍËµ½Ô­Éè¼ÆµÄ 2 dps£¨VER=89 Ôø·Å¿íµ½ WMAX=61.2 dps£©¡£
                         *   Ô­Òò£ºÊÖ³ÖÔË¶¯Ê±¼Ó¼ÆµÄÎó²îÖ÷ÏîÊÇ**Ïß¼ÓËÙ¶ÈµÄÇĞÏò·ÖÁ¿**£¬Ëü**²»¸Ä±ä**
                         *   |a| -> ÉÏÃæÄÇÌõ |am2-1|<0.06 ÃÅ¶ÔËüÍêÈ«²»¿É¼û£¨|a|=1.03 g Ê±ÇĞÏò¿É´ï
                         *   0.25 g ¡Ö 14 ¶ÈÇã½ÇÎó²î£©¡£·Å¿íÃÅµÈÓÚÈÃÕâÀà±»ÎÛÈ¾µÄ¹Û²â½øÇã½Ç¸üĞÂ£¬
                         *   Êµ²âÔË¶¯×ËÌ¬Óë"ÔË¶¯ºóÆ¯"Òò´Ë±ä²î¡£R ÀïÄÇ¸ö a_c ÏîÖ»¸²¸ÇÀëĞÄÏî£¬²»¹»¡£
                         *   ´ú¼Û£¨ÒÑÖª²¢½ÓÊÜ£©£º´Å¸üĞÂ»áÏñÔ­À´Ò»ÑùÔÚÔË¶¯ÖĞ³£±» s_tilt_bad_s ÔİÍ£
                         *   ¡ª¡ª ÄÇÓë"Çã½ÇÃÅ"ÊÇ**Á½¸ö**ÎÊÌâ£¬Ó¦ÁíĞĞ¾ö¶¨ÊÇ·ñ½âñî£¬²»ÔÚÕâÀï»ì¡£ */
                        && ((h->stat.level_dps < V5F_EKF_TILT_LEV_DPS) || h->stat.ac_bypass));
    }
    /* ¡ï ÃÅÓÃ mag.ok£¨Ö»²é |y| Ä£³¤Ò»ÖÂĞÔ = Íâ²¿´Å¸ÉÈÅ£©£¬**²»ÓÃ** mag.trust¡£
     *   trust ÀïÄÇ¸ö |a_lin| < 0.05 g ÊÇ¸ø¾ÉÁ´¼ÓµÄ£º¾ÉÁ´µÄ Bw/psi_true ÓÉ¾ÉÁ´×ËÌ¬Ëã³ö£¬
     *   Çã½Ç²»¿ÉĞÅÊ±ËüÃÇ²»¿ÉĞÅ¡£EKF µÄ M7 ÓÃµÄÊÇ mag.f£¨»úÌå´Å³¡£¬´¿´«¸ĞÆ÷Á¿£©
     *   Åä×Ô¼ºµÄ q_hat£¬¼ÓËÙ¶È²»ÎÛÈ¾´Å³¡²âÁ¿ ¡ª¡ª ÄÇ¸öÌõ¼ş¶Ô M7 ÎŞĞ§£¬
     *   ¶øÇÒÇ¡ºÃÔÚÍÓÂİ±»ÕûÁ÷Îó²îÎÛÈ¾Ê±°ÑÆ«º½»ù×¼¹Øµô£¨Êµ²â¾çÁÒ¶ÎÖ»¿ª 0.3%£©¡£
     *   ÔË¶¯´øÀ´µÄÁ½ÌõÕæÊµÎó²î×ß R£ºÇã½ÇñîºÏ + Ñù±¾³Â¾É£¨ÔÚ ekf_m7_mag Àï´¦Àí£©¡£ */
    {
        /* ¡ïVER=90 »ùÏß**ºã¶¨¹Ì»¯ÔÚ¹Ì¼şÀï**£¨= 1.0£©£¬³¹µ×²»×ö×ÔÓú¡£
         *   ±ê¶¨°Ñ A/C ¹éÒ»»¯³É |f| = 1£¨¼û V5F_MAG_A_INIT£©£¬ËùÒÔ°²×°ÕıÈ·Ê± |f| ºãÎª 1£»
         *   ³¡´ÎÓ²Ìú±ä»¯ÒâÎ¶×Å**±ê¶¨²»ÔÙÆ¥Åä°²×°**£¬ÕıÈ·×ö·¨ÊÇÖØ±ê£¬¶ø²»ÊÇÈÃÃÅ¸ú×ÅÆ¯¡£
         *   ¾É°æ×ÔÓú£¨Æ«Àë<ÃÅÏŞÊ±Âı¸úËæ + ³ÖĞøÆ«Àë³¬¹ı V5F_EKF_MAG_NORM_REBASE
         *   ¡Ö2.9 s ¾Í°Ñ»ùÏßÖØ¶¨µ½µ±Ç°Öµ£©±¾ÒâÊÇ¸ú³¡´Î³£ÊıÆ«²î£¬µ«Íâ²¿Ìú´Å¸ÉÈÅÖ»Òª
         *   ³ÖĞø 3 s ¾Í»á±»Îü³ÉĞÂ»ùÏß -> dev ¹éÁã -> ÃÅÖØ¿ª¡£
         *   Êµ²â VER=89 ¼Ğ¾ß 90/180 ²É¼¯£ºt=19.0~21.5 |f|=1.52~1.80¡¢´Å³¡·½ÏòÆ« +17.5 ¶È£¬
         *   t=24~28.5 |f|=1.11¡¢·½ÏòÆ« -20 ¶È£¬Á½¶Î mag_used ÈÔ¿ª 46~54%
         *   £¨|f| ±¾À´¾ÍÔÚ col45 mag.mag_norm ÉÏ±¨×Å£©£¬EKF Æ«º½±»×§ 17~20 ¶ÈÇÒ**²»»Ö¸´**
         *   ¡ª¡ª Õâ¾ÍÊÇ"ÔË¶¯ºóÆ¯"¡£¸Ä³ÉÖ»Óë³£Êı 1.0 ±ÈÒÔºó£¬ÉÏÊö¸÷¶ÎÈ«²¿¹ØÃÅ£¬
         *   Æ«º½½»»ØÍÓÂİ£»ÈôÕû³¡¶¼¿ª²»ÁËÃÅ£¨mag_used=0% ÇÒ col45 Ã÷ÏÔÆ«Àë 1£©£¬
         *   ËµÃ÷¸Ã°²×°ĞèÒª**ÖØĞÂ±ê¶¨**£¬¶ø²»ÊÇÈÃ¹Ì¼ş×Ô¼ºÆ¯¡£ */
        float dev, mnow = h->mag.mag_norm;
        dev = fabsf(mnow - 1.0f);
        s_mn_ok = (uint8_t)(dev < V5F_MAG_ERR_LIM);
        gate->ekf_mag_yaw = (uint8_t)(s_mn_ok && (V5F_EKF_YAW_OBS_EN != 0u));
        s_mag_gate = gate->ekf_mag_yaw;      /* ÉÏ±¨£ºÃÅµ½µ×¿ªÃ»¿ª */
    }
    /* ¡ï ÎŞ GPS Ê± speed ÄÇÒ»Â·±» flags ÅÔÂ·µô£¬ÃÅÍË»¯³É´¿ is_static ¡ª¡ª ¶øµÈĞ§Ô­ÀíÏÂ
     *   ÔÈËÙÆ½¶¯¶ÔÍÓÂİÓë¼Ó¼Æ¶¼²»¿É¼û£¨Êµ²â×ß¶¯Ê± is_static ¿É 100% ³ÉÁ¢£©¡£
     *   ×·¼Ó**ÍâÉú**µÄ½»Á÷ÄÜÁ¿ÅĞ¾İ e_ac£¨ÈıÖá»¬´°·½²îÖ®ºÍ£¬¶ÔÖ±Á÷ÁãÆ«²»¿É¼û£©£º
     *   Êµ²â¾²Ö¹ 0.048~0.057¡¢ÔË¶¯ 0.37~84£¬ÃÅÏŞ 0.20¡£ËüÖ»ÄÜÈÃÃÅ¸ü±£ÊØ¡£ */
    /* | |a_ÀëÏßĞ£Õı| - 1 |£º**ÍâÉú**£¨Ô­Ê¼ LSB + ÀëÏß±ê¶¨³£Á¿£©£¬ÇÒÓë×ËÌ¬ÎŞ¹Ø ¡ª¡ª
     * ¾²Ö¹Ê±±ÈÁ¦Ä£³¤ºãÎª 1 g¡£Ô­À´ÓÃ a_lin£¬ÄÇÊÇ¾ÉÁ´Ç£Òı»·µÄÔÚÏß²Ğ²î£¬¶øÄÇ¸ö»·×Ô¼º
     * µÄÅĞ¾İ¾ÍÊÇ |a_lin|£¬Êµ²â¿¨ÔÚ¼«ÏŞ»·Àï£¨¾²ÖÃ |a_lin| p50 0.0487 g£©£¬
     * ZUPT ÃÅÒò´ËÖ»¿ª 52.7%¡£ */
    {
        static const float b0[3] = { V5F_ACCEL_BIAS_LSB_X, V5F_ACCEL_BIAS_LSB_Y,
                                     V5F_ACCEL_BIAS_LSB_Z };
        float s2 = 0.0f;
        uint32_t k;
        for (k = 0u; k < 3u; k++) {
            float v = ((float)h->imu.accel_lsb[k] - b0[k]) / g_v5f_accel_lsb_per_g[k];
            s2 += v * v;
        }
        amag_ok = (uint8_t)(h->imu.acc_valid
                            && (fabsf(sqrtf(s2) - 1.0f) < V5F_EKF_ZUPT_AMAG_TOL));
    }
    /* ¡ï ²»ÔÙÒª is_static¡£Êµ²â£¨VER=22£©¾²Ö¹¶Î is_static Ö»ÓĞ 6~8%£¬¶ø
     *   e_ac<0.2 ÊÇ 100%¡¢||a_off|-1|<3% ÊÇ 99.9% ¡ª¡ª ËüÊÇÎ¨Ò»µÄÀ¹Â·»¢¡£
     *   ËüµÄÅĞ¾İÊÇ**ÍÓÂİÖ±Á÷µçÆ½**£¬¾çÁÒÔË¶¯ºóÔÚÏßÇ£Òı¶³½áÔÚ´íÖµÉÏ -> ¾²Ö¹Ê±
     *   DC ÈÔ³¬ãĞ¡£ºó¹ûÖÂÃü£º3.87 g ³å»÷°ÑËÙ¶È»ıµ½ 6.8 m/s£¬Ëæºó¾²Ö¹¶Î ZUPT ²»¿ª
     *   -> ËÙ¶È²»ÏÂÀ´ -> ¦¤p Æ¯ 8.95 m¡¢|p_h| µ½ 15.7 m£¨¶øÕæÖµÊÇ 10¡Á20 cm£©¡£
     *   ¶ªµôËü**²»ËğÊ§ÄÜÁ¦**£ºÖ±Á÷ÅĞ¾İ¶ÔÆ½»¬Æ½ÒÆÍ¬ÑùÏ¹£¨ÏîÄ¿Êµ²â"60 s ÔÈËÙ×ß¶¯
     *   is_static 100%"£©£¬ÕæÕı¶ÔÆ½ÒÆÓĞĞ§µÄÊÇ e_ac Óë ||a|-1|£¬Á½Ìõ¶¼ÒÑÔÚÃÅÀï¡£ */
    gate->ekf_zupt = (uint8_t)((h->stat.e_ac < V5F_EKF_ZUPT_EAC_MAX)
                    && amag_ok
                    && ((spac < V5F_EKF_ZUPT_SPEED_MAX_MPS)
                        || !(h->gps_rmc.fresh.flags & SHM_RMC_SPEED)));

    if (!s_origin_ok && gate->ekf_gps_pos && h->gps_rmc.lat_e7 != 0) {
        float lat0 = (float)h->gps_rmc.lat_e7 * 1e-7f;
        s_lat0_e7 = h->gps_rmc.lat_e7;
        s_lon0_e7 = h->gps_rmc.lon_e7;
        s_m_per_deg_lat = V5F_EKF_R_EARTH_M * DEG2RAD;
        s_m_per_deg_lon = V5F_EKF_R_EARTH_M * DEG2RAD * cosf(lat0 * DEG2RAD);
        s_origin_ok = 1u;
        s_x[IX_P + 0u] = 0.0f; s_x[IX_P + 1u] = 0.0f;
        s_x[IX_V + 0u] = 0.0f; s_x[IX_V + 1u] = 0.0f;
        s_gate_bits |= V5F_EKF_GB_ORIGIN;
    }

    return V5F_PROC_OK;
}
